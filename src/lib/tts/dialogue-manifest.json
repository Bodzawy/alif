{
"lines": {
"a2-1-d1-1": {"voice": "female-1", "text": "هَلْ نَوَالُ أُخْتُكِ كَبِيرَةٌ يَا سَلْوَى؟", "file": "a2d-samira-a2-1-samira-salwa-01.f7912c5e"},
"a2-1-d1-2": {"voice": "female-2", "text": "لَا، هِيَ لَيْسَتْ كَبِيرَةً، هِيَ طِفْلَةٌ صَغِيرَةٌ عُمْرُهَا سَبْعُ سَنَوَاتٍ.", "file": "a2d-salwa-a2-1-samira-salwa-01.dd9164b8"},
"a2-1-d1-3": {"voice": "female-1", "text": "إِمْ، وَمَا شَكْلُهَا؟", "file": "a2d-samira-a2-1-samira-salwa-02.57476b0e"},
"a2-1-d1-4": {"voice": "female-2", "text": "هِيَ قَصِيرَةٌ، سَمِينَةٌ، وَشَعْرُهَا طَوِيلٌ. وَمَا شَكْلُ صَدِيقَتِكِ رِيهَام؟", "file": "a2d-salwa-a2-1-samira-salwa-02.3fda533c"},
"a2-1-d1-5": {"voice": "female-1", "text": "صَدِيقَتِي رِيهَام رَفِيعَةٌ، قَصِيرَةٌ أَيْضًا، شَعْرُهَا طَوِيلٌ، عُمْرُهَا حَوَالَيْ عِشْرِينَ سَنَةً.", "file": "a2d-samira-a2-1-samira-salwa-03.80528bf8"},
"a2-1-d2-1": {"voice": "female-1", "text": "كَيْفَ حَالُ صَدِيقَتِكِ الْجَدِيدَةِ يَا نَوَالُ؟", "file": "a2d-safaa-a2-1-safaa-nawal-01.7c61bb78"},
"a2-1-d2-10": {"voice": "female-2", "text": "نَادِيَةُ صَغِيرَةٌ، قَصِيرَةٌ وَبَدِينَةٌ أَيْضًا.", "file": "a2d-nawal-a2-1-safaa-nawal-05.230d7ddf"},
"a2-1-d2-11": {"voice": "female-1", "text": "وَمَا شَكْلُ بَيْتِ هَنَاء؟", "file": "a2d-safaa-a2-1-safaa-nawal-06.3981a38a"},
"a2-1-d2-12": {"voice": "female-2", "text": "بَيْتُهَا بِهِ حَدِيقَةٌ صَغِيرَةٌ وَضَيِّقَةٌ، لَيْسَتْ كَبِيرَةً. الْحَدِيقَةُ بِهَا أَشْجَارُ فَاكِهَةٍ، وَفِيهَا زُهُورٌ مُلَوَّنَةٌ أَيْضًا، وَحَوْلَ الْبَيْتِ سُورٌ عَالٍ وَعَرِيضٌ.", "file": "a2d-nawal-a2-1-safaa-nawal-06.5c732f5a"},
"a2-1-d2-2": {"voice": "female-2", "text": "صَدِيقَتِي الْجَدِيدَةُ بِخَيْرٍ، اسْمُهَا هَنَاء.", "file": "a2d-nawal-a2-1-safaa-nawal-01.98b0422f"},
"a2-1-d2-3": {"voice": "female-1", "text": "هَلْ تَسْكُنُ فِي شَقَّةٍ صَغِيرَةٍ؟", "file": "a2d-safaa-a2-1-safaa-nawal-02.c0d5e4ee"},
"a2-1-d2-4": {"voice": "female-2", "text": "لَا، هِيَ لَا تَسْكُنُ فِي شَقَّةٍ صَغِيرَةٍ. هِيَ غَنِيَّةٌ وَتَسْكُنُ فِي بَيْتٍ غَالٍ كَبِيرٍ وَاسِعٍ وَلَهَا أُخْتَانِ صَغِيرَتَانِ.", "file": "a2d-nawal-a2-1-safaa-nawal-02.3390fb69"},
"a2-1-d2-5": {"voice": "female-1", "text": "وَمَا شَكْلُهَا؟ طَوِيلَةٌ؟ قَصِيرَةٌ؟", "file": "a2d-safaa-a2-1-safaa-nawal-03.46b2e8fc"},
"a2-1-d2-6": {"voice": "female-2", "text": "هَنَاء جَمِيلَةٌ، شَعْرُهَا طَوِيلٌ وَهِيَ أَيْضًا رَفِيعَةٌ وَعَيْنَاهَا سَوْدَاوَانِ.", "file": "a2d-nawal-a2-1-safaa-nawal-03.ad97d1b6"},
"a2-1-d2-7": {"voice": "female-1", "text": "وَهَلْ هِيَ نَشِيطَةٌ؟", "file": "a2d-safaa-a2-1-safaa-nawal-04.41a17889"},
"a2-1-d2-8": {"voice": "female-2", "text": "نَعَمْ، هِيَ نَشِيطَةٌ جِدًّا، هِيَ تَجْرِي كِيلُومِتْرَيْنِ كُلَّ يَوْمٍ، وَلَكِنَّ نَادِيَةَ أُخْتَ هَنَاء كَسْلَانَةٌ.", "file": "a2d-nawal-a2-1-safaa-nawal-04.640e21b4"},
"a2-1-d2-9": {"voice": "female-1", "text": "وَمَا شَكْلُ نَادِيَةَ أُخْتِ هَنَاء؟", "file": "a2d-safaa-a2-1-safaa-nawal-05.40f27713"},
"e-m-bi-khayr": {"voice": "male-2", "text": "بِخَيْرٍ، الْحَمْدُ لِلَّهِ.", "file": "d2-m2-002.8055ed6b"},
"e-m-ismi-khalid": {"voice": "male-2", "text": "اسْمِي خَالِد، وَأَنْتَ؟", "file": "d2-m2-003.f43cda68"},
"e-m-masa-an-nur": {"voice": "male-2", "text": "مَسَاءُ النُّورِ.", "file": "d2-m2-001.078de1ca"},
"e-w-bi-khayr": {"voice": "female-2", "text": "بِخَيْرٍ، الْحَمْدُ لِلَّهِ.", "file": "d2-f2-002.020b557f"},
"e-w-ismi-dina": {"voice": "female-2", "text": "اسْمِي دِينَا، وَأَنْتِ؟", "file": "d2-f2-003.3d308125"},
"e-w-ismi-nazik": {"voice": "female-1", "text": "اسْمِي نَازِك.", "file": "d2-f1-004.f8bcc239"},
"e-w-kayfa-haluki": {"voice": "female-1", "text": "كَيْفَ حَالُكِ؟", "file": "d2-f1-002.dae06f7d"},
"e-w-ma-smuki": {"voice": "female-1", "text": "مَا اسْمُكِ؟", "file": "d2-f1-003.ff148a92"},
"e-w-masa-al-khayr": {"voice": "female-1", "text": "مَسَاءُ الْخَيْرِ.", "file": "d2-f1-001.0e921401"},
"e-w-masa-an-nur": {"voice": "female-2", "text": "مَسَاءُ النُّورِ.", "file": "d2-f2-001.aeec301c"},
"m-ana-ali": {"voice": "male-2", "text": "أَنَا عَلِيٌّ، وَأَنْتَ؟", "file": "d-m2-03.50e0ec26"},
"m-bi-khayr": {"voice": "male-2", "text": "بِخَيْرٍ، الْحَمْدُ لِلَّهِ.", "file": "d-m2-02.a1299875"},
"m-kayfa-haluka": {"voice": "male-1", "text": "كَيْفَ حَالُكَ؟", "file": "d-m1-02.f681bbd7"},
"m-ma-smuka": {"voice": "male-1", "text": "مَا اسْمُكَ؟", "file": "d-m1-03.832bb3bd"},
"m-sabah-al-khayr": {"voice": "male-1", "text": "صَبَاحُ الْخَيْرِ.", "file": "d-m1-01.4fb9351d"},
"m-sabah-an-nur": {"voice": "male-2", "text": "صَبَاحُ النُّورِ.", "file": "d-m2-01.bb1a89ae"},
"m-wa-ana-ahmad": {"voice": "male-1", "text": "وَأَنَا أَحْمَدُ.", "file": "d-m1-04.a59abe80"},
"man-a-a1": {"voice": "male-2", "text": "أَنَا نَاجِي.", "file": "d2-m2-006.8886d1a4"},
"man-a-a2": {"voice": "female-1", "text": "أَنَا نِرْمِين.", "file": "d2-f1-006.73e325bd"},
"man-a-a3": {"voice": "male-2", "text": "نَحْنُ نَسِيم وَنُصْحِي.", "file": "d2-m2-007.8660a7d6"},
"man-a-a4": {"voice": "female-2", "text": "نَحْنُ نِيفِين وَشِيرِين.", "file": "d2-f2-006.5e8b005e"},
"man-a-a5": {"voice": "male-2", "text": "نَحْنُ نَادِي وَحُسْنِي وَنَاصِر.", "file": "d2-m2-008.be35bfd6"},
"man-a-a6": {"voice": "female-1", "text": "نَحْنُ نِسْمَة وَنُورَا وَنِسْرِين.", "file": "d2-f1-007.0a6df8cb"},
"man-b-a1": {"voice": "male-2", "text": "أَنَا نَاجِي.", "file": "d2-m2-006.8886d1a4"},
"man-b-a2": {"voice": "female-1", "text": "أَنَا نِرْمِين.", "file": "d2-f1-006.73e325bd"},
"man-b-a3": {"voice": "male-2", "text": "نَحْنُ نَسِيم وَنُصْحِي.", "file": "d2-m2-007.8660a7d6"},
"man-b-a4": {"voice": "female-2", "text": "نَحْنُ نِيفِين وَشِيرِين.", "file": "d2-f2-006.5e8b005e"},
"man-b-a5": {"voice": "male-2", "text": "نَحْنُ نَادِي وَحُسْنِي وَنَاصِر.", "file": "d2-m2-008.be35bfd6"},
"man-b-a6": {"voice": "female-1", "text": "نَحْنُ نِسْمَة وَنُورَا وَنِسْرِين.", "file": "d2-f1-007.0a6df8cb"},
"t-ana-majid": {"voice": "male-1", "text": "أَنَا مَاجِدٌ، وَأَنْتِ؟", "file": "d-m1-07.54b95483"},
"t-bi-khayr-f": {"voice": "female-2", "text": "بِخَيْرٍ، الْحَمْدُ لِلَّهِ.", "file": "d-f2-02.2c532dcd"},
"t-bi-khayr-m": {"voice": "male-1", "text": "بِخَيْرٍ، الْحَمْدُ لِلَّهِ.", "file": "d-m1-06.f20e635c"},
"t-kayfa-haluka": {"voice": "female-2", "text": "كَيْفَ حَالُكَ؟", "file": "d-f2-04.00ced44e"},
"t-kayfa-haluki": {"voice": "male-1", "text": "كَيْفَ حَالُكِ؟", "file": "d-m1-05.11de956f"},
"t-ma-smuka": {"voice": "female-2", "text": "مَا اسْمُكَ؟", "file": "d-f2-05.4960e736"},
"t-sabah-al-khayr": {"voice": "male-1", "text": "صَبَاحُ الْخَيْرِ.", "file": "d-m1-01.4fb9351d"},
"t-sabah-an-nur": {"voice": "female-2", "text": "صَبَاحُ النُّورِ.", "file": "d-f2-01.65328b28"},
"t-wa-ana-fatima": {"voice": "female-2", "text": "وَأَنَا فَاطِمَةُ.", "file": "d-f2-06.a46d280b"},
"u10-e-1": {"voice": "female-1", "text": "هَلْ وَالِدَةُ عِصَام تَعْمَلُ؟", "file": "d2-f1-049.2381ce17"},
"u10-e-3": {"voice": "female-1", "text": "هَلْ جَدُّ عِصَام يَعْمَلُ؟", "file": "d2-f1-050.5f978487"},
"u10-h-1": {"voice": "female-2", "text": "مَنْ يَقِفُ خَلْفَكِ فِي الصُّورَةِ يَا هَنَاء؟", "file": "d2-f2-024.df6c5aee"},
"u10-h-2": {"voice": "female-1", "text": "هَذَا زَوْجِي عِمَاد.", "file": "d2-f1-051.73b2a81c"},
"u10-h-3": {"voice": "female-2", "text": "أَمْ … هُوَ رَجُلٌ طَوِيلٌ. وَمَا عَمَلُهُ؟", "file": "d2-f2-025.90596796"},
"u10-h-4": {"voice": "female-1", "text": "هُوَ مُحَاسِبٌ فِي الْبَنْكِ الْعَرَبِيِّ.", "file": "d2-f1-052.d97dca17"},
"u10-h-5": {"voice": "female-2", "text": "وَهَلْ هَذَا أَخُوكِ؟", "file": "d2-f2-026.b6c2a84f"},
"u10-h-6": {"voice": "female-1", "text": "لَا، هَذَا لَيْسَ أَخِي، هَذَا ابْنِي سَمِير.", "file": "d2-f1-053.7d41dafd"},
"u10-h-7": {"voice": "female-2", "text": "وَهَلْ يَعْمَلُ ابْنُكِ؟", "file": "d2-f2-027.c738c1b1"},
"u10-h-8": {"voice": "female-1", "text": "لَا، هُوَ لَا يَعْمَلُ. هُوَ طَالِبٌ، يَدْرُسُ فِي الْجَامِعَةِ.", "file": "d2-f1-054.a8426cde"},
"u10-s-1": {"voice": "female-1", "text": "إِلَى أَيْنَ تُسَافِرُ فِي رِحْلَتِكَ يَا عِمَاد؟", "file": "d2-f1-055.0a5705fe"},
"u10-s-3": {"voice": "female-1", "text": "الْيَابَانُ! أَيْنَ فِي الْيَابَانِ؟", "file": "d2-f1-056.d406b3c0"},
"u10-s-5": {"voice": "female-1", "text": "طُوكْيُو! الْيَابَانُ! مَتَى تُسَافِرُ؟", "file": "d2-f1-057.6ba99658"},
"u10-s-7": {"voice": "female-1", "text": "وَكَيْفَ حَالَةُ الطَّقْسِ هُنَاكَ فِي الشِّتَاءِ؟ وَمَاذَا تَلْبَسُ؟", "file": "d2-f1-058.230dc940"},
"u2-1-wajdi": {"voice": "male-2", "text": "نَعَمْ. أَنَا وَجْدِي.", "file": "d2-m2-005.aa68ecea"},
"u2-1-walid": {"voice": "male-2", "text": "لَا. أَنَا وَلِيد.", "file": "d2-m2-004.621062eb"},
"u2-2-ester": {"voice": "female-2", "text": "لَا. أَنَا إِسْتَر.", "file": "d2-f2-004.f9d2081a"},
"u2-2-suzi": {"voice": "female-2", "text": "نَعَمْ. أَنَا سُوزِي.", "file": "d2-f2-005.3a87378d"},
"u2-2-teriz-1": {"voice": "female-1", "text": "هَلْ أَنْتِ سُوزِي؟", "file": "d2-f1-005.54438cf8"},
"u2-2-teriz-2": {"voice": "female-1", "text": "هَلْ أَنْتِ سُوزِي؟", "file": "d2-f1-005.54438cf8"},
"u3-a-q1": {"voice": "female-1", "text": "مَنْ هُوَ؟ مَا اسْمُهُ؟", "file": "d2-f1-008.b748e3ae"},
"u3-a-q2": {"voice": "female-1", "text": "مَنْ هُمَا؟ مَا اسْمَاهُمَا؟", "file": "d2-f1-009.781a16f9"},
"u3-a-q3": {"voice": "female-1", "text": "مَنْ هُمْ؟ مَا أَسْمَاؤُهُمْ؟", "file": "d2-f1-010.0e9ce108"},
"u3-ah-2": {"voice": "male-2", "text": "صَبَاحُ النُّور. أَنَا اسْمِي عَبْدُ اللهِ.", "file": "d2-m2-009.45ff7ce7"},
"u3-ah-4": {"voice": "male-2", "text": "أَنَا مِنَ السُّعُودِيَّةِ.", "file": "d2-m2-010.da6d3d7c"},
"u3-ah-6": {"voice": "male-2", "text": "أَهْلًا بِكَ.", "file": "d2-m2-011.ec5aa446"},
"u3-b-q1": {"voice": "female-1", "text": "مَنْ هِيَ؟ مَا اسْمُهَا؟", "file": "d2-f1-011.65883ffa"},
"u3-b-q2": {"voice": "female-1", "text": "مَنْ هُمَا؟ مَا اسْمَاهُمَا؟", "file": "d2-f1-009.781a16f9"},
"u3-b-q3": {"voice": "female-1", "text": "مَنْ هُنَّ؟ مَا أَسْمَاؤُهُنَّ؟", "file": "d2-f1-012.3afa6847"},
"u3-fh-1": {"voice": "female-1", "text": "مَسَاءُ الْخَيْر. أَنَا اسْمِي فَرِيدَة. وَأَنْتِ مَا اسْمُكِ؟", "file": "d2-f1-013.ff5d1cd6"},
"u3-fh-2": {"voice": "female-2", "text": "مَسَاءُ النُّور. أَنَا اسْمِي هَنَا.", "file": "d2-f2-007.3fe94ee3"},
"u3-fh-3": {"voice": "female-1", "text": "مِنْ أَيْنَ أَنْتِ يَا هَنَا؟", "file": "d2-f1-014.08605764"},
"u3-fh-4": {"voice": "female-2", "text": "أَنَا مِنَ الْمَغْرِبِ.", "file": "d2-f2-008.43760d5f"},
"u3-fh-5": {"voice": "female-1", "text": "وَأَنَا مِنَ الْجَزَائِرِ. أَهْلًا وَسَهْلًا.", "file": "d2-f1-015.a954c764"},
"u3-fh-6": {"voice": "female-2", "text": "أَهْلًا بِكِ.", "file": "d2-f2-009.b72af060"},
"u4-my-2": {"voice": "male-2", "text": "لَا مُشْكِلَةَ. هَلْ أَنْتَ مِنْ مِصْرَ؟", "file": "d2-m2-012.96bd437b"},
"u4-my-4": {"voice": "male-2", "text": "أَنَا مِنَ الْيَابَانِ. أَنَا يَابَانِيٌّ.", "file": "d2-m2-013.3fd5e209"},
"u4-my-6": {"voice": "male-2", "text": "شُكْرًا. مَعَ السَّلَامَةِ.", "file": "d2-m2-014.3d0e8ff4"},
"u4-pl-1": {"voice": "female-1", "text": "هَلْ أَنْتِ أَمْرِيكِيَّةٌ؟", "file": "d2-f1-016.7c7946eb"},
"u4-pl-2": {"voice": "female-2", "text": "لَا، أَنَا كَنَدِيَّةٌ. وَأَنْتِ؟", "file": "d2-f2-010.d358c310"},
"u4-pl-3": {"voice": "female-1", "text": "أَنَا لُبْنَانِيَّةٌ. هَلْ أَنْتِ فِي إِجَازَةٍ؟", "file": "d2-f1-017.ca0e9054"},
"u4-pl-4": {"voice": "female-2", "text": "نَعَمْ، أَنَا فِي إِجَازَةٍ.", "file": "d2-f2-011.f9d62314"},
"u4-sh-2": {"voice": "male-2", "text": "هَذِهِ الدَّرَّاجَةُ مِنْ أَلْمَانْيَا، هَذِهِ دَرَّاجَةٌ أَلْمَانِيَّةٌ.", "file": "d2-m2-015.04625b75"},
"u4-sp-2": {"voice": "female-1", "text": "هَذِهِ دَبَّاسَةٌ.", "file": "d2-f1-018.f1f0fda0"},
"u4-sp-4": {"voice": "female-1", "text": "دَال – بَاء – أَلِف – سِين – تَاء مَرْبُوطَة.", "file": "d2-f1-019.c5a9417a"},
"u4-sp-6": {"voice": "female-1", "text": "عَفْوًا.", "file": "d2-f1-020.a23d10d9"},
"u5-a-2": {"voice": "male-2", "text": "لَا، هَذِهِ لَيْسَتْ نَظَّارَةً. هَذِهِ حَقِيبَةٌ.", "file": "d2-m2-016.4c485042"},
"u5-a-4": {"voice": "female-1", "text": "لَا، هَذَا لَيْسَ كِتَابًا. هَذَا قَلَمٌ.", "file": "d2-f1-025.c74c5b62"},
"u5-b-2": {"voice": "male-2", "text": "لَا، هَذِهِ لَيْسَتْ حَقِيبَتِي. هَذِهِ حَقِيبَةُ أَحْمَد. هَذِهِ حَقِيبَتُهُ.", "file": "d2-m2-017.dcccb85e"},
"u5-b-4": {"voice": "female-1", "text": "لَا، هَذَا لَيْسَ قَلَمِي. هَذَا قَلَمُ زَيْنَب. هَذَا قَلَمُهَا.", "file": "d2-f1-026.7e34a1a2"},
"u5-ks-2": {"voice": "female-1", "text": "هَذِهِ مِحْفَظَةُ زَيْد. هَذِهِ مِحْفَظَتُهُ.", "file": "d2-f1-021.80a7c222"},
"u5-ks-4": {"voice": "female-1", "text": "هَذِهِ أَوْرَاقُ طَلَال وَعَلِيّ.", "file": "d2-f1-022.4a738d05"},
"u5-ks-6": {"voice": "female-1", "text": "هَذِهِ نَظَّارَتِي.", "file": "d2-f1-023.f7cd72c2"},
"u5-ks-8": {"voice": "female-1", "text": "هَذِهِ كَامِيرَا سَمَر.", "file": "d2-f1-024.febc0d75"},
"u5-na-1": {"voice": "male-2", "text": "يَا عَالِيَةُ! هَلْ هَذِهِ شَمْسِيَّتُكُمْ؟", "file": "d2-m2-018.3b1197b4"},
"u5-na-2": {"voice": "female-2", "text": "نَعَمْ، هَذِهِ شَمْسِيَّتُنَا.", "file": "d2-f2-012.17cf37ac"},
"u5-na-3": {"voice": "male-2", "text": "وَهَلْ هَذِهِ لُعْبَتُكِ؟", "file": "d2-m2-019.bdef1743"},
"u5-na-4": {"voice": "female-2", "text": "لَا، هَذِهِ لَيْسَتْ لُعْبَتِي. هَذِهِ لُعْبَةُ فَاطِمَة. هَذِهِ لُعْبَتُهَا.", "file": "d2-f2-013.2f62dd88"},
"u6-c1-1": {"voice": "female-2", "text": "أَلُو، مَرْحَبًا.", "file": "d2-f2-014.b9eb9a65"},
"u6-c1-10": {"voice": "female-1", "text": "عَفْوًا، أَيَّ خِدْمَةٍ!", "file": "d2-f1-033.8cc3eadc"},
"u6-c1-2": {"voice": "female-1", "text": "مَرْحَبًا. أَهْلًا وَسَهْلًا يَا أَفَنْدِم.", "file": "d2-f1-029.611c8f04"},
"u6-c1-3": {"voice": "female-2", "text": "هَلْ هَذِهِ عِيَادَةُ دُكْتُور أَدْهَم النَّدِيم؟", "file": "d2-f2-015.3939729b"},
"u6-c1-4": {"voice": "female-1", "text": "نَعَمْ. هَذَا صَحِيحٌ.", "file": "d2-f1-030.43253ebc"},
"u6-c1-5": {"voice": "female-2", "text": "مَا الْعُنْوَانُ وَرَقْمُ الشَّقَّةِ لَوْ سَمَحْتِ؟", "file": "d2-f2-016.46ee915f"},
"u6-c1-6": {"voice": "female-1", "text": "خَمْسَةَ عَشَرَ شَارِعُ الْبَرَازِيلِ، الدَّوْرُ الرَّابِعُ، شَقَّةُ تِسْعَةَ عَشَرَ.", "file": "d2-f1-031.0d6a0073"},
"u6-c1-7": {"voice": "female-2", "text": "وَمَا رَقْمُ تِلِيفُونِهِ الْمَحْمُولِ؟", "file": "d2-f2-017.b82525bd"},
"u6-c1-8": {"voice": "female-1", "text": "رَقْمُ تِلِيفُونِهِ صِفْر وَاحِد اثْنَان أَرْبَعَة خَمْسَة سِتَّة ثَمَانِيَة تِسْعَة وَاحِد وَاحِد.", "file": "d2-f1-032.1b2720a4"},
"u6-c1-9": {"voice": "female-2", "text": "شُكْرًا.", "file": "d2-f2-018.6761cc77"},
"u6-c2-2": {"voice": "female-2", "text": "وَعَلَيْكُمُ السَّلَامُ. أَيَّ خِدْمَةٍ؟", "file": "d2-f2-019.93a0316e"},
"u6-c2-4": {"voice": "female-2", "text": "رَقْمُ تِلِيفُونِهَا اثْنَان ثَلَاثَة أَرْبَعَة ثَمَانِيَة سَبْعَة سِتَّة خَمْسَة اثْنَان.", "file": "d2-f2-020.bb8c1928"},
"u6-c2-6": {"voice": "female-2", "text": "رَقْمُ الْفَاكْسِ ثَلَاثَة اثْنَان خَمْسَة سِتَّة أَرْبَعَة أَرْبَعَة صِفْر وَاحِد.", "file": "d2-f2-021.681cf095"},
"u6-c2-8": {"voice": "female-2", "text": "عَفْوًا، مَعَ السَّلَامَةِ.", "file": "d2-f2-022.56e3e802"},
"u6-pn-2": {"voice": "female-1", "text": "نَعَمْ.", "file": "d2-f1-027.ad366820"},
"u6-pn-4": {"voice": "female-1", "text": "رَقْمُ تِلِيفُونِهِ الْمَحْمُولِ صِفْر وَاحِد ثَمَانِيَة سِتَّة تِسْعَة ثَلَاثَة خَمْسَة اثْنَان وَاحِد أَرْبَعَة.", "file": "d2-f1-028.d46e2920"},
"u6-rm-2": {"voice": "female-1", "text": "مَوْعِدُ قِيَامِ الْقِطَارِ السَّاعَةُ السَّابِعَةُ مَسَاءً.", "file": "d2-f1-034.802bf123"},
"u7-b-1": {"voice": "female-1", "text": "أَنَا فِي الْخِدْمَةِ.", "file": "d2-f1-035.590a6784"},
"u7-b-2": {"voice": "male-2", "text": "مَا سِعْرُ هَذَا الْقَمِيصِ لَوْ سَمَحْتِ؟", "file": "d2-m2-023.63172ceb"},
"u7-b-3": {"voice": "female-1", "text": "سِعْرُ هَذَا الْقَمِيصِ مِائَةٌ وَعِشْرُونَ جُنَيْهًا.", "file": "d2-f1-036.3a7c0de2"},
"u7-b-4": {"voice": "male-2", "text": "وَمَا سِعْرُ هَذَا الْجَوْرَبِ؟", "file": "d2-m2-024.2c776353"},
"u7-b-5": {"voice": "female-1", "text": "سِعْرُ الْجَوْرَبِ خَمْسَةَ عَشَرَ جُنَيْهًا وَسِتُّونَ قِرْشًا.", "file": "d2-f1-037.f7ab8cdc"},
"u7-b-6": {"voice": "male-2", "text": "أُرِيدُ ثَلَاثَةَ جَوَارِبَ مِنْ فَضْلِكِ.", "file": "d2-m2-025.42b9b68e"},
"u7-s-1": {"voice": "male-2", "text": "لَوْ سَمَحْتَ، مَا سِعْرُ هَذِهِ الْبَدْلَةِ؟", "file": "d2-m2-020.53a36f5f"},
"u7-s-3": {"voice": "male-2", "text": "وَمَا سِعْرُ هَذَا الْقَلَمِ؟", "file": "d2-m2-021.24ef3ff6"},
"u7-s-5": {"voice": "male-2", "text": "وَمَا سِعْرُ هَذِهِ اللُّعْبَةِ؟", "file": "d2-m2-022.0fe54f67"},
"u7-ss-2": {"voice": "male-2", "text": "حُجْرَةُ النَّوْمِ لَوْنُهَا أَخْضَرُ. حُجْرَةُ نَوْمِي خَضْرَاءُ.", "file": "d2-m2-026.900c0886"},
"u7-ss-4": {"voice": "male-2", "text": "لَوْنُ سَرِيرِي أَبْيَضُ.", "file": "d2-m2-027.6063a191"},
"u7-ss-6": {"voice": "male-2", "text": "لَا، مَكْتَبِي لَيْسَ لَوْنُهُ أَخْضَرَ، مَكْتَبِي لَوْنُهُ أَبْيَضُ.", "file": "d2-m2-028.6f5f387a"},
"u8-a-1": {"voice": "female-2", "text": "لَوْ سَمَحْتَ، أَيْنَ السُّوقُ الْحُرَّةُ؟", "file": "d2-f2-023.346ca88b"},
"u8-p-1": {"voice": "male-2", "text": "مَنْ بَيْنَ سَلْوَى وَعَبْلَة؟", "file": "d2-m2-029.063771c5"},
"u8-p-3": {"voice": "male-2", "text": "وَمَنْ أَمَامَ سَمِيح؟", "file": "d2-m2-030.d718b294"},
"u8-p-5": {"voice": "male-2", "text": "وَمَنْ فَوْقَ الْكُرْسِيِّ؟", "file": "d2-m2-031.22da2e55"},
"u8-p-7": {"voice": "male-2", "text": "وَمَنْ خَلْفَ زِيَاد؟", "file": "d2-m2-032.ba0252fc"},
"u8-st-10": {"voice": "female-1", "text": "وَأَيْنَ الْكَافِتِيرْيَا؟", "file": "d2-f1-042.ae063dc0"},
"u8-st-12": {"voice": "female-1", "text": "لَا، شُكْرًا. أَنَا أُرِيدُ حَمَّامَ السَّيِّدَاتِ.", "file": "d2-f1-043.90099321"},
"u8-st-2": {"voice": "female-1", "text": "لَوْ سَمَحْتَ، أَيْنَ قِسْمُ الْكَامِيرَاتِ؟", "file": "d2-f1-038.b997a961"},
"u8-st-4": {"voice": "female-1", "text": "وَأَيْنَ قِسْمُ الثَّلَّاجَاتِ؟ أَمَامَ الْمِصْعَدِ؟", "file": "d2-f1-039.b06402f7"},
"u8-st-6": {"voice": "female-1", "text": "وَأَيْنَ قِسْمُ التِّلِفِزْيُونَاتِ؟", "file": "d2-f1-040.6252d71e"},
"u8-st-8": {"voice": "female-1", "text": "وَأَيْنَ قِسْمُ الْغَسَّالَاتِ؟", "file": "d2-f1-041.13242018"},
"u8-t-1": {"voice": "female-1", "text": "لَوْ سَمَحْتَ، أَيْنَ مَكْتَبُ الْبَرِيدِ؟", "file": "d2-f1-044.6411ce0c"},
"u8-t-3": {"voice": "female-1", "text": "يَمِينًا فِي شَارِعِ كِلْيُوبَاتْرَا. حَسَنًا.", "file": "d2-f1-045.8c0b40a5"},
"u8-t-5": {"voice": "female-1", "text": "الصَّيْدَلِيَّةُ عَلَى الْيَمِينِ. عَلَى النَّاصِيَةِ. شُكْرًا.", "file": "d2-f1-046.bb178d44"},
"u9-ef-2": {"voice": "male-2", "text": "وَعَلَيْكُمُ السَّلَامُ. لَا، أَنَا لَا أَذْهَبُ إِلَى النَّادِي يَوْمَ السَّبْتِ.", "file": "d2-m2-036.f61cc065"},
"u9-ef-4": {"voice": "male-2", "text": "فِي الْحَقِيقَةِ. أَنَا أَسْتَيْقِظُ مُتَأَخِّرًا. أَجْلِسُ فِي سَرِيرِي أَقْرَأُ، وَأَسْمَعُ مُوسِيقَى، وَأَنْتَ؟", "file": "d2-m2-037.0b32294e"},
"u9-hh-1": {"voice": "male-2", "text": "مَاذَا تَفْعَلِينَ فِي الْإِجَازَةِ يَا هَالَة؟", "file": "d2-m2-034.1d2ca1db"},
"u9-hh-2": {"voice": "female-1", "text": "يَوْمَ الْجُمْعَةِ أَنَا أُنَظِّفُ الْبَيْتَ، أَقْرَأُ كِتَابًا، أَدْرُسُ قَلِيلًا ثُمَّ أَلْعَبُ التِّنِسَ بَعْدَ الظُّهْرِ. يَوْمَ السَّبْتِ أَنَا أَزُورُ أَبِي وَأُمِّي.", "file": "d2-f1-047.45b0d1cc"},
"u9-hh-3": {"voice": "female-1", "text": "وَأَنْتَ مَاذَا تَفْعَلُ فِي الْإِجَازَةِ الْأُسْبُوعِيَّةِ يَا حُسَيْن؟", "file": "d2-f1-048.7147caa3"},
"u9-hh-4": {"voice": "male-2", "text": "يَوْمَ الْجُمْعَةِ أَنَا لَا أُنَظِّفُ الْبَيْتَ وَلَا أَدْرُسُ، وَلَكِنْ أَذْهَبُ إِلَى السِّينِمَا وَأَسْمَعُ مُوسِيقَى. وَيَوْمَ السَّبْتِ أَتَعَشَّى فِي مَطْعَمٍ جَمِيلٍ ثُمَّ أُشَاهِدُ التِّلِيفِزْيُونَ فِي الْبَيْتِ.", "file": "d2-m2-035.16717318"},
"u9-sb-1": {"voice": "male-2", "text": "أَلُو، بَاسِم هَلْ تَذْهَبُ مَعِي إِلَى الْكَافِتِيرْيَا الْآنَ؟", "file": "d2-m2-033.078c52e5"},
"w-ana-fatima": {"voice": "female-2", "text": "أَنَا فَاطِمَةُ، وَأَنْتِ؟", "file": "d-f2-03.1486c9f5"},
"w-bi-khayr": {"voice": "female-2", "text": "بِخَيْرٍ، الْحَمْدُ لِلَّهِ.", "file": "d-f2-02.2c532dcd"},
"w-kayfa-haluki": {"voice": "female-1", "text": "كَيْفَ حَالُكِ؟", "file": "d-f1-02.5c3507eb"},
"w-ma-smuki": {"voice": "female-1", "text": "مَا اسْمُكِ؟", "file": "d-f1-03.492d7ea9"},
"w-sabah-al-khayr": {"voice": "female-1", "text": "صَبَاحُ الْخَيْرِ.", "file": "d-f1-01.3453e57e"},
"w-sabah-an-nur": {"voice": "female-2", "text": "صَبَاحُ النُّورِ.", "file": "d-f2-01.65328b28"},
"w-wa-ana-nabila": {"voice": "female-1", "text": "وَأَنَا نَبِيلَةُ.", "file": "d-f1-04.3cae299f"}
}
}
