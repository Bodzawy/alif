  "description": "Alif – Arabisch lernen für Deutschsprachige: Buchstaben, Wortschatz und KI-gestütztes Aussprachetraining.",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
