 "items": [
  {
   "id": "s0930",
   "kind": "sentence",
   "text": "هَذِهِ بَدْلَةٌ حَمْرَاءُ."
  },
  {
   "id": "s0931",
   "kind": "sentence",
   "text": "هَذِهِ سَيَّارَةٌ زَرْقَاءُ."
  },
  {
   "id": "s0932",
   "kind": "sentence",
   "text": "هَذِهِ حَقِيبَةٌ فِضِّيَّةٌ."
  },
  {
   "id": "s0933",
   "kind": "sentence",
   "text": "هَذِهِ حَقِيبَةٌ ذَهَبِيَّةٌ."
  },
  {
   "id": "s0934",
   "kind": "sentence",
   "text": "هَذِهِ حَقِيبَةٌ بُرْتُقَالِيَّةٌ."
  },
  {
   "id": "s0935",
   "kind": "sentence",
   "text": "حُجْرَةُ النَّوْمِ"
  },
  {
   "id": "s0936",
   "kind": "sentence",
   "text": "شُبَّاك (نَافِذَة)"
  },
  {
   "id": "s0937",
   "kind": "sentence",
   "text": "حُجْرَةُ الْمَعِيشَةِ"
  },
  {
   "id": "s0938",
   "kind": "sentence",
   "text": "كَنَبَة (أَرِيكَة)"
  },
  {
   "id": "s0939",
   "kind": "sentence",
   "text": "مَقْعَد (كُرْسِيّ)"
  },
  {
   "id": "s0940",
   "kind": "sentence",
   "text": "مَكْتَبَة وَتِلِفِزْيُون"
  },
  {
   "id": "s0941",
   "kind": "sentence",
   "text": "حُجْرَةُ الِاسْتِقْبَالِ (الصَّالُون)"
  },
  {
   "id": "s0942",
   "kind": "sentence",
   "text": "بُوتَاجَاز (مَوْقِد)"
  },
  {
   "id": "s0943",
   "kind": "sentence",
   "text": "حُجْرَةُ الطَّعَامِ"
  },
  {
   "id": "s0944",
   "kind": "sentence",
   "text": "دُولَابُ السُّفْرَةِ"
  },
  {
   "id": "s0945",
   "kind": "sentence",
   "text": "شَقَّتِي جَمِيلَةٌ وَوَاسِعَةٌ."
  },
  {
   "id": "s0946",
   "kind": "sentence",
   "text": "شَقَّتِي بِهَا ٣ حُجُرَاتٍ – حُجْرَةُ النَّوْمِ وَحُجْرَةُ السُّفْرَةِ وَحُجْرَةُ مَعِيشَةٍ وَاسِعَةٌ."
  },
  {
   "id": "s0947",
   "kind": "sentence",
   "text": "الْحَمَّامُ لَوْنُهُ أَخْضَرُ، وَلَكِنِ الْمَطْبَخُ لَوْنُهُ أَبْيَضُ."
  },
  {
   "id": "s0948",
   "kind": "sentence",
   "text": "حُجْرَةُ نَوْمِي لَوْنُهَا أَبْيَضُ أَيْضًا، وَلَكِنْ حُجْرَةُ السُّفْرَةِ لَوْنُهَا أَخْضَرُ."
  },
  {
   "id": "s0949",
   "kind": "sentence",
   "text": "وَحُجْرَةُ الْمَعِيشَةِ لَوْنُهَا أَحْمَرُ جَمِيلٌ."
  },
  {
   "id": "s0950",
   "kind": "sentence",
   "text": "مَا لَوْنُ هَذَا الْقَمِيصِ؟"
  },
  {
   "id": "s0952",
   "kind": "sentence",
   "text": "مَا لَوْنُ هَذِهِ الْحَقِيبَةِ؟"
  },
  {
   "id": "s0954",
   "kind": "sentence",
   "text": "هَلْ هَذَا قَمِيصٌ أَحْمَرُ؟"
  },
  {
   "id": "s0956",
   "kind": "sentence",
   "text": "هَلْ هَذِهِ حَقِيبَةٌ سَوْدَاءُ؟"
  },
  {
   "id": "s0958",
   "kind": "sentence",
   "text": "هَذَا قَمِيصٌ أَحْمَرُ."
  },
  {
   "id": "s0959",
   "kind": "sentence",
   "text": "هَذَا لَيْسَ قَمِيصًا أَحْمَرَ."
  },
  {
   "id": "s0960",
   "kind": "sentence",
   "text": "هَذِهِ حَقِيبَةٌ حَمْرَاءُ."
  },
  {
   "id": "s0961",
   "kind": "sentence",
   "text": "هَذِهِ لَيْسَتْ حَقِيبَةً حَمْرَاءَ."
  },
  {
   "id": "s0962",
   "kind": "sentence",
   "text": "نَعَمْ، هَذَا سَرِيرٌ أَخْضَرُ."
  },
  {
   "id": "s0963",
   "kind": "sentence",
   "text": "لَا، هَذَا لَيْسَ سَرِيرًا أَخْضَرَ."
  },
  {
   "id": "s0964",
   "kind": "sentence",
   "text": "هَذَا قَلَمٌ لَوْنُهُ أَسْوَدُ."
  },
  {
   "id": "s0965",
   "kind": "sentence",
   "text": "هَذَا مَطْبَخٌ أَحْمَرُ."
  },
  {
   "id": "s0966",
   "kind": "sentence",
   "text": "هَذَا حَمَّامٌ أَبْيَضُ."
  },
  {
   "id": "s0967",
   "kind": "sentence",
   "text": "هَذَا حَوْضٌ أَزْرَقُ."
  },
  {
   "id": "s0968",
   "kind": "sentence",
   "text": "هَذِهِ حُجْرَةُ نَوْمٍ صَفْرَاءُ."
  },
  {
   "id": "s0969",
   "kind": "sentence",
   "text": "هَذِهِ حُجْرَةُ سُفْرَةٍ حَمْرَاءُ."
  },
  {
   "id": "s0970",
   "kind": "sentence",
   "text": "هَذِهِ حُجْرَةُ مَعِيشَةٍ سَوْدَاءُ."
  },
  {
   "id": "s0971",
   "kind": "sentence",
   "text": "هَذَا مِصْبَاحٌ أَصْفَرُ."
  },
  {
   "id": "s0972",
   "kind": "sentence",
   "text": "هَلْ هَذِهِ أَرِيكَةٌ (كَنَبَةٌ) خَضْرَاءُ؟"
  },
  {
   "id": "s0973",
   "kind": "sentence",
   "text": "نَعَمْ، هَذِهِ أَرِيكَةٌ خَضْرَاءُ."
  },
  {
   "id": "s0974",
   "kind": "sentence",
   "text": "مَا لَوْنُ هَذَا الْحَمَّامِ؟"
