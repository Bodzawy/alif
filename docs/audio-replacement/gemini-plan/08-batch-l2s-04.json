{
 "batch": "batch-l2s-04",
 "items": [
  {
   "id": "s0154",
   "kind": "sentence",
   "text": "آسِف جِدًّا."
  },
  {
   "id": "s0155",
   "kind": "sentence",
   "text": "لَا مُشْكِلَةَ."
  },
  {
   "id": "s0156",
   "kind": "sentence",
   "text": "نَحْنُ مِنَ الصِّين."
  },
  {
   "id": "s0157",
   "kind": "sentence",
   "text": "نَحْنُ صِينِيُّون."
  },
  {
   "id": "s0158",
   "kind": "sentence",
   "text": "أَنَا مِنَ الْيَابَان."
  },
  {
   "id": "s0159",
   "kind": "sentence",
   "text": "أَنَا يَابَانِيَّة."
  },
  {
   "id": "s0160",
   "kind": "sentence",
   "text": "نَحْنُ مِنْ كَنَدَا."
  },
  {
   "id": "s0161",
   "kind": "sentence",
   "text": "نَحْنُ كَنَدِيُّون."
  },
  {
   "id": "s0162",
   "kind": "sentence",
   "text": "نَحْنُ مِنْ كُورِيَا."
  },
  {
   "id": "s0163",
   "kind": "sentence",
   "text": "نَحْنُ كُورِيَّات."
  },
  {
   "id": "s0164",
   "kind": "sentence",
   "text": "أَنَا سُعُودِيّ."
  },
  {
   "id": "s0165",
   "kind": "sentence",
   "text": "نَحْنُ مِنْ أَمْرِيكَا."
  },
  {
   "id": "s0166",
   "kind": "sentence",
   "text": "نَحْنُ أَمْرِيكِيَّات."
  },
  {
   "id": "s0167",
   "kind": "sentence",
   "text": "أَنَا مِنْ إِنْجِلْتِرَا."
  },
  {
   "id": "s0168",
   "kind": "sentence",
   "text": "أَنَا إِنْجِلِيزِيّ."
  },
  {
   "id": "s0169",
   "kind": "sentence",
   "text": "نَحْنُ مِنْ رُوسْيَا."
  },
  {
   "id": "s0170",
   "kind": "sentence",
   "text": "نَحْنُ رُوس."
  },
  {
   "id": "s0171",
   "kind": "sentence",
   "text": "أَنَا مِنْ سُوِيسْرَا."
  },
  {
   "id": "s0172",
   "kind": "sentence",
   "text": "أَنَا سُوِيسْرِيَّة."
  },
  {
   "id": "s0173",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ مِيخَالِيس؟"
  },
  {
   "id": "s0174",
   "kind": "sentence",
   "text": "هُوَ مِنَ الْيُونَان، هُوَ يُونَانِيّ."
  },
  {
   "id": "s0175",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ جُون / مَارْك / لُوسِي؟"
  },
  {
   "id": "s0176",
   "kind": "sentence",
   "text": "هُمْ مِنْ أَمْرِيكَا، هُمْ أَمْرِيكِيُّون."
  },
  {
   "id": "s0177",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ هَايُوسُون؟"
  },
  {
   "id": "s0178",
   "kind": "sentence",
   "text": "هُوَ مِنْ كُورِيَا، هُوَ كُورِيّ."
  },
  {
   "id": "s0179",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ جَاكِي وَنَاتَالِي وَلِنْدَا؟"
  },
  {
   "id": "s0180",
   "kind": "sentence",
   "text": "هُنَّ مِنْ إِنْجِلْتِرَا، هُنَّ إِنْجِلِيزِيَّات."
  },
  {
   "id": "s0181",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ سُعَاد؟"
  },
  {
   "id": "s0182",
   "kind": "sentence",
   "text": "هِيَ مِنْ سُورِيَا، هِيَ سُورِيَّة."
  },
  {
   "id": "s0184",
   "kind": "sentence",
   "text": "أَنَا عَالِيَة."
  },
  {
   "id": "s0185",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ أَنْتِ يَا عَالِيَة؟"
  },
  {
   "id": "s0186",
   "kind": "sentence",
   "text": "هَلْ أَنْتِ فِي إِجَازَةٍ أَوْ دِرَاسَةٍ؟"
  },
  {
   "id": "s0187",
   "kind": "sentence",
   "text": "أَنَا فِي إِجَازَةٍ."
  },
  {
   "id": "s0189",
   "kind": "sentence",
   "text": "هَذَا سَرِير"
  },
  {
   "id": "s0190",
   "kind": "sentence",
   "text": "هَذَا كِتَاب"
  },
  {
   "id": "s0191",
   "kind": "sentence",
   "text": "هَذَا قَلَم"
  },
  {
   "id": "s0192",
   "kind": "sentence",
   "text": "هَذَا مِصْبَاح"
  },
  {
   "id": "s0193",
   "kind": "sentence",
   "text": "هَذَا طَالِب"
  },
  {
   "id": "s0194",
   "kind": "sentence",
   "text": "هَذَا كُرْسِيّ"
  },
  {
   "id": "s0195",
   "kind": "sentence",
   "text": "هَذَا بَاب"
  },
  {
   "id": "s0196",
   "kind": "sentence",
   "text": "هَذَا مَكْتَب"
  },
  {
   "id": "s0197",
   "kind": "sentence",
   "text": "هَذِهِ مَكْتَبَة"
  },
  {
   "id": "s0198",
   "kind": "sentence",
   "text": "هَذِهِ طَاوِلَة"
  },
  {
   "id": "s0199",
   "kind": "sentence",
   "text": "هَذِهِ حَقِيبَة"
  },
  {
   "id": "s0200",
   "kind": "sentence",
   "text": "هَذِهِ سَلَّة"
  }
 ]
}