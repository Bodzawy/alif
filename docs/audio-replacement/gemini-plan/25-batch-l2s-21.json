   "text": "خَلْفَ الْبَابِ"
  },
  {
   "id": "s1040",
   "kind": "sentence",
   "text": "هَلِ الْحِذَاءُ فَوْقَ الْكُرْسِيِّ؟"
  },
  {
   "id": "s1041",
   "kind": "sentence",
   "text": "لَا، الْحِذَاءُ لَيْسَ فَوْقَ الْكُرْسِيِّ، الْحِذَاءُ تَحْتَ الْكُرْسِيِّ."
  },
  {
   "id": "s1042",
   "kind": "sentence",
   "text": "هَلِ الْكِتَابُ تَحْتَ الطَّاوِلَةِ؟"
  },
  {
   "id": "s1043",
   "kind": "sentence",
   "text": "لَا، الْكِتَابُ لَيْسَ تَحْتَ الطَّاوِلَةِ، الْكِتَابُ فَوْقَ الطَّاوِلَةِ."
  },
  {
   "id": "s1044",
   "kind": "sentence",
   "text": "أَيْنَ الْجَوَارِبُ؟"
  },
  {
   "id": "s1045",
   "kind": "sentence",
   "text": "الْجَوَارِبُ تَحْتَ السَّرِيرِ."
  },
  {
   "id": "s1046",
   "kind": "sentence",
   "text": "أَيْنَ الْجَاكِتَّةُ؟"
  },
  {
   "id": "s1047",
   "kind": "sentence",
   "text": "الْجَاكِتَّةُ فَوْقَ الْكُرْسِيِّ."
  },
  {
   "id": "s1048",
   "kind": "sentence",
   "text": "أَيْنَ النَّظَّارَةُ؟"
  },
  {
   "id": "s1049",
   "kind": "sentence",
   "text": "النَّظَّارَةُ فَوْقَ التِّلِفِزْيُونِ."
  },
  {
   "id": "s1050",
   "kind": "sentence",
   "text": "أَيْنَ نَدِيم؟"
  },
  {
   "id": "s1051",
   "kind": "sentence",
   "text": "نَدِيم بَيْنَ صَدِيقَيْهِ."
  },
  {
   "id": "s1052",
   "kind": "sentence",
   "text": "أَيْنَ هَالَة؟"
  },
  {
   "id": "s1053",
   "kind": "sentence",
   "text": "هَالَة فِي حُجْرَةِ السُّفْرَةِ."
  },
  {
   "id": "s1054",
   "kind": "sentence",
   "text": "أَيْنَ مُحَمَّد؟"
  },
  {
   "id": "s1055",
   "kind": "sentence",
   "text": "مُحَمَّد بِجَانِبِ السَّيَّارَةِ."
  },
  {
   "id": "s1056",
   "kind": "sentence",
   "text": "أَيْنَ الثَّلَّاجَةُ؟"
  },
  {
   "id": "s1057",
   "kind": "sentence",
   "text": "الثَّلَّاجَةُ بِجَانِبِ الْمَوْقِدِ."
  },
  {
   "id": "s1058",
   "kind": "sentence",
   "text": "أَيْنَ الْحَوْضُ؟"
  },
  {
   "id": "s1059",
   "kind": "sentence",
   "text": "الْحَوْضُ خَلْفَ الْبَابِ."
  },
  {
   "id": "s1060",
   "kind": "sentence",
   "text": "أَيْنَ قِسْمُ الْكَامِيرَاتِ؟"
  },
  {
   "id": "s1061",
   "kind": "sentence",
   "text": "أَيْنَ قِسْمُ الثَّلَّاجَاتِ؟"
  },
  {
   "id": "s1062",
   "kind": "sentence",
   "text": "أَيْنَ قِسْمُ التِّلِفِزْيُونَاتِ؟"
  },
  {
   "id": "s1063",
   "kind": "sentence",
   "text": "أَيْنَ قِسْمُ الْغَسَّالَاتِ؟"
  },
  {
   "id": "s1064",
   "kind": "sentence",
   "text": "أَيْنَ الْكَافِتِيرْيَا؟"
  },
  {
   "id": "s1065",
   "kind": "sentence",
   "text": "أَيْنَ السِّكِّينُ يَا نَدَى؟"
  },
  {
   "id": "s1066",
   "kind": "sentence",
   "text": "السِّكِّينُ فَوْقَ الطَّاوِلَةِ."
  },
  {
   "id": "s1067",
   "kind": "sentence",
   "text": "وَأَيْنَ فِنْجَانُ الشَّايِ؟"
