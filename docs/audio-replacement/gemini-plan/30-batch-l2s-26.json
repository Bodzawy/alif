{
 "batch": "batch-l2s-26",
 "items": [
  {
   "id": "s1244",
   "kind": "sentence",
   "text": "سَمِيرَة تَطْبُخُ الْآنَ."
  },
  {
   "id": "s1245",
   "kind": "sentence",
   "text": "عُدَيّ يَنَامُ الْآنَ."
  },
  {
   "id": "s1246",
   "kind": "sentence",
   "text": "زِيَاد يُفْطِرُ الْآنَ."
  },
  {
   "id": "s1247",
   "kind": "sentence",
   "text": "هَانِي يُشَاهِدُ التِّلِيفِزْيُونَ الْآنَ."
  },
  {
   "id": "s1248",
   "kind": "sentence",
   "text": "مَاجِدَة تَلْبَسُ مَلَابِسَهَا الْآنَ."
  },
  {
   "id": "s1249",
   "kind": "sentence",
   "text": "مُصْطَفَى يُذَاكِرُ الْآنَ."
  },
  {
   "id": "s1250",
   "kind": "sentence",
   "text": "جِهَاد يَرْكَبُ السَّيَّارَةَ الْآنَ."
  },
  {
   "id": "s1251",
   "kind": "sentence",
   "text": "(أ) أَنَا اسْمِي نَدَى."
  },
  {
   "id": "s1252",
   "kind": "sentence",
   "text": "(ب) أَنَا اسْمِي رَاجِيَة."
  },
  {
   "id": "s1253",
   "kind": "sentence",
   "text": "(ج) أَنَا اسْمِي مُصْطَفَى."
  },
  {
   "id": "s1261",
   "kind": "sentence",
   "text": "جَارَتِي السَّيِّدَةُ أَسْمَاءُ سَيِّدَةٌ نَشِيطَةٌ طُوَالَ الْأُسْبُوعِ وَلَكِنْ هِيَ كَسْلَانَةٌ جِدًّا فِي إِجَازَتِهَا الْأُسْبُوعِيَّةِ."
  },
  {
   "id": "s1262",
   "kind": "sentence",
   "text": "هِيَ لَا تَسْتَيْقِظُ مُبَكِّرًا فِي الْإِجَازَةِ وَلَكِنْ تَنَامُ حَتَّى السَّاعَةِ الْحَادِيَةَ عَشْرَةَ."
  },
  {
   "id": "s1263",
   "kind": "sentence",
   "text": "هِيَ لَا تُفْطِرُ فِي الصَّبَاحِ، وَلَكِنْ تَشْرَبُ الْقَهْوَةَ فَقَطْ."
  },
  {
   "id": "s1265",
   "kind": "sentence",
   "text": "هِيَ تَجْلِسُ فِي حُجْرَةِ الْمَعِيشَةِ وَتُشَاهِدُ التِّلِيفِزْيُونَ (التِّلْفَازَ) طُولَ الْوَقْتِ."
  },
  {
   "id": "s1266",
   "kind": "sentence",
   "text": "وَهِيَ لَا تُقَابِلُ صَدِيقَاتِهَا وَلَكِنْ تَتَغَدَّى مَعَ زَوْجِهَا وَأَوْلَادِهَا فِي الْمَطْعَمِ."
  },
  {
   "id": "s1267",
   "kind": "sentence",
   "text": "هَلْ حُسَيْن يُنَظِّفُ الْبَيْتَ يَوْمَ الْجُمْعَةِ؟"
  },
  {
   "id": "s1268",
   "kind": "sentence",
   "text": "لَا، حُسَيْن لَا يُنَظِّفُ الْبَيْتَ يَوْمَ الْجُمْعَةِ."
  },
  {
   "id": "s1269",
   "kind": "sentence",
   "text": "هَلْ هَالَة تُشَاهِدُ فِيلْمًا فِي الْإِجَازَةِ؟"
  },
  {
   "id": "s1270",
   "kind": "sentence",
   "text": "لَا، هَالَة لَا تُشَاهِدُ فِيلْمًا، هَالَة تَزُورُ عَائِلَتَهَا."
  },
  {
   "id": "s1271",
   "kind": "sentence",
   "text": "هَلْ حُسَيْن يَدْرُسُ يَوْمَ الْجُمْعَةِ؟"
  },
  {
   "id": "s1272",
   "kind": "sentence",
   "text": "لَا، حُسَيْن لَا يَدْرُسُ، حُسَيْن يَذْهَبُ إِلَى السِّينِمَا."
  },
  {
   "id": "s1273",
   "kind": "sentence",
   "text": "مَاذَا تَفْعَلُ هَالَة يَوْمَ السَّبْتِ؟"
  },
  {
   "id": "s1274",
   "kind": "sentence",
   "text": "هَالَة تَزُورُ أَبَاهَا وَأُمَّهَا."
  },
  {
   "id": "s1275",
   "kind": "sentence",
   "text": "لَا أُنَظِّفُ"
  },
  {
   "id": "s1276",
   "kind": "sentence",
   "text": "لَا أَدْرُسُ"
  },
  {
   "id": "s1277",
   "kind": "sentence",
   "text": "لَا أَزُورُ"
  },
  {
   "id": "s1278",
   "kind": "sentence",
   "text": "لَا أَلْعَبُ"
  },
  {
   "id": "s1279",
   "kind": "sentence",
   "text": "لَا أَسْمَعُ"
  },
  {
   "id": "s1280",
   "kind": "sentence",
   "text": "هَلْ تَدْرُسُ يَوْمَ الْجُمْعَةِ؟"
  },
  {
   "id": "s1281",
   "kind": "sentence",
   "text": "لَا، لَا أَدْرُسُ يَوْمَ الْجُمْعَةِ، وَلَكِنْ أَلْعَبُ التِّنِسَ."
  },
  {
   "id": "s1282",
   "kind": "sentence",
   "text": "هَلْ تَشْرَبُ الْقَهْوَةَ؟"
  },
  {
   "id": "s1284",
   "kind": "sentence",
   "text": "هَلْ تَلْعَبُ التِّنِسَ؟"
  },
  {
   "id": "s1286",
   "kind": "sentence",
   "text": "هَلْ تَسْمَعُ الرَّادْيُو؟"
  },
  {
   "id": "s1288",
   "kind": "sentence",
   "text": "هَلْ أَنَا أَنَامُ الْآنَ؟"
  },
  {
   "id": "s1290",
   "kind": "sentence",
   "text": "هَلْ مِدْحَت يَرْكَبُ الْأُوتُوبِيسَ؟"
  },
  {
   "id": "s1292",
   "kind": "sentence",
   "text": "هَلْ نَبِيلَة تَدْرُسُ؟"
  },
  {
   "id": "s1294",
   "kind": "sentence",
   "text": "هَلْ أَنْتِ تَسْمَعِينَ الْمُوسِيقَى الْآنَ؟"
  },
  {
   "id": "s1296",
   "kind": "sentence",
   "text": "هَلْ مَاجِدَة تَزُورُ صَدِيقَتَهَا؟"
  },
  {
   "id": "s1298",
   "kind": "sentence",
   "text": "هَلْ أَنْتِ تَلْعَبِينَ التِّنِسَ الْآنَ؟"
  }
 ]
}