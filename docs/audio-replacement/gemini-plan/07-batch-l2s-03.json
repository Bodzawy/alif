   "text": "5 – الرِّيَاض"
  },
  {
   "id": "s0095",
   "kind": "sentence",
   "text": "12 – الظَّهْرَان"
  },
  {
   "id": "s0096",
   "kind": "sentence",
   "text": "6 – الزَّمَالِك"
  },
  {
   "id": "s0097",
   "kind": "sentence",
   "text": "13 – النِّمْسَا"
  },
  {
   "id": "s0098",
   "kind": "sentence",
   "text": "7 – السُّودَان"
  },
  {
   "id": "s0099",
   "kind": "sentence",
   "text": "صَبَاحُ الْخَيْر، أَنَا اسْمِي خَالِد، وَأَنْتَ مَا اسْمُكَ؟"
  },
  {
   "id": "s0101",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ أَنْتَ يَا مُصْطَفَى؟"
  },
  {
   "id": "s0102",
   "kind": "sentence",
   "text": "أَنَا مِنَ السُّعُودِيَّة."
  },
  {
   "id": "s0103",
   "kind": "sentence",
   "text": "مَسَاءُ الْخَيْر، أَنَا اسْمِي فَرِيدَة، وَأَنْتِ مَا اسْمُكِ؟"
  },
  {
   "id": "s0105",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ أَنْتِ يَا فَرِيدَة؟"
  },
  {
   "id": "s0107",
   "kind": "sentence",
   "text": "صَبَاحُ الْخَيْر، أَنَا خَالِد، وَأَنْتَ مَا اسْمُكَ؟"
  },
  {
   "id": "s0108",
   "kind": "sentence",
   "text": "أَنَا خَالِد وَمِنْ أَيْنَ أَنْتَ؟"
  },
  {
   "id": "s0109",
   "kind": "sentence",
   "text": "أَنَا مِنْ مِصْر."
  },
  {
   "id": "s0110",
   "kind": "sentence",
   "text": "مَنْ هِيَ؟"
  },
  {
   "id": "s0111",
   "kind": "sentence",
   "text": "مَنْ هُمَا؟"
  },
  {
   "id": "s0112",
   "kind": "sentence",
   "text": "مَنْ هُمْ؟"
  },
  {
   "id": "s0113",
   "kind": "sentence",
   "text": "مَنْ هُنَّ؟"
  },
  {
   "id": "s0114",
   "kind": "sentence",
   "text": "مَا اسْمُ سِيَادَتِكَ؟"
  },
  {
   "id": "s0115",
   "kind": "sentence",
   "text": "مَا اسْمُ سِيَادَتِكِ؟"
  },
  {
   "id": "s0116",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ أَنْتَ؟"
  },
  {
   "id": "s0117",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ أَنْتِ؟"
  },
  {
   "id": "s0118",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ أَنْتُمَا؟"
  },
  {
   "id": "s0119",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ أَنْتُمْ؟"
  },
  {
   "id": "s0120",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ أَنْتُنَّ؟"
  },
  {
   "id": "s0121",
   "kind": "sentence",
   "text": "أَحْمَد – إِحْسَان – أُمَيْمَة"
  },
  {
   "id": "s0122",
   "kind": "sentence",
   "text": "سَأَلَ – أَسْئِلَة – سُؤَال"
  },
  {
   "id": "s0123",
   "kind": "sentence",
   "text": "بَدَأَ – بَطِيء – تَبَاطُؤ – بَدْء – ضَوْء – هَنَاء"
  },
  {
   "id": "s0124",
   "kind": "sentence",
   "text": "اسْم – ابْن – الصُّومَال"
  },
  {
   "id": "s0126",
   "kind": "sentence",
   "text": "هَلْ أَنْتُمْ مِنْ أُسْتُرَالْيَا؟"
  },
  {
   "id": "s0128",
   "kind": "sentence",
   "text": "هُوَ اسْمُهُ إِسْلَام، هُوَ مِنْ زَائِير."
  },
  {
   "id": "s0129",
   "kind": "sentence",
   "text": "هَلْ أَنْتُنَّ مِنْ أَمْسْتَرْدَام؟"
  },
  {
   "id": "s0130",
   "kind": "sentence",
   "text": "نَحْنُ أَسْمَاؤُنَا مُؤْنِس وَرَؤُوف وَأَيْمَن."
  },
  {
   "id": "s0132",
   "kind": "sentence",
   "text": "مَسَاءُ الْخَيْرِ يَا رَائِف."
  },
  {
   "id": "s0133",
   "kind": "sentence",
   "text": "أَهْلًا وَسَهْلًا بِكِ يَا أُمَيْمَة."
  },
  {
   "id": "s0134",
   "kind": "sentence",
   "text": "هَلْ أَنْتَ الْأُسْتَاذ وَائِل؟"
  },
  {
   "id": "s0135",
   "kind": "sentence",
   "text": "هَلْ أَنْتُمَا مِنْ زَائِير؟"
  },
  {
   "id": "s0136",
   "kind": "sentence",
   "text": "أَبِي مِنْ أَسْيُوط."
  },
  {
   "id": "s0139",
   "kind": "sentence",
   "text": "وَأُمِّي مِنْ أَسْوَان."
  },
  {
   "id": "s0140",
   "kind": "sentence",
   "text": "أَهْلًا بِكَ يَا مُؤْمِنَة."
  },
  {
   "id": "s0141",
   "kind": "sentence",
   "text": "مَسَاءُ النُّورِ يَا رَؤُوف."
  },
  {
   "id": "s0150",
   "kind": "sentence",
   "text": "مَعَ السَّلَامَةِ"
  },
  {
   "id": "s0151",
   "kind": "sentence",
   "text": "أَهْلًا وَسَهْلًا"
  },
  {
   "id": "s0152",
   "kind": "sentence",
   "text": "لَا مُشْكِلَةَ"
  },
  {
   "id": "s0153",
   "kind": "sentence",
   "text": "أَهْلًا وَسَهْلًا."
  }
 ]
