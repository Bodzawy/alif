{
 "batch": "batch-l2s-22",
 "items": [
  {
   "id": "s1072",
   "kind": "sentence",
   "text": "سَلَّةُ الْمُهْمَلَاتِ تَحْتَ الْكُرْسِيِّ."
  },
  {
   "id": "s1073",
   "kind": "sentence",
   "text": "أَيْنَ الْمِكْنَسَةُ؟"
  },
  {
   "id": "s1074",
   "kind": "sentence",
   "text": "الْمِكْنَسَةُ خَلْفَ الْبَابِ."
  },
  {
   "id": "s1075",
   "kind": "sentence",
   "text": "أَيْنَ عُلْبَةُ اللَّبَنِ؟"
  },
  {
   "id": "s1076",
   "kind": "sentence",
   "text": "عُلْبَةُ اللَّبَنِ فَوْقَ الطَّاوِلَةِ."
  },
  {
   "id": "s1077",
   "kind": "sentence",
   "text": "أَيْنَ صَالَةُ التَّرَانْزِيت؟"
  },
  {
   "id": "s1078",
   "kind": "sentence",
   "text": "أَيْنَ صَالَةُ السَّفَرِ؟"
  },
  {
   "id": "s1079",
   "kind": "sentence",
   "text": "أَيْنَ صَالَةُ الْوُصُولِ؟"
  },
  {
   "id": "s1080",
   "kind": "sentence",
   "text": "أَيْنَ مَكْتَبُ السِّيَاحَةِ؟"
  },
  {
   "id": "s1081",
   "kind": "sentence",
   "text": "أَيْنَ دَوْرَاتُ الْمِيَاهِ؟"
  },
  {
   "id": "s1082",
   "kind": "sentence",
   "text": "أَيْنَ الْحَقَائِبُ؟"
  },
  {
   "id": "s1083",
   "kind": "sentence",
   "text": "أَيْنَ الْجَرَاجُ؟"
  },
  {
   "id": "s1084",
   "kind": "sentence",
   "text": "أَيْنَ مَكْتَبُ الْأَمْنِ؟"
  },
  {
   "id": "s1085",
   "kind": "sentence",
   "text": "أَيْنَ اسْتِعْلَامَاتُ الْمَطَارِ؟"
  },
  {
   "id": "s1086",
   "kind": "sentence",
   "text": "أَيْنَ وَزْنُ الْحَقَائِبِ؟"
  },
  {
   "id": "s1087",
   "kind": "sentence",
   "text": "أَيْنَ السُّوقُ الْحُرَّةُ؟"
  },
  {
   "id": "s1088",
   "kind": "sentence",
   "text": "عَزِيزِي خَالِد:"
  },
  {
   "id": "s1089",
   "kind": "sentence",
   "text": "أَنَا فِي صَالَةِ التَّرَانْزِيت، بِالدَّوْرِ الثَّانِي بِجَانِبِ الْكَافِتِيرْيَا رَقْم (١)."
  },
  {
   "id": "s1091",
   "kind": "sentence",
   "text": "مَكْتَبُ بَرِيدٍ"
  },
  {
   "id": "s1092",
   "kind": "sentence",
   "text": "دُرْ = لِفَّ"
  },
  {
   "id": "s1093",
   "kind": "sentence",
   "text": "قَبْلَ التَّقَاطُعِ"
  },
  {
   "id": "s1094",
   "kind": "sentence",
   "text": "بَعْدَ التَّقَاطُعِ مَعَ …"
  },
  {
   "id": "s1095",
   "kind": "sentence",
   "text": "اُدْخُلْ يَمِينًا وَاسْتَمِرَّ حَتَّى آخِرِ الشَّارِعِ"
  },
  {
   "id": "s1096",
   "kind": "sentence",
   "text": "بَيْتِي الْجَدِيدُ فِي مِنْطَقَةِ الْمُهَنْدِسِين بِالْقَاهِرَةِ."
  },
  {
   "id": "s1097",
   "kind": "sentence",
   "text": "عُنْوَانِي خَمْسَة وَسِتُّونَ شَارِعُ الثَّوْرَةِ، الدَّوْرُ الثَّالِثُ، شَقَّةُ سِتَّة وَأَرْبَعُونَ."
  },
  {
   "id": "s1098",
   "kind": "sentence",
   "text": "الْعِمَارَةُ بِجَانِبِ مَسْجِدِ الصِّدِّيقِ أَمَامَ الْمَرْكَزِ التِّجَارِيِّ."
  },
  {
   "id": "s1099",
   "kind": "sentence",
   "text": "اُدْخُلْ شَارِعَ أَحْمَد حُسَيْن – اسْتَمِرَّ فِي الشَّارِعِ حَتَّى التَّقَاطُعِ – الْعِمَارَةُ عَلَى النَّاصِيَةِ."
  },
  {
   "id": "s1100",
   "kind": "sentence",
   "text": "أَيْنَ الصَّيْدَلِيَّةُ؟"
  },
  {
   "id": "s1101",
   "kind": "sentence",
   "text": "لِفَّ (دُرْ) الْمَيْدَانَ – اُدْخُلْ يَمِينًا / يَسَارًا"
  },
  {
   "id": "s1102",
   "kind": "sentence",
   "text": "الصَّيْدَلِيَّةُ عَلَى الْيَمِينِ / الْيَسَارِ – عَلَى النَّاصِيَةِ"
  },
  {
   "id": "s1103",
   "kind": "sentence",
   "text": "هَلِ الصَّيْدَلِيَّةُ عَلَى الْيَمِينِ؟"
  },
  {
   "id": "s1104",
   "kind": "sentence",
   "text": "لَا، الصَّيْدَلِيَّةُ لَيْسَتْ عَلَى الْيَمِينِ، الصَّيْدَلِيَّةُ عَلَى الْيَسَارِ."
  },
  {
   "id": "s1105",
   "kind": "sentence",
   "text": "نَعَمْ، عَلَى الْيَمِينِ."
  },
  {
   "id": "s1106",
   "kind": "sentence",
   "text": "هَذَا مَسْجِد"
  },
  {
   "id": "s1107",
   "kind": "sentence",
   "text": "قِسْمُ الْبُولِيس"
  },
  {
   "id": "s1108",
   "kind": "sentence",
   "text": "مَحَطَّةُ أُوتُوبِيس"
  },
  {
   "id": "s1109",
   "kind": "sentence",
   "text": "عُنْوَانُ شَادِي: ٦٥ شَارِعُ الثَّوْرَةِ، الدَّوْرُ الثَّالِثُ، شَقَّةُ رَقْم ٤٦"
  },
  {
   "id": "s1110",
   "kind": "sentence",
   "text": "طَرِيقَةُ الْوُصُولِ: اُدْخُلْ شَارِعَ أَحْمَد حُسَيْن – اسْتَمِرَّ فِي الشَّارِعِ حَتَّى التَّقَاطُعِ – الْعِمَارَةُ عَلَى النَّاصِيَةِ."
  },
  {
   "id": "s1111",
   "kind": "sentence",
   "text": "مَوْعِدُ الْحَفْلَةِ: يَوْمَ الْخَمِيسِ السَّاعَةَ السَّادِسَةَ مَسَاءً."
  }
 ]
}