 "items": [
  {
   "id": "s1541",
   "kind": "sentence",
   "text": "مَنْ يَلْبَسُ نَظَّارَةً؟"
  },
  {
   "id": "s1542",
   "kind": "sentence",
   "text": "مَنْ تَلْبَسُ جُونِلَّةً؟"
  },
  {
   "id": "s1543",
   "kind": "sentence",
   "text": "مَنْ تَلْبَسُ قُبَّعَةً؟"
  },
  {
   "id": "s1544",
   "kind": "sentence",
   "text": "هَلْ عَلَاء يَشْرَبُ؟"
  },
  {
   "id": "s1546",
   "kind": "sentence",
   "text": "هَلْ شَاكِر يَشْرَبُ؟"
  },
  {
   "id": "s1547",
   "kind": "sentence",
   "text": "نَعَمْ، شَاكِر يَشْرَبُ عَصِيرًا."
  },
  {
   "id": "s1548",
   "kind": "sentence",
   "text": "هَلْ سَلِيم يَقْرَأُ؟"
  },
  {
   "id": "s1550",
   "kind": "sentence",
   "text": "هَلْ تَامِر يَتَكَلَّمُ؟"
  },
  {
   "id": "s1552",
   "kind": "sentence",
   "text": "هَلْ صَفَاء تُشَاهِدُ التِّلِيفِزْيُونَ؟"
  },
  {
   "id": "s1554",
   "kind": "sentence",
   "text": "هَلْ سَلْمَى تَكْتُبُ خِطَابًا؟"
  },
  {
   "id": "s1555",
   "kind": "sentence",
   "text": "لَا، سَلْمَى لَيْسَتْ فِي الصُّورَةِ؛ صَفَاء تَكْتُبُ خِطَابًا."
  },
  {
   "id": "s1556",
   "kind": "sentence",
   "text": "هُوَيْدَا لَا تُشَاهِدُ التِّلِيفِزْيُونَ فِي الْإِجَازَةِ."
  },
  {
   "id": "s1557",
   "kind": "sentence",
   "text": "هُوَيْدَا لَا تَلْعَبُ رِيَاضَةً فِي الْإِجَازَةِ."
  },
  {
   "id": "s1558",
   "kind": "sentence",
   "text": "هُوَيْدَا تَطْبُخُ فِي الْإِجَازَةِ."
  },
  {
   "id": "s1559",
   "kind": "sentence",
   "text": "هُوَيْدَا تُنَظِّفُ فِي الْإِجَازَةِ."
  },
  {
   "id": "s1560",
   "kind": "sentence",
   "text": "هُوَيْدَا لَا تَقْرَأُ فِي الْإِجَازَةِ."
  },
  {
   "id": "s1561",
   "kind": "sentence",
   "text": "هُوَيْدَا لَا تَسْمَعُ مُوسِيقَى فِي الْإِجَازَةِ."
  },
  {
   "id": "s1562",
   "kind": "sentence",
   "text": "هُوَيْدَا تَكْتُبُ عَلَى الْكُمْبِيُوتَرِ فِي الْإِجَازَةِ."
  },
  {
   "id": "s1563",
   "kind": "sentence",
   "text": "وَالِدُ هُوَيْدَا لَا يُنَظِّفُ الْمَنْزِلَ فِي الْإِجَازَةِ."
  },
  {
   "id": "s1564",
   "kind": "sentence",
   "text": "وَالِدُ هُوَيْدَا يَقْرَأُ الْجَرِيدَةَ فِي الْإِجَازَةِ."
  },
  {
   "id": "s1565",
   "kind": "sentence",
   "text": "وَالِدُ هُوَيْدَا لَا يَطْبُخُ فِي الْإِجَازَةِ."
  },
  {
   "id": "s1566",
   "kind": "sentence",
   "text": "وَالِدُ هُوَيْدَا يَسْمَعُ الْمُوسِيقَى فِي الْإِجَازَةِ."
  },
  {
   "id": "s1567",
   "kind": "sentence",
   "text": "وَالِدُ هُوَيْدَا لَا يَكْتُبُ عَلَى الْكُمْبِيُوتَرِ فِي الْإِجَازَةِ."
  },
  {
   "id": "s1568",
   "kind": "sentence",
   "text": "وَالِدُ هُوَيْدَا يُشَاهِدُ التِّلِيفِزْيُونَ فِي الْإِجَازَةِ."
  },
  {
   "id": "s1569",
   "kind": "sentence",
   "text": "وَالِدُ هُوَيْدَا يَلْعَبُ تِنِس فِي الْإِجَازَةِ."
  },
  {
   "id": "s1570",
   "kind": "sentence",
   "text": "قَوَاعِدُ الْعَرَبِيَّةِ"
