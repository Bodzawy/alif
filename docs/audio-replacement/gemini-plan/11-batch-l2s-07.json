{
 "batch": "batch-l2s-07",
 "items": [
  {
   "id": "s0298",
   "kind": "sentence",
   "text": "هَذَا الْمِفْتَاح مِنْ إِيرَان، هَذَا مِفْتَاح إِيرَانِيّ."
  },
  {
   "id": "s0299",
   "kind": "sentence",
   "text": "أَمْجَد – إِيمَان – أُسَامَة"
  },
  {
   "id": "s0300",
   "kind": "sentence",
   "text": "سَأَلَ – بِئْر – فُؤَاد"
  },
  {
   "id": "s0301",
   "kind": "sentence",
   "text": "مَا هَذَا؟"
  },
  {
   "id": "s0302",
   "kind": "sentence",
   "text": "مَا هَذِهِ؟"
  },
  {
   "id": "s0304",
   "kind": "sentence",
   "text": "نَعَمْ، هَذَا كِتَابٌ (إِيجَاب)."
  },
  {
   "id": "s0305",
   "kind": "sentence",
   "text": "هَذَا كِتَابُهُ."
  },
  {
   "id": "s0306",
   "kind": "sentence",
   "text": "هَذَا كِتَابُهَا."
  },
  {
   "id": "s0307",
   "kind": "sentence",
   "text": "هَذَا كِتَابُهُمَا."
  },
  {
   "id": "s0308",
   "kind": "sentence",
   "text": "هَذَا كِتَابُهُمْ."
  },
  {
   "id": "s0309",
   "kind": "sentence",
   "text": "هَذَا كِتَابُهُنَّ."
  },
  {
   "id": "s0310",
   "kind": "sentence",
   "text": "هَذَا كِتَابِي."
  },
  {
   "id": "s0311",
   "kind": "sentence",
   "text": "هَذَا كِتَابُنَا."
  },
  {
   "id": "s0312",
   "kind": "sentence",
   "text": "هَذِهِ حَقِيبَتُهُ."
  },
  {
   "id": "s0313",
   "kind": "sentence",
   "text": "هَذِهِ حَقِيبَتُهَا."
  },
  {
   "id": "s0314",
   "kind": "sentence",
   "text": "هَذِهِ حَقِيبَتُهُمَا."
  },
  {
   "id": "s0315",
   "kind": "sentence",
   "text": "هَذِهِ حَقِيبَتُهُمْ."
  },
  {
   "id": "s0316",
   "kind": "sentence",
   "text": "هَذِهِ حَقِيبَتُهُنَّ."
  },
  {
   "id": "s0317",
   "kind": "sentence",
   "text": "هَذِهِ حَقِيبَتِي."
  },
  {
   "id": "s0318",
   "kind": "sentence",
   "text": "هَذِهِ حَقِيبَتُنَا."
  },
  {
   "id": "s0319",
   "kind": "sentence",
   "text": "أَنَا اسْمِي خَالِد."
  },
  {
   "id": "s0320",
   "kind": "sentence",
   "text": "صَدِيقِي اسْمُهُ زَيْد، زَيْد مِنَ الْكُوَيْتِ."
  },
  {
   "id": "s0321",
   "kind": "sentence",
   "text": "هُوَ كُوَيْتِيّ."
  },
  {
   "id": "s0322",
   "kind": "sentence",
   "text": "نَحْنُ فِي بَيْتِ صَدِيقِي زَيْد."
  },
  {
   "id": "s0324",
   "kind": "sentence",
   "text": "هُوَ زَمِيلِي فِي جَامِعَةِ الْقَاهِرَةِ."
  },
  {
   "id": "s0325",
   "kind": "sentence",
   "text": "هُوَ صَدِيقُ عَلَاء وَطَلَال وَشَيْمَاء وَسَمَر."
  },
  {
   "id": "s0326",
   "kind": "sentence",
   "text": "هُوَ زَمِيلُهُمْ أَيْضًا."
  },
  {
   "id": "s0327",
   "kind": "sentence",
   "text": "مِفْتَاحُ مَنْ هَذَا؟"
  },
  {
   "id": "s0328",
   "kind": "sentence",
   "text": "هَذَا مِفْتَاحُ مَاجِدَة."
  },
  {
   "id": "s0329",
   "kind": "sentence",
   "text": "هَذَا مِفْتَاحُهَا."
  },
  {
   "id": "s0330",
   "kind": "sentence",
   "text": "كِتَابُ مَنْ هَذَا؟"
  },
  {
   "id": "s0331",
   "kind": "sentence",
   "text": "هَذَا كِتَابُ وَائِل."
  },
  {
   "id": "s0332",
   "kind": "sentence",
   "text": "هَذَا كِتَابُ … أَنْتَ."
  },
  {
   "id": "s0333",
   "kind": "sentence",
   "text": "هَذَا كِتَابُكَ."
  },
  {
   "id": "s0334",
   "kind": "sentence",
   "text": "هَذَا كِتَابُ … أَنَا."
  },
  {
   "id": "s0335",
   "kind": "sentence",
   "text": "طَاوِلَةُ مَنْ هَذِهِ؟"
  },
  {
   "id": "s0336",
   "kind": "sentence",
   "text": "هَذِهِ طَاوِلَةُ وَلَاء وَسُعَاد."
  },
  {
   "id": "s0337",
   "kind": "sentence",
   "text": "هَذِهِ طَاوِلَتُهُمَا."
  },
  {
   "id": "s0338",
   "kind": "sentence",
   "text": "أَوْرَاقُ مَنْ هَذِهِ؟"
  },
  {
   "id": "s0339",
   "kind": "sentence",
   "text": "هَذِهِ أَوْرَاقُ عَادِل وَطَلَال."
  },
  {
   "id": "s0340",
   "kind": "sentence",
   "text": "هَذِهِ أَوْرَاقُهُمَا."
  },
  {
   "id": "s0341",
   "kind": "sentence",
   "text": "صُوَرُ مَنْ هَذِهِ؟"
  },
  {
   "id": "s0342",
   "kind": "sentence",
   "text": "هَذِهِ صُوَرُ مُحَمَّد وَنَاجِي وَإِبْرَاهِيم."
  },
  {
   "id": "s0343",
   "kind": "sentence",
   "text": "هَذِهِ صُوَرُهُمْ."
  },
  {
   "id": "s0344",
   "kind": "sentence",
   "text": "كَرَاسِي مَنْ هَذِهِ؟"
  }
 ]
