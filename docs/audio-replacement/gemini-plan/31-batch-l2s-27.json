   "text": "لَا تَفْعَلُ"
  },
  {
   "id": "s1331",
   "kind": "sentence",
   "text": "لَا تَفْعَلِينَ"
  },
  {
   "id": "s1332",
   "kind": "sentence",
   "text": "لَا يَفْعَلُ"
  },
  {
   "id": "s1334",
   "kind": "sentence",
   "text": "أَنَا اسْمِي عِصَام وَأَبِي اسْمُهُ مَحْمُود وَأُمِّي اسْمُهَا فَاطِمَة، خَدِيجَة هِيَ أُخْتِي، طَارِق أَخِي الْكَبِيرُ."
  },
  {
   "id": "s1337",
   "kind": "sentence",
   "text": "صَالِح لَيْسَ أَبِي هُوَ جَدِّي وَزَيْنَب لَيْسَتْ أُمِّي هِيَ جَدَّتِي."
  },
  {
   "id": "s1338",
   "kind": "sentence",
   "text": "جَدِّي صَالِح مُهَنْدِسٌ."
  },
  {
   "id": "s1339",
   "kind": "sentence",
   "text": "أَبِي مَحْمُود ضَابِطٌ."
  },
  {
   "id": "s1340",
   "kind": "sentence",
   "text": "أَخِي طَارِق مُحَاسِبٌ."
  },
  {
   "id": "s1341",
   "kind": "sentence",
   "text": "جَدَّتِي زَيْنَب مُدِيرَةٌ."
  },
  {
   "id": "s1342",
   "kind": "sentence",
   "text": "وَالِدَتِي فَاطِمَة مُدَرِّسَةٌ."
  },
  {
   "id": "s1343",
   "kind": "sentence",
   "text": "أُخْتِي خَدِيجَة مُمَرِّضَةٌ."
  },
  {
   "id": "s1344",
   "kind": "sentence",
   "text": "أَنَا عِصَام مُحَامٍ."
  },
  {
   "id": "s1345",
   "kind": "sentence",
   "text": "عَزِيزِي غَسَّان، بَعْدَ التَّحِيَّةِ، شُكْرًا لَكَ عَلَى رِسَالَتِكَ الْجَمِيلَةِ."
  },
  {
   "id": "s1350",
   "kind": "sentence",
   "text": "أَخُوكَ، نَادِي"
  },
  {
   "id": "s1351",
   "kind": "sentence",
   "text": "صَالِح هُوَ جَدُّ عِصَام وَهُوَ أَبُو مَحْمُود."
  },
  {
   "id": "s1352",
   "kind": "sentence",
   "text": "زَيْنَب هِيَ جَدَّةُ عِصَام وَهِيَ أُمُّ مَحْمُود."
  },
  {
   "id": "s1353",
   "kind": "sentence",
   "text": "مَحْمُود هُوَ أَبُو عِصَام وَهُوَ ابْنُ صَالِح."
  },
  {
   "id": "s1360",
   "kind": "sentence",
   "text": "هَلْ حُسَام وَالِدُكَ؟"
