   "text": "مَنْ أَنْتُنَّ؟"
  },
  {
   "id": "x013",
   "kind": "sentence",
   "text": "نَحْنُ نِسْمَة وَنُورَا وَنِسْرِين."
  },
  {
   "id": "x014",
   "kind": "sentence",
   "text": "مَنْ أَنْتَ؟"
  },
  {
   "id": "x015",
   "kind": "sentence",
   "text": "وَأَنَا مِنْ مِصْر. أَهْلًا وَسَهْلًا بِكَ فِي مِصْر."
  },
  {
   "id": "x016",
   "kind": "sentence",
   "text": "أَهْلًا بِكَ."
  },
  {
   "id": "x017",
   "kind": "sentence",
   "text": "أَهْلًا بِكِ."
  },
  {
   "id": "x018",
   "kind": "sentence",
   "text": "مَعَ السَّلَامَةِ."
  },
  {
   "id": "x019",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ هَذِهِ الدَّرَّاجَةُ؟"
  },
  {
   "id": "x020",
   "kind": "sentence",
   "text": "هَذِهِ مِحْفَظَةُ زَيْد. هَذِهِ مِحْفَظَتُهُ."
  },
  {
   "id": "x021",
   "kind": "sentence",
   "text": "هَلْ هَذَا كِتَابٌ؟"
  },
  {
   "id": "x022",
   "kind": "sentence",
   "text": "هَلْ هَذِهِ حَقِيبَتُكَ؟"
  },
  {
   "id": "x023",
   "kind": "sentence",
   "text": "لَا، هَذَا لَيْسَ كِتَابًا. هَذَا قَلَمٌ."
  },
  {
   "id": "x024",
   "kind": "sentence",
   "text": "هَلْ هَذِهِ نَظَّارَةٌ؟"
  },
  {
   "id": "x025",
   "kind": "sentence",
   "text": "مَرْحَبًا. أَهْلًا وَسَهْلًا يَا أَفَنْدِم."
  },
  {
   "id": "x026",
   "kind": "sentence",
   "text": "السَّلَامُ عَلَيْكُمْ."
  },
  {
   "id": "x027",
   "kind": "sentence",
   "text": "عَفْوًا، مَعَ السَّلَامَةِ."
  },
  {
   "id": "x028",
   "kind": "sentence",
   "text": "وَعَلَيْكُمُ السَّلَامُ. أَيَّ خِدْمَةٍ؟"
  },
  {
