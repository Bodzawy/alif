   "text": "٣ – ١٠ = جُنَيْهَات"
  },
  {
   "id": "s1003",
   "kind": "sentence",
   "text": "١١ – ٩٩ = جُنَيْهًا"
  },
  {
   "id": "s1004",
   "kind": "sentence",
   "text": "مَا سِعْرُ هَذَا الْقَمِيصِ؟"
  },
  {
   "id": "s1005",
   "kind": "sentence",
   "text": "مَا سِعْرُ هَذِهِ الْحَقِيبَةِ؟"
  },
  {
   "id": "s1006",
   "kind": "sentence",
   "text": "مَا لَوْنُ هَذَا الْحِذَاءِ؟"
  },
  {
   "id": "s1007",
   "kind": "sentence",
   "text": "هَلْ هَذَا حِذَاءٌ أَحْمَرُ؟"
  },
  {
   "id": "s1008",
   "kind": "sentence",
   "text": "لَا، هَذَا لَيْسَ حِذَاءً أَحْمَرَ، هَذَا حِذَاءٌ أَسْوَدُ."
  },
  {
   "id": "s1009",
   "kind": "sentence",
   "text": "هَلْ هَذِهِ حَقِيبَةٌ حَمْرَاءُ؟"
  },
  {
   "id": "s1010",
   "kind": "sentence",
   "text": "لَا، هَذِهِ لَيْسَتْ حَقِيبَةً حَمْرَاءَ، هَذِهِ حَقِيبَةٌ سَوْدَاءُ."
  },
  {
   "id": "s1011",
   "kind": "sentence",
   "text": "الْحِذَاءُ تَحْتَ الْكُرْسِيِّ."
  },
  {
   "id": "s1012",
   "kind": "sentence",
   "text": "الْجَوْرَبُ فَوْقَ الْكَنَبَةِ (الْأَرِيكَةِ)."
  },
  {
   "id": "s1013",
   "kind": "sentence",
   "text": "الْقَمِيصُ فَوْقَ التِّلِفِزْيُونِ."
  },
  {
   "id": "s1014",
   "kind": "sentence",
   "text": "الْبَنْطَلُونُ تَحْتَ التِّلِيفُونِ."
  },
  {
   "id": "s1015",
   "kind": "sentence",
   "text": "الْحَقِيبَةُ خَلْفَ الْبَابِ."
  },
  {
   "id": "s1016",
   "kind": "sentence",
   "text": "الْمِحْفَظَةُ أَمَامَ التِّلِفِزْيُونِ."
  },
  {
   "id": "s1017",
   "kind": "sentence",
   "text": "النَّظَّارَةُ بَيْنَ التِّلِفِزْيُونِ وَالْمِصْبَاحِ."
  },
  {
   "id": "s1018",
