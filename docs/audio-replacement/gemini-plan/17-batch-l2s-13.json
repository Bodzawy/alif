{
 "batch": "batch-l2s-13",
 "items": [
  {
   "id": "s0616",
   "kind": "sentence",
   "text": "مَا رَقْمُ تِلِيفُونِكَ؟"
  },
  {
   "id": "s0617",
   "kind": "sentence",
   "text": "مَا رَقْمُ تِلِيفُونِكِ؟"
  },
  {
   "id": "s0618",
   "kind": "sentence",
   "text": "مَا رَقْمُ تِلِيفُونِهِ؟"
  },
  {
   "id": "s0619",
   "kind": "sentence",
   "text": "مَا رَقْمُ تِلِيفُونِهَا؟"
  },
  {
   "id": "s0621",
   "kind": "sentence",
   "text": "أَيُّ دَوْرٍ؟"
  },
  {
   "id": "s0622",
   "kind": "sentence",
   "text": "مَا رَقْمُ الشَّقَّةِ؟"
  },
  {
   "id": "s0650",
   "kind": "sentence",
   "text": "صُورَة: مُمَرِّضَة وَرَجُل عَلَى التِّلِيفُون"
  },
  {
   "id": "s0651",
   "kind": "sentence",
   "text": "صُورَة: مُمَرِّضَة وَسَيِّدَة عَلَى التِّلِيفُون"
  },
  {
   "id": "s0652",
   "kind": "sentence",
   "text": "عُنْوَانُهُ ١٥ شَارِعُ الْبَرَازِيلِ، الدَّوْرُ الرَّابِعُ، شَقَّةُ ١٩."
  },
  {
   "id": "s0653",
   "kind": "sentence",
   "text": "رَقْمُ الْفَاكْسِ ٣٢٥٦٤٤٠١"
  },
  {
   "id": "s0654",
   "kind": "sentence",
   "text": "وَعَلَيْكُمُ السَّلَامُ."
  },
  {
   "id": "s0655",
   "kind": "sentence",
   "text": "أَلُو، السَّلَامُ عَلَيْكُمْ."
  },
  {
   "id": "s0656",
   "kind": "sentence",
   "text": "لَوْ سَمَحْتِ، مَا رَقْمُ تِلِيفُونِ مُسْتَشْفَى الشِّفَاءِ؟"
  },
  {
   "id": "s0657",
   "kind": "sentence",
   "text": "رَقْمُ تِلِيفُونِهَا ٢٣٤٨٧٦٥٢."
  },
  {
   "id": "s0659",
   "kind": "sentence",
   "text": "عُنْوَانُهَا شَارِعُ مُرَاد."
  },
  {
   "id": "s0660",
   "kind": "sentence",
   "text": "اسْمُ الْفُنْدُقِ: الْوَرْدَةُ الْبَيْضَاءُ"
  },
  {
   "id": "s0661",
   "kind": "sentence",
   "text": "رَقْمُ الْحُجْرَةِ ١٢، الدَّوْرُ الثَّانِي"
  },
  {
   "id": "s0662",
   "kind": "sentence",
   "text": "رَقْمُ تِلِيفُونِ الْفُنْدُقِ: ٣٥٤١٣٧٢٨ أَوْ ٣٥٤١٣٧٢٩"
  },
  {
   "id": "s0663",
   "kind": "sentence",
   "text": "رَقْمُ تِلِيفُونِهِ الْمَحْمُولِ: ٠١٨٨٩٥٣٤٢١"
  },
  {
   "id": "s0664",
   "kind": "sentence",
   "text": "عَزِيزِي …،"
  },
  {
   "id": "s0665",
   "kind": "sentence",
   "text": "أَنَا الْآنَ فِي الْمَعْهَدِ الدَّوْلِيِّ لِلُّغَاتِ وَرَقْمُ تِلِيفُونِ الْمَعْهَدِ ٣٣٤٦٣٠٨٧"
  },
  {
   "id": "s0666",
   "kind": "sentence",
   "text": "أَوْ ٣٣٠٢٨٣٥٨، رَقْمُ الْفَاكْسِ ٣٣٠٣٥٦٢٤"
  },
  {
   "id": "s0667",
   "kind": "sentence",
   "text": "الْعُنْوَانُ ٤ شَارِعُ مَحْمُود عَزْمِي"
  },
  {
   "id": "s0668",
   "kind": "sentence",
   "text": "مَا رَقْمُ تِلِيفُونِ الْمَعْهَدِ؟"
  },
  {
   "id": "s0669",
   "kind": "sentence",
   "text": "مَا رَقْمُ الْفَاكْسِ؟"
  },
  {
   "id": "s0670",
   "kind": "sentence",
   "text": "مَا عُنْوَانُ الْمَعْهَدِ؟"
  },
  {
   "id": "s0671",
   "kind": "sentence",
   "text": "مَا رَقْمُ تِلِيفُونِكَ الْمَحْمُولِ؟"
  },
  {
   "id": "s0672",
   "kind": "sentence",
   "text": "مَا اسْمُ الطَّالِبَةِ؟"
  },
  {
   "id": "s0673",
   "kind": "sentence",
   "text": "مَا اسْمُ جَامِعَتِهَا؟"
  },
  {
   "id": "s0674",
   "kind": "sentence",
   "text": "رَقْمُ الْمَحْمُولِ"
  },
  {
   "id": "s0675",
   "kind": "sentence",
   "text": "تَارِيخُ الْمِيلَادِ"
  },
  {
   "id": "s0676",
   "kind": "sentence",
   "text": "مَنْ هِيَ دِيَانَا؟"
  },
  {
   "id": "s0677",
   "kind": "sentence",
   "text": "وَاحِد وَأَرْبَعُون"
  },
  {
   "id": "s0678",
   "kind": "sentence",
   "text": "سِتَّة وَخَمْسُون"
  },
  {
   "id": "s0679",
   "kind": "sentence",
   "text": "أَرْبَعَة وَسِتُّون"
  },
  {
   "id": "s0680",
   "kind": "sentence",
   "text": "ثَمَانِيَة وَسِتُّون"
  },
  {
   "id": "s0681",
   "kind": "sentence",
   "text": "خَمْسَة وَسَبْعُون"
  },
  {
   "id": "s0682",
   "kind": "sentence",
   "text": "سَبْعَة وَثَمَانُون"
  },
  {
   "id": "s0683",
   "kind": "sentence",
   "text": "السَّاعَةُ الثَّانِيَة بِالضَّبْطِ"
  },
  {
   "id": "s0684",
   "kind": "sentence",
   "text": "السَّاعَةُ الْعَاشِرَة بِالضَّبْطِ"
  },
  {
   "id": "s0685",
   "kind": "sentence",
   "text": "السَّاعَةُ الْعَاشِرَة وَعَشْرُ دَقَائِقَ"
  },
  {
   "id": "s0686",
   "kind": "sentence",
   "text": "الْعَاشِرَة وَالرُّبْعُ"
  },
  {
   "id": "s0687",
   "kind": "sentence",
   "text": "الْعَاشِرَة وَالثُّلْثُ"
  },
  {
   "id": "s0688",
   "kind": "sentence",
   "text": "الْعَاشِرَة وَالنِّصْفُ"
  }
 ]
