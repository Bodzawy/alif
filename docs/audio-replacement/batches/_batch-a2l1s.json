  {
   "id": "a2l1s016",
   "kind": "sentence",
   "text": "الْقَاهِرَةُ مَدِينَةٌ كَبِيرَةٌ وَضَخْمَةٌ."
  },
  {
   "id": "a2l1s017",
   "kind": "sentence",
   "text": "بِهَا مَنَاطِقُ كَثِيرَةٌ مِثْلُ الْمُهَنْدِسِينَ وَشُبْرَا وَمِصْرَ الْجَدِيدَةِ وَالنُّزْهَةِ وَالدُّقِّي وَغَيْرِهَا."
  },
  {
   "id": "a2l1s018",
   "kind": "sentence",
   "text": "الْمَدِينَةُ بِهَا نَهْرٌ طَوِيلٌ اسْمُهُ نَهْرُ النِّيلِ."
  },
  {
   "id": "a2l1s019",
   "kind": "sentence",
   "text": "الْقَاهِرَةُ فِيهَا آثَارٌ فِرْعَوْنِيَّةٌ مِثْلُ الْأَهْرَامِ وَأَبِي الْهَوْلِ فِي مِنْطَقَةِ الْجِيزَةِ وَالْمَتْحَفِ الْمِصْرِيِّ فِي مَيْدَانِ التَّحْرِيرِ."
  },
  {
   "id": "a2l1s020",
   "kind": "sentence",
   "text": "الْقَاهِرَةُ بِهَا آثَارٌ إِسْلَامِيَّةٌ رَائِعَةٌ فِي مِنْطَقَةِ الْأَزْهَرِ وَخَانِ الْخَلِيلِيِّ."
  },
  {
   "id": "a2l1s021",
   "kind": "sentence",
   "text": "مِنْطَقَةُ مِصْرَ الْقَدِيمَةِ بِهَا آثَارٌ قِبْطِيَّةٌ مِثْلُ الْكَنِيسَةِ الْمُعَلَّقَةِ وَالْمَتْحَفِ الْقِبْطِيِّ."
  },
  {
   "id": "a2l1s022",
   "kind": "sentence",
   "text": "الْجَوُّ مُعْتَدِلٌ فِي الْخَرِيفِ."
  },
  {
   "id": "a2l1s023",
   "kind": "sentence",
   "text": "أَنَا سَعِيدٌ بِدِرَاسَةِ اللُّغَةِ الْعَرَبِيَّةِ هُنَا."
  },
  {
   "id": "a2l1s024",
   "kind": "sentence",
   "text": "الْمِصْرِيُّونَ يُحِبُّونَ الضُّيُوفَ وَالسُّيَّاحَ. ابْنُكُمْ مَارِك."
  },
  {
   "id": "a2l1s025",
   "kind": "sentence",
   "text": "مَا اسْمُ صَاحِبِ الشَّقَّةِ؟"
