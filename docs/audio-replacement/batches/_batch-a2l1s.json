 "items": [
  {
   "id": "a2l1s001",
   "kind": "sentence",
   "text": "أَنَا اسْمِي عَلَاء."
  },
  {
   "id": "a2l1s002",
   "kind": "sentence",
   "text": "أَنَا أُرْدُنِّيٌّ وَأَنَا أَسْكُنُ فِي الْقَاهِرَةِ الْآنَ."
  },
  {
   "id": "a2l1s003",
   "kind": "sentence",
   "text": "أَنَا أَدْرُسُ الطِّبَّ فِي جَامِعَةِ الْقَاهِرَةِ."
  },
  {
   "id": "a2l1s004",
   "kind": "sentence",
   "text": "هَذِهِ شَقَّتِي فِي مِنْطَقَةِ الْمُهَنْدِسِينَ."
  },
  {
   "id": "a2l1s005",
   "kind": "sentence",
   "text": "الشَّقَّةُ بِهَا ثَلَاثُ حُجُرَاتٍ وَهِيَ وَاسِعَةٌ، نَظِيفَةٌ وَمُضِيئَةٌ."
  },
  {
   "id": "a2l1s006",
   "kind": "sentence",
   "text": "حُجْرَةُ النَّوْمِ فِيهَا مَكْتَبٌ كَبِيرٌ وَدُولَابَانِ طَوِيلَانِ وَسَرِيرٌ عَرِيضٌ."
  },
  {
   "id": "a2l1s007",
   "kind": "sentence",
   "text": "بِجَانِبِ السَّرِيرِ طَاوِلَتَانِ صَغِيرَتَانِ."
  },
  {
   "id": "a2l1s008",
   "kind": "sentence",
   "text": "حُجْرَةُ النَّوْمِ لَيْسَ فِيهَا حَمَّامٌ."
  },
  {
   "id": "a2l1s009",
   "kind": "sentence",
   "text": "الْحَمَّامُ خَارِجَ الْغُرْفَةِ وَفِيهِ سَخَّانٌ كَبِيرٌ."
  },
  {
   "id": "a2l1s010",
   "kind": "sentence",
   "text": "الْمَطْبَخُ فِيهِ دُولَابٌ بِهِ أَدَوَاتُ مَطْبَخٍ كَثِيرَةٌ."
  },
  {
   "id": "a2l1s011",
   "kind": "sentence",
   "text": "الْمَطْبَخُ بِهِ ثَلَّاجَةٌ جَدِيدَةٌ أَيْضًا."
  },
  {
   "id": "a2l1s012",
   "kind": "sentence",
   "text": "حُجْرَةُ الْمَعِيشَةِ ضَيِّقَةٌ وَلَيْسَ فِيهَا نَافِذَةٌ كَبِيرَةٌ، لَكِنَّهَا حُجْرَةٌ مُرِيحَةٌ وَفِيهَا كَنَبَتَانِ كَبِيرَتَانِ."
  },
  {
   "id": "a2l1s013",
   "kind": "sentence",
   "text": "سَيِّئٌ - قَبِيحٌ"
  },
  {
   "id": "a2l1s014",
   "kind": "sentence",
   "text": "أُسْرَتِي الْعَزِيزَةُ، بَعْدَ التَّحِيَّةِ،"
  },
  {
   "id": "a2l1s015",
   "kind": "sentence",
   "text": "أَنَا فِي مِصْرَ الْآنَ."
