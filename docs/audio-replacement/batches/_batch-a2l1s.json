   "text": "حَدِيقَةُ الْمَنْزِلِ وَاسِعَةٌ."
  },
  {
   "id": "a2l1s095",
   "kind": "sentence",
   "text": "الْمَكْتَبَةُ بِهَا كُتُبٌ غَالِيَةٌ وَقَدِيمَةٌ."
  },
  {
   "id": "a2l1s096",
   "kind": "sentence",
   "text": "هَذَانِ الرَّجُلَانِ طَوِيلَانِ."
  },
  {
   "id": "a2l1s097",
   "kind": "sentence",
   "text": "حُجْرَتِي بِهَا نَافِذَتَانِ مُضِيئَتَانِ."
  },
  {
   "id": "a2l1s098",
   "kind": "sentence",
   "text": "مَحْمُودٌ لَيْسَ كَسْلَانَ."
  },
  {
   "id": "a2l1s099",
   "kind": "sentence",
   "text": "أُسْرَتِي لَيْسَتْ كَبِيرَةً."
  },
  {
   "id": "a2l1s100",
   "kind": "sentence",
   "text": "حَدِيقَةُ الْمَنْزِلِ بِهَا أَشْجَارٌ عَالِيَةٌ."
  },
  {
   "id": "a2l1s101",
   "kind": "sentence",
   "text": "لَيْلَى لَيْسَتْ طَوِيلَةً."
  },
  {
   "id": "a2l1s102",
   "kind": "sentence",
   "text": "الشَّارِعَانِ فِيهِمَا سَيَّارَاتٌ كَثِيرَةٌ."
  },
  {
   "id": "a2l1s103",
   "kind": "sentence",
   "text": "أَمْرِيكَا بَلَدٌ غَنِيٌّ لَكِنَّ الصُّومَالَ بَلَدٌ فَقِيرٌ."
  },
  {
   "id": "a2l1s104",
   "kind": "sentence",
   "text": "هُوَيْدَا صَدِيقَتِي مِنْ سُورِيَا، هِيَ سُورِيَّةٌ."
  },
  {
   "id": "a2l1s105",
   "kind": "sentence",
   "text": "نِيُويُورْك مَدِينَةٌ كَبِيرَةٌ."
  },
  {
   "id": "a2l1s106",
   "kind": "sentence",
   "text": "عَبْدُ اللَّهِ وَأَحْمَدُ أُسْتَاذَانِ فِي اللُّغَةِ مُجْتَهِدَانِ فِي جَامِعَةِ تُونُسَ."
  },
  {
   "id": "a2l1s107",
   "kind": "sentence",
   "text": "فِي النُّرْوِيجِ الطَّقْسُ فِي الشِّتَاءِ طَقْسٌ بَارِدٌ جِدًّا."
  },
  {
   "id": "a2l1s108",
   "kind": "sentence",
   "text": "الدُّكْتُورُ أَحْمَد زُوَيْل عَالِمٌ مِصْرِيٌّ مُتَخَصِّصٌ فِي عُلُومِ اللِّيزَر."
  },
  {
   "id": "a2l1s109",
   "kind": "sentence",
   "text": "الْأَهْرَامَاتُ آثَارٌ قَدِيمَةٌ وَقَدِيمَةٌ جِدًّا."
  },
  {
   "id": "a2l1s110",
   "kind": "sentence",
   "text": "أَيْنَ مَارِك الْآنَ؟"
  },
  {
   "id": "a2l1s111",
   "kind": "sentence",
   "text": "الْقَاهِرَةُ بِهَا آثَارٌ فِرْعَوْنِيَّةٌ وَفِرْعَوْنِيَّةٌ وَفِرْعَوْنِيَّةٌ."
  },
  {
   "id": "a2l1s112",
