{
 "batch": "batch-l2s-06",
 "items": [
  {
   "id": "s0280",
   "kind": "sentence",
   "text": "لَا، هَذَا كُمْبِيُوتَرٌ."
  },
  {
   "id": "s0281",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ هَذَا الْكُمْبِيُوتَرُ؟"
  },
  {
   "id": "s0282",
   "kind": "sentence",
   "text": "مِنْ إِيرَان، هَذَا كُمْبِيُوتَر إِيرَانِيّ."
  },
  {
   "id": "s0283",
   "kind": "sentence",
   "text": "هَلْ هَذَا خَاتَمٌ؟"
  },
  {
   "id": "s0284",
   "kind": "sentence",
   "text": "نَعَمْ، هَذَا خَاتَمٌ."
  },
  {
   "id": "s0285",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ هَذَا الْخَاتَمُ؟"
  },
  {
   "id": "s0286",
   "kind": "sentence",
   "text": "مِنْ إِيرَان، هَذَا خَاتَم إِيرَانِيّ."
  },
  {
   "id": "s0287",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ هَذَا التِّلِيفُون؟"
  },
  {
   "id": "s0288",
   "kind": "sentence",
   "text": "هَذَا التِّلِيفُون مِنْ إِيرَان، هَذَا تِلِيفُون إِيرَانِيّ."
  },
  {
   "id": "s0289",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ هَذَا التِّلِفِزْيُون؟"
  },
  {
   "id": "s0290",
   "kind": "sentence",
   "text": "هَذَا التِّلِفِزْيُون مِنْ إِيرَان، هَذَا تِلِفِزْيُون إِيرَانِيّ."
  },
  {
   "id": "s0291",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ هَذَا الدُّولَاب؟"
  },
  {
   "id": "s0292",
   "kind": "sentence",
   "text": "هَذَا الدُّولَاب مِنْ إِيرَان، هَذَا دُولَاب إِيرَانِيّ."
  },
  {
   "id": "s0293",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ هَذِهِ اللُّعْبَة؟"
  },
  {
   "id": "s0294",
   "kind": "sentence",
   "text": "هَذِهِ اللُّعْبَة مِنْ إِيرَان، هَذِهِ لُعْبَة إِيرَانِيَّة."
  },
  {
   "id": "s0295",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ هَذِهِ الصُّورَة؟"
  },
  {
   "id": "s0296",
   "kind": "sentence",
   "text": "هَذِهِ الصُّورَة مِنْ إِيرَان، هَذِهِ صُورَة إِيرَانِيَّة."
  },
  {
   "id": "s0297",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ هَذَا الْمِفْتَاح؟"
  },
  {
   "id": "s0298",
   "kind": "sentence",
   "text": "هَذَا الْمِفْتَاح مِنْ إِيرَان، هَذَا مِفْتَاح إِيرَانِيّ."
  },
  {
   "id": "s0299",
   "kind": "sentence",
   "text": "أَمْجَد – إِيمَان – أُسَامَة"
  },
  {
   "id": "s0300",
   "kind": "sentence",
   "text": "سَأَلَ – بِئْر – فُؤَاد"
  },
  {
   "id": "s0301",
   "kind": "sentence",
   "text": "مَا هَذَا؟"
  },
  {
   "id": "s0302",
   "kind": "sentence",
   "text": "مَا هَذِهِ؟"
  },
  {
   "id": "s0304",
   "kind": "sentence",
   "text": "نَعَمْ، هَذَا كِتَابٌ (إِيجَاب)."
  },
  {
   "id": "s0305",
   "kind": "sentence",
   "text": "هَذَا كِتَابُهُ."
  },
  {
   "id": "s0306",
   "kind": "sentence",
   "text": "هَذَا كِتَابُهَا."
  },
  {
   "id": "s0307",
   "kind": "sentence",
   "text": "هَذَا كِتَابُهُمَا."
  },
  {
   "id": "s0308",
   "kind": "sentence",
   "text": "هَذَا كِتَابُهُمْ."
  },
  {
   "id": "s0309",
   "kind": "sentence",
   "text": "هَذَا كِتَابُهُنَّ."
  },
  {
   "id": "s0310",
   "kind": "sentence",
   "text": "هَذَا كِتَابِي."
  },
  {
   "id": "s0311",
   "kind": "sentence",
   "text": "هَذَا كِتَابُنَا."
  },
  {
   "id": "s0312",
   "kind": "sentence",
   "text": "هَذِهِ حَقِيبَتُهُ."
  },
  {
   "id": "s0313",
   "kind": "sentence",
   "text": "هَذِهِ حَقِيبَتُهَا."
  },
  {
   "id": "s0314",
   "kind": "sentence",
   "text": "هَذِهِ حَقِيبَتُهُمَا."
  },
  {
   "id": "s0315",
   "kind": "sentence",
   "text": "هَذِهِ حَقِيبَتُهُمْ."
  },
  {
   "id": "s0316",
   "kind": "sentence",
   "text": "هَذِهِ حَقِيبَتُهُنَّ."
  },
  {
   "id": "s0317",
   "kind": "sentence",
   "text": "هَذِهِ حَقِيبَتِي."
  },
  {
   "id": "s0318",
   "kind": "sentence",
   "text": "هَذِهِ حَقِيبَتُنَا."
  },
  {
   "id": "s0319",
   "kind": "sentence",
   "text": "أَنَا اسْمِي خَالِد."
  },
  {
   "id": "s0320",
   "kind": "sentence",
   "text": "صَدِيقِي اسْمُهُ زَيْد، زَيْد مِنَ الْكُوَيْتِ."
  },
  {
   "id": "s0321",
   "kind": "sentence",
   "text": "هُوَ كُوَيْتِيّ."
  },
  {
   "id": "s0322",
   "kind": "sentence",
   "text": "نَحْنُ فِي بَيْتِ صَدِيقِي زَيْد."
  },
  {
   "id": "s0324",
   "kind": "sentence",
   "text": "هُوَ زَمِيلِي فِي جَامِعَةِ الْقَاهِرَةِ."
  },
  {
   "id": "s0325",
   "kind": "sentence",
   "text": "هُوَ صَدِيقُ عَلَاء وَطَلَال وَشَيْمَاء وَسَمَر."
  },
  {
   "id": "s0326",
   "kind": "sentence",
   "text": "هُوَ زَمِيلُهُمْ أَيْضًا."
  },
  {
   "id": "s0327",
   "kind": "sentence",
   "text": "مِفْتَاحُ مَنْ هَذَا؟"
  },
  {
   "id": "s0328",
   "kind": "sentence",
   "text": "هَذَا مِفْتَاحُ مَاجِدَة."
  },
  {
   "id": "s0329",
   "kind": "sentence",
   "text": "هَذَا مِفْتَاحُهَا."
  },
  {
   "id": "s0330",
   "kind": "sentence",
   "text": "كِتَابُ مَنْ هَذَا؟"
  },
  {
   "id": "s0331",
   "kind": "sentence",
   "text": "هَذَا كِتَابُ وَائِل."
  }
 ]
