{
 "batch": "batch-l2s-22",
 "items": [
  {
   "id": "s1206",
   "kind": "sentence",
   "text": "أَنْتِ تَقْرَئِينَ كِتَابًا."
  },
  {
   "id": "s1207",
   "kind": "sentence",
   "text": "أَنَا أَقْرَأُ كِتَابًا."
  },
  {
   "id": "s1208",
   "kind": "sentence",
   "text": "هُوَ يَقْرَأُ كِتَابًا."
  },
  {
   "id": "s1209",
   "kind": "sentence",
   "text": "هِيَ تَقْرَأُ كِتَابًا."
  },
  {
   "id": "s1210",
   "kind": "sentence",
   "text": "هِيَ تَشْرَبُ قَهْوَةً."
  },
  {
   "id": "s1211",
   "kind": "sentence",
   "text": "أَنْتِ تَشْرَبِينَ شَايًا."
  },
  {
   "id": "s1212",
   "kind": "sentence",
   "text": "أَنَا أَشْرَبُ لَبَنًا."
  },
  {
   "id": "s1213",
   "kind": "sentence",
   "text": "أَنْتَ تَشْرَبُ عَصِيرًا."
  },
  {
   "id": "s1214",
   "kind": "sentence",
   "text": "هُوَ يَشْرَبُ كُوكَاكُولَا."
  },
  {
   "id": "s1215",
   "kind": "sentence",
   "text": "أَنَا أُفْطِرُ صَبَاحًا."
  },
  {
   "id": "s1216",
   "kind": "sentence",
   "text": "هِيَ تُفْطِرُ صَبَاحًا."
  },
  {
   "id": "s1217",
   "kind": "sentence",
   "text": "أَنْتِ تُفْطِرِينَ صَبَاحًا."
  },
  {
   "id": "s1218",
   "kind": "sentence",
   "text": "هُوَ يُفْطِرُ صَبَاحًا."
  },
  {
   "id": "s1219",
   "kind": "sentence",
   "text": "أَنْتَ تُفْطِرُ صَبَاحًا."
  },
  {
   "id": "s1221",
   "kind": "sentence",
   "text": "صَفَاء مُدَرِّسَةٌ فِي مَدْرَسَةِ الشُّرُوقِ."
  },
  {
   "id": "s1222",
   "kind": "sentence",
   "text": "صَفَاء تَسْتَيْقِظُ السَّاعَةَ الْخَامِسَةَ صَبَاحًا."
  },
  {
   "id": "s1223",
   "kind": "sentence",
   "text": "صَفَاء تَعْمَلُ خَمْسَةَ أَيَّامٍ فِي الْأُسْبُوعِ."
  },
  {
   "id": "s1224",
   "kind": "sentence",
   "text": "هِيَ تَذْهَبُ إِلَى الْعَمَلِ السَّاعَةَ السَّابِعَةَ وَالنِّصْفَ صَبَاحًا."
  },
  {
   "id": "s1225",
   "kind": "sentence",
   "text": "هِيَ تَتَعَشَّى السَّاعَةَ الثَّامِنَةَ وَالرُّبْعَ."
  },
  {
   "id": "s1226",
   "kind": "sentence",
   "text": "صَفَاء تَنَامُ السَّاعَةَ الْعَاشِرَةَ مَسَاءً."
  },
  {
   "id": "s1228",
   "kind": "sentence",
   "text": "الْعُطْلَةُ الْأُسْبُوعِيَّةُ يَوْمَيِ الْجُمْعَةِ وَالسَّبْتِ."
  },
  {
   "id": "s1229",
   "kind": "sentence",
   "text": "هِيَ تَسْتَيْقِظُ السَّاعَةَ السَّادِسَةَ صَبَاحًا وَتُفْطِرُ ثُمَّ تَرْكَبُ السَّيَّارَةَ إِلَى الْعَمَلِ السَّاعَةَ ٧,٣٠."
  },
  {
   "id": "s1230",
   "kind": "sentence",
   "text": "وَصَفَاء تَتَغَدَّى فِي الْمَدْرَسَةِ السَّاعَةَ ١٢ ظُهْرًا."
  },
  {
   "id": "s1232",
   "kind": "sentence",
   "text": "هِيَ تَنَامُ السَّاعَةَ الْعَاشِرَةَ مَسَاءً."
  },
  {
   "id": "s1233",
   "kind": "sentence",
   "text": "أَحْمَد يَعْمَلُ حَتَّى السَّاعَةِ الْخَامِسَةِ مَسَاءً."
  },
  {
   "id": "s1234",
   "kind": "sentence",
   "text": "نِهَاد تَلْبَسُ ثَوْبًا جَمِيلًا الْآنَ."
  },
  {
   "id": "s1235",
   "kind": "sentence",
   "text": "أَنَا أَرْكَبُ سَيَّارَةً حَمْرَاءَ."
  },
  {
   "id": "s1237",
   "kind": "sentence",
   "text": "سَعِيد يَلْبَسُ حِذَاءً أَسْوَدَ."
  },
  {
   "id": "s1238",
   "kind": "sentence",
   "text": "أَنَا أَذْهَبُ إِلَى الْعَمَلِ السَّاعَةَ الثَّامِنَةَ صَبَاحًا."
  },
  {
   "id": "s1239",
   "kind": "sentence",
   "text": "مَتَى تَذْهَبِينَ لِلْعَمَلِ كُلَّ يَوْمٍ يَا عَالِيَة؟"
  },
  {
   "id": "s1240",
   "kind": "sentence",
   "text": "هَلْ تُشَاهِدِينَ التِّلِيفِزْيُونَ كُلَّ يَوْمٍ يَا مَاجِدَة؟"
  },
  {
   "id": "s1241",
   "kind": "sentence",
   "text": "سَمِير يَتَغَدَّى السَّاعَةَ ٣ ظُهْرًا."
  },
  {
   "id": "s1242",
   "kind": "sentence",
   "text": "هَلْ تَقْرَأُ الْجَرِيدَةَ الْآنَ يَا مُصْطَفَى؟"
  },
  {
   "id": "s1243",
   "kind": "sentence",
   "text": "مَجْدِي يَأْخُذُ حَمَّامًا الْآنَ."
  },
  {
   "id": "s1244",
   "kind": "sentence",
   "text": "سَمِيرَة تَطْبُخُ الْآنَ."
  },
  {
   "id": "s1245",
   "kind": "sentence",
   "text": "عُدَيّ يَنَامُ الْآنَ."
  },
  {
   "id": "s1246",
   "kind": "sentence",
   "text": "زِيَاد يُفْطِرُ الْآنَ."
  },
  {
   "id": "s1247",
   "kind": "sentence",
   "text": "هَانِي يُشَاهِدُ التِّلِيفِزْيُونَ الْآنَ."
  },
  {
   "id": "s1248",
   "kind": "sentence",
   "text": "مَاجِدَة تَلْبَسُ مَلَابِسَهَا الْآنَ."
  },
  {
   "id": "s1249",
   "kind": "sentence",
   "text": "مُصْطَفَى يُذَاكِرُ الْآنَ."
  },
  {
   "id": "s1250",
   "kind": "sentence",
   "text": "جِهَاد يَرْكَبُ السَّيَّارَةَ الْآنَ."
  },
  {
   "id": "s1251",
   "kind": "sentence",
   "text": "(أ) أَنَا اسْمِي نَدَى."
  },
  {
   "id": "s1252",
   "kind": "sentence",
   "text": "(ب) أَنَا اسْمِي رَاجِيَة."
  },
  {
   "id": "s1253",
   "kind": "sentence",
   "text": "(ج) أَنَا اسْمِي مُصْطَفَى."
  },
  {
   "id": "s1261",
   "kind": "sentence",
   "text": "جَارَتِي السَّيِّدَةُ أَسْمَاءُ سَيِّدَةٌ نَشِيطَةٌ طُوَالَ الْأُسْبُوعِ وَلَكِنْ هِيَ كَسْلَانَةٌ جِدًّا فِي إِجَازَتِهَا الْأُسْبُوعِيَّةِ."
  },
  {
   "id": "s1262",
   "kind": "sentence",
   "text": "هِيَ لَا تَسْتَيْقِظُ مُبَكِّرًا فِي الْإِجَازَةِ وَلَكِنْ تَنَامُ حَتَّى السَّاعَةِ الْحَادِيَةَ عَشْرَةَ."
  },
  {
   "id": "s1263",
   "kind": "sentence",
   "text": "هِيَ لَا تُفْطِرُ فِي الصَّبَاحِ، وَلَكِنْ تَشْرَبُ الْقَهْوَةَ فَقَطْ."
  },
  {
   "id": "s1265",
   "kind": "sentence",
   "text": "هِيَ تَجْلِسُ فِي حُجْرَةِ الْمَعِيشَةِ وَتُشَاهِدُ التِّلِيفِزْيُونَ (التِّلْفَازَ) طُولَ الْوَقْتِ."
  },
  {
   "id": "s1266",
   "kind": "sentence",
   "text": "وَهِيَ لَا تُقَابِلُ صَدِيقَاتِهَا وَلَكِنْ تَتَغَدَّى مَعَ زَوْجِهَا وَأَوْلَادِهَا فِي الْمَطْعَمِ."
  },
  {
   "id": "s1267",
   "kind": "sentence",
   "text": "هَلْ حُسَيْن يُنَظِّفُ الْبَيْتَ يَوْمَ الْجُمْعَةِ؟"
  }
 ]
}
