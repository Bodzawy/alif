  },
  {
   "id": "s1167",
   "kind": "sentence",
   "text": "أَنَا اسْمِي نَدَى."
  },
  {
   "id": "s1168",
   "kind": "sentence",
   "text": "أَنَا أَعْمَلُ سِكْرِتِيرَةً."
  },
  {
   "id": "s1169",
   "kind": "sentence",
   "text": "أَتَغَدَّى السَّاعَةَ الْوَاحِدَةَ."
  },
  {
   "id": "s1170",
   "kind": "sentence",
   "text": "وَأَشْرَبُ الْقَهْوَةَ فِي الِاسْتِرَاحَةِ."
  },
  {
   "id": "s1171",
   "kind": "sentence",
   "text": "أَرْجِعُ إِلَى الْبَيْتِ السَّاعَةَ السَّادِسَةَ مَسَاءً."
  },
  {
   "id": "s1172",
   "kind": "sentence",
   "text": "أُشَاهِدُ فِيلْمًا جَمِيلًا بَعْدَ الْعَشَاءِ."
  },
  {
   "id": "s1173",
   "kind": "sentence",
   "text": "أَنَا اسْمِي رَاجِيَة."
  },
  {
   "id": "s1174",
   "kind": "sentence",
   "text": "أَنَا أَعْمَلُ طَبِيبَةً فِي مُسْتَشْفَى الْهِلَالِ."
  },
  {
   "id": "s1175",
   "kind": "sentence",
   "text": "أَذْهَبُ إِلَى الْعَمَلِ السَّاعَةَ التَّاسِعَةَ وَأَرْجِعُ إِلَى الْبَيْتِ السَّاعَةَ الرَّابِعَةَ."
  },
  {
   "id": "s1176",
   "kind": "sentence",
   "text": "أَتَغَدَّى ثُمَّ أُشَاهِدُ التِّلِيفِزْيُونَ وَأَقْرَأُ الْأَخْبَارَ فِي الْجَرِيدَةِ، ثُمَّ أَنَامُ السَّاعَةَ الْعَاشِرَةَ مَسَاءً."
  },
  {
   "id": "s1177",
   "kind": "sentence",
   "text": "أَنَا اسْمِي مُصْطَفَى."
  },
  {
   "id": "s1178",
   "kind": "sentence",
   "text": "أَنَا أَعْمَلُ مُدَرِّسًا."
  },
  {
   "id": "s1179",
   "kind": "sentence",
   "text": "أَسْتَيْقِظُ السَّاعَةَ السَّابِعَةَ وَأُفْطِرُ السَّاعَةَ السَّابِعَةِ وَالنِّصْفِ وَأَشْرَبُ الْقَهْوَةَ السَّاعَةَ الثَّانِيَةَ عَشْرَةَ."
  },
  {
   "id": "s1180",
   "kind": "sentence",
   "text": "وَأَتَغَدَّى فِي الْمَدْرَسَةِ السَّاعَةَ الْوَاحِدَةَ."
  },
  {
   "id": "s1181",
   "kind": "sentence",
   "text": "ثُمَّ أَرْجِعُ إِلَى الْبَيْتِ السَّاعَةَ الثَّالِثَةَ، ثُمَّ أَذْهَبُ إِلَى النَّادِي وَأَلْعَبُ التِّنِسَ حَتَّى السَّاعَةِ الْخَامِسَةِ."
  },
  {
   "id": "s1182",
   "kind": "sentence",
   "text": "أَنْتَ تَغْسِلُ."
  },
