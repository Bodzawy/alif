{
 "batch": "batch-l2s-25",
 "items": [
  {
   "id": "s1435",
   "kind": "sentence",
   "text": "مَنْ إِبْرَاهِيم؟"
  },
  {
   "id": "s1436",
   "kind": "sentence",
   "text": "مَا وَظِيفَةُ إِبْرَاهِيم؟"
  },
  {
   "id": "s1437",
   "kind": "sentence",
   "text": "مَنْ يَزُورُ إِبْرَاهِيم؟"
  },
  {
   "id": "s1438",
   "kind": "sentence",
   "text": "بَارِد جِدًّا"
  },
  {
   "id": "s1439",
   "kind": "sentence",
   "text": "كَمْ دَرَجَةُ الْحَرَارَةِ الْيَوْمَ؟"
  },
  {
   "id": "s1440",
   "kind": "sentence",
   "text": "دَرَجَةُ الْحَرَارَةِ ثَلَاثُونَ دَرَجَةً مِئَوِيَّةً."
  },
  {
   "id": "s1441",
   "kind": "sentence",
   "text": "أَرْبَعَةٌ تَحْتَ الصِّفْرِ"
  },
  {
   "id": "s1442",
   "kind": "sentence",
   "text": "الصَّيْف: الْجَوُّ حَارٌّ – مُمْطِرٌ – مُشْمِسٌ"
  },
  {
   "id": "s1443",
   "kind": "sentence",
   "text": "الْخَرِيف: الْجَوُّ مُعْتَدِلٌ – مُشْمِسٌ – دَافِئٌ"
  },
  {
   "id": "s1444",
   "kind": "sentence",
   "text": "الشِّتَاء: الْجَوُّ بَارِدٌ – مُمْطِرٌ – غَائِمٌ"
  },
  {
   "id": "s1445",
   "kind": "sentence",
   "text": "الرَّبِيع: الْجَوُّ مُعْتَدِلٌ – مُتْرِبٌ – عَاصِفٌ"
  },
  {
   "id": "s1446",
   "kind": "sentence",
   "text": "عَزِيزَتِي أَلِيس، أَنَا سَعِيدَةٌ بِزِيَارَتِكِ لِي فِي الشِّتَاءِ."
  },
  {
   "id": "s1450",
   "kind": "sentence",
   "text": "كَيْفَ حَالَةُ الطَّقْسِ الْيَوْمَ؟"
  },
  {
   "id": "s1451",
   "kind": "sentence",
   "text": "الطَّقْسُ الْيَوْمَ مُمْطِرٌ / بَارِدٌ / حَارٌّ."
  },
  {
   "id": "s1452",
   "kind": "sentence",
   "text": "مَا حَالَةُ الطَّقْسِ الْيَوْمَ؟"
  },
  {
   "id": "s1453",
   "kind": "sentence",
   "text": "يُونْيُو يُولْيُو أُغُسْطُس"
  },
  {
   "id": "s1454",
   "kind": "sentence",
   "text": "سِبْتَمْبِر أُكْتُوبَر نُوفَمْبِر"
  },
  {
   "id": "s1455",
   "kind": "sentence",
   "text": "دِيسَمْبِر يَنَايِر فِبْرَايِر"
  },
  {
   "id": "s1456",
   "kind": "sentence",
   "text": "مَارِس أَبْرِيل مَايُو"
  },
  {
   "id": "s1457",
   "kind": "sentence",
   "text": "الطَّقْسُ الْيَوْمَ مُتْرِب."
  },
  {
   "id": "s1458",
   "kind": "sentence",
   "text": "وَ… الطَّقْسُ حَارّ."
  },
  {
   "id": "s1459",
   "kind": "sentence",
   "text": "الطَّقْسُ الْيَوْمَ غَائِم."
  },
  {
   "id": "s1460",
   "kind": "sentence",
   "text": "وَ… الطَّقْسُ مُمْطِر."
  },
  {
   "id": "s1461",
   "kind": "sentence",
   "text": "الطَّقْسُ الْيَوْمَ عَاصِف."
  },
  {
   "id": "s1462",
   "kind": "sentence",
   "text": "وَ… الطَّقْسُ بَارِد."
  },
  {
   "id": "s1463",
   "kind": "sentence",
   "text": "الطَّقْسُ الْيَوْمَ مُعْتَدِل."
  },
  {
   "id": "s1468",
   "kind": "sentence",
   "text": "دَرَجَةُ الْحَرَارَةِ ثَلَاثُونَ إِلَى أَرْبَعُونَ."
  },
  {
   "id": "s1469",
   "kind": "sentence",
   "text": "دَرَجَةُ الْحَرَارَةِ اثْنَتَا عَشْرَةَ تَحْتَ الصِّفْرِ إِلَى خَمْسٌ."
  },
  {
   "id": "s1470",
   "kind": "sentence",
   "text": "دَرَجَةُ الْحَرَارَةِ عِشْرُونَ إِلَى ثَلَاثُونَ."
  },
  {
   "id": "s1471",
   "kind": "sentence",
   "text": "دَرَجَةُ الْحَرَارَةِ ثَمَانٍ إِلَى خَمْسَ عَشْرَةَ."
  },
  {
   "id": "s1473",
   "kind": "sentence",
   "text": "مَدِينَةُ دُبَي: الْجَوُّ مُشْمِسٌ وَحَارٌّ وَدَرَجَةُ الْحَرَارَةِ ثَمَانٍ وَثَلَاثُونَ دَرَجَةً مِئَوِيَّةً."
  },
  {
   "id": "s1477",
   "kind": "sentence",
   "text": "إِلَى أَيْنَ يُسَافِرُ عِمَاد؟"
  },
  {
   "id": "s1478",
   "kind": "sentence",
   "text": "فِي أَيِّ فَصْلٍ يُسَافِرُ؟"
  },
  {
   "id": "s1479",
   "kind": "sentence",
   "text": "مَا حَالَةُ الطَّقْسِ فِي هَذَا الْفَصْلِ؟"
  },
  {
   "id": "s1480",
   "kind": "sentence",
   "text": "مَاذَا يَلْبَسُ عِمَاد؟"
  },
  {
   "id": "s1481",
   "kind": "sentence",
   "text": "صُورَةٌ: الرَّبِيع"
  },
  {
   "id": "s1482",
   "kind": "sentence",
   "text": "صُورَةٌ: الصَّيْف"
  },
  {
   "id": "s1483",
   "kind": "sentence",
   "text": "صُورَةٌ: الشِّتَاء"
  },
  {
   "id": "s1484",
   "kind": "sentence",
   "text": "صُورَةٌ: الْخَرِيف"
  },
  {
   "id": "s1485",
   "kind": "sentence",
   "text": "وَالِدِي – وَالِدُكَ – وَالِدُهُ – وَالِدُهَا – وَالِدُهُمَا – وَالِدُهُمْ – وَالِدُنَا"
  },
  {
   "id": "s1486",
   "kind": "sentence",
   "text": "وَالِدَتِي – وَالِدَتُكَ – وَالِدَتُهُ – وَالِدَتُهَا – وَالِدَتُهُمْ – وَالِدَتُنَا"
  },
  {
   "id": "s1487",
   "kind": "sentence",
   "text": "لَا، هُوَ لَيْسَ وَالِدِي، هُوَ وَالِدُ خَالِد."
  },
  {
   "id": "s1488",
   "kind": "sentence",
   "text": "نَعَمْ، هُوَ وَالِدِي / أَبِي."
  },
  {
   "id": "s1489",
   "kind": "sentence",
   "text": "زَوْجِي – زَوْجُكِ – زَوْجُهَا"
  },
  {
   "id": "s1490",
   "kind": "sentence",
   "text": "زَوْجَتِي – زَوْجَتُكَ – زَوْجَتُهُ"
  },
  {
   "id": "s1491",
   "kind": "sentence",
   "text": "هَلْ تَعْمَلُ؟"
  },
  {
   "id": "s1492",
   "kind": "sentence",
   "text": "مَا عَمَلُكَ؟"
  },
  {
   "id": "s1494",
   "kind": "sentence",
   "text": "هَلْ مُصْطَفَى طَبِيبٌ؟"
  },
  {
   "id": "s1496",
   "kind": "sentence",
   "text": "كَيْفَ حَالُ الطَّقْسِ الْيَوْمَ؟"
  },
  {
   "id": "s1497",
   "kind": "sentence",
   "text": "الطَّقْسُ الْيَوْمَ مُمْطِرٌ – غَائِمٌ – حَارٌّ – بَارِدٌ – مُتْرِبٌ – عَاصِفٌ – دَافِئٌ – مُعْتَدِلٌ"
  }
 ]
}
