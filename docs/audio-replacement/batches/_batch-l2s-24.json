{
 "batch": "batch-l2s-24",
 "items": [
  {
   "id": "s1338",
   "kind": "sentence",
   "text": "جَدِّي صَالِح مُهَنْدِسٌ."
  },
  {
   "id": "s1339",
   "kind": "sentence",
   "text": "أَبِي مَحْمُود ضَابِطٌ."
  },
  {
   "id": "s1340",
   "kind": "sentence",
   "text": "أَخِي طَارِق مُحَاسِبٌ."
  },
  {
   "id": "s1341",
   "kind": "sentence",
   "text": "جَدَّتِي زَيْنَب مُدِيرَةٌ."
  },
  {
   "id": "s1342",
   "kind": "sentence",
   "text": "وَالِدَتِي فَاطِمَة مُدَرِّسَةٌ."
  },
  {
   "id": "s1343",
   "kind": "sentence",
   "text": "أُخْتِي خَدِيجَة مُمَرِّضَةٌ."
  },
  {
   "id": "s1344",
   "kind": "sentence",
   "text": "أَنَا عِصَام مُحَامٍ."
  },
  {
   "id": "s1345",
   "kind": "sentence",
   "text": "عَزِيزِي غَسَّان، بَعْدَ التَّحِيَّةِ، شُكْرًا لَكَ عَلَى رِسَالَتِكَ الْجَمِيلَةِ."
  },
  {
   "id": "s1350",
   "kind": "sentence",
   "text": "أَخُوكَ، نَادِي"
  },
  {
   "id": "s1351",
   "kind": "sentence",
   "text": "صَالِح هُوَ جَدُّ عِصَام وَهُوَ أَبُو مَحْمُود."
  },
  {
   "id": "s1352",
   "kind": "sentence",
   "text": "زَيْنَب هِيَ جَدَّةُ عِصَام وَهِيَ أُمُّ مَحْمُود."
  },
  {
   "id": "s1353",
   "kind": "sentence",
   "text": "مَحْمُود هُوَ أَبُو عِصَام وَهُوَ ابْنُ صَالِح."
  },
  {
   "id": "s1360",
   "kind": "sentence",
   "text": "هَلْ حُسَام وَالِدُكَ؟"
  },
  {
   "id": "s1362",
   "kind": "sentence",
   "text": "هَلْ نَبِيلَة أُخْتُكَ؟"
  },
  {
   "id": "s1364",
   "kind": "sentence",
   "text": "هَلْ فَاطِمَة وَالِدَتُكَ؟"
  },
  {
   "id": "s1366",
   "kind": "sentence",
   "text": "هَلْ أَنْتَ تَعْمَلُ؟"
  },
  {
   "id": "s1368",
   "kind": "sentence",
   "text": "هَلْ أَنْتِ تَعْمَلِينَ؟"
  },
  {
   "id": "s1369",
   "kind": "sentence",
   "text": "هَلْ هُوَ يَعْمَلُ؟"
  },
  {
   "id": "s1371",
   "kind": "sentence",
   "text": "هَلْ هِيَ تَعْمَلُ؟"
  },
  {
   "id": "s1373",
   "kind": "sentence",
   "text": "هَلْ وَالِدُكَ مُهَنْدِسٌ؟"
  },
  {
   "id": "s1374",
   "kind": "sentence",
   "text": "نَعَمْ، وَالِدِي مُهَنْدِسٌ."
  },
  {
   "id": "s1376",
   "kind": "sentence",
   "text": "هَلْ هِيَ طَبِيبَةٌ؟"
  },
  {
   "id": "s1377",
   "kind": "sentence",
   "text": "نَعَمْ، هِيَ طَبِيبَةٌ."
  },
  {
   "id": "s1397",
   "kind": "sentence",
   "text": "مَا عَمَلُ وَالِدِ عَلِيّ؟"
  },
  {
   "id": "s1398",
   "kind": "sentence",
   "text": "وَالِدُ عَلِيّ مُهَنْدِسٌ."
  },
  {
   "id": "s1399",
   "kind": "sentence",
   "text": "مَا عَمَلُ زَوْجَةِ أَحْمَد؟"
  },
  {
   "id": "s1400",
   "kind": "sentence",
   "text": "زَوْجَةُ أَحْمَد مُمَرِّضَةٌ."
  },
  {
   "id": "s1401",
   "kind": "sentence",
   "text": "مَا عَمَلُ أَخِي عِصَام؟"
  },
  {
   "id": "s1402",
   "kind": "sentence",
   "text": "أَخُو عِصَام مُمَثِّلٌ."
  },
  {
   "id": "s1403",
   "kind": "sentence",
   "text": "مَا عَمَلُ زَوْجِ فَاطِمَة؟"
  },
  {
   "id": "s1404",
   "kind": "sentence",
   "text": "زَوْجُ فَاطِمَة مُحَامٍ."
  },
  {
   "id": "s1405",
   "kind": "sentence",
   "text": "مَا عَمَلُ ابْنِ هِشَام؟"
  },
  {
   "id": "s1406",
   "kind": "sentence",
   "text": "ابْنُ هِشَام طَيَّارٌ."
  },
  {
   "id": "s1407",
   "kind": "sentence",
   "text": "مَا عَمَلُ أُخْتِ مَاجِدَة؟"
  },
  {
   "id": "s1408",
   "kind": "sentence",
   "text": "أُخْتُ مَاجِدَة مُدَرِّسَةٌ."
  },
  {
   "id": "s1409",
   "kind": "sentence",
   "text": "هَلْ وَالِدُ نَبِيل طَبِيبٌ؟"
  },
  {
   "id": "s1411",
   "kind": "sentence",
   "text": "هَلْ زَوْجُ فَاطِمَة مُدَرِّسٌ؟"
  },
  {
   "id": "s1413",
   "kind": "sentence",
   "text": "هَلْ جَدُّ حَامِد مُمَثِّلٌ؟"
  },
  {
   "id": "s1415",
   "kind": "sentence",
   "text": "هَلْ خَالِد وَالِدُ عَلَاء؟"
  },
  {
   "id": "s1417",
   "kind": "sentence",
   "text": "هَلْ مُصْطَفَى جَدُّ حُسَام؟"
  },
  {
   "id": "s1419",
   "kind": "sentence",
   "text": "هَلْ مَدِيحَة أُخْتُ وَفَاء؟"
  },
  {
   "id": "s1421",
   "kind": "sentence",
   "text": "هَلْ أَخُو سَيِّد مُدِيرٌ؟"
  },
  {
   "id": "s1423",
   "kind": "sentence",
   "text": "هَلْ جَدَّةُ هَانِي تَعْمَلُ مُدَرِّسَةً؟"
  },
  {
   "id": "s1425",
   "kind": "sentence",
   "text": "هَلْ سَمِيرَة أُمُّ نَجْوَى؟"
  },
  {
   "id": "s1427",
   "kind": "sentence",
   "text": "أَمْ … هُوَ رَجُلٌ طَوِيلٌ وَمَا عَمَلُهُ؟"
  },
  {
   "id": "s1428",
   "kind": "sentence",
   "text": "لَا، هَذَا لَيْسَ أَخِي هَذَا ابْنِي سَمِير."
  },
  {
   "id": "s1429",
   "kind": "sentence",
   "text": "لَا، هُوَ لَا يَعْمَلُ هُوَ طَالِبٌ، يَدْرُسُ فِي الْجَامِعَةِ."
  },
  {
   "id": "s1432",
   "kind": "sentence",
   "text": "أَيْنَ نَادِي الْآنَ؟"
  },
  {
   "id": "s1433",
   "kind": "sentence",
   "text": "مَا وَظِيفَتُهُ؟"
  },
  {
   "id": "s1434",
   "kind": "sentence",
   "text": "مَنْ يَزُورُ نَادِي؟"
  }
 ]
}
