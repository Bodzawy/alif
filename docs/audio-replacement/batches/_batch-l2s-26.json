{
 "batch": "batch-l2s-26",
 "items": [
  {
   "id": "s1498",
   "kind": "sentence",
   "text": "دَرَجَةُ الْحَرَارَةِ عِشْرُونَ – ثَلَاثُونَ – خَمْسَةٌ تَحْتَ الصِّفْرِ"
  },
  {
   "id": "s1499",
   "kind": "sentence",
   "text": "الشِّتَاءُ – الرَّبِيعُ – الصَّيْفُ – الْخَرِيفُ"
  },
  {
   "id": "s1500",
   "kind": "sentence",
   "text": "يَنَايِر – فِبْرَايِر – مَارِس – أَبْرِيل – مَايُو – يُونْيُو – يُولْيُو – أُغُسْطُس – سِبْتَمْبِر – أُكْتُوبَر – نُوفَمْبِر – دِيسَمْبِر"
  },
  {
   "id": "s1501",
   "kind": "sentence",
   "text": "السَّاعَةُ الرَّابِعَةُ وَالنِّصْفُ."
  },
  {
   "id": "s1502",
   "kind": "sentence",
   "text": "السَّاعَةُ السَّابِعَةُ وَخَمْسُ دَقَائِقَ."
  },
  {
   "id": "s1503",
   "kind": "sentence",
   "text": "السَّاعَةُ الثَّالِثَةُ إِلَّا الرُّبْعَ."
  },
  {
   "id": "s1504",
   "kind": "sentence",
   "text": "السَّاعَةُ الْحَادِيَةَ عَشْرَةَ إِلَّا خَمْسَ دَقَائِقَ."
  },
  {
   "id": "s1505",
   "kind": "sentence",
   "text": "السَّاعَةُ الْوَاحِدَةُ وَالنِّصْفُ وَخَمْسُ دَقَائِقَ."
  },
  {
   "id": "s1506",
   "kind": "sentence",
   "text": "السَّاعَةُ التَّاسِعَةُ وَالرُّبْعُ."
  },
  {
   "id": "s1507",
   "kind": "sentence",
   "text": "تَصِلُ رِحْلَةُ رَقْمِ اثْنَيْنِ سِتَّة سَبْعَة مِنَ الْقَاهِرَةِ السَّاعَةَ السَّادِسَةَ صَبَاحًا."
  },
  {
   "id": "s1508",
   "kind": "sentence",
   "text": "رَقْمُ الْبَوَّابَةِ سَبْعَة."
  },
  {
   "id": "s1509",
   "kind": "sentence",
   "text": "تَصِلُ رِحْلَةُ رَقْمِ ثَمَانِيَة اثْنَيْن وَاحِد مِنْ بَرْشَلُونَة السَّاعَةَ السَّابِعَةَ وَالثُّلْثَ مَسَاءً."
  },
  {
   "id": "s1510",
   "kind": "sentence",
   "text": "رَقْمُ الْبَوَّابَةِ اثْنَان."
  },
  {
   "id": "s1511",
   "kind": "sentence",
   "text": "تَصِلُ رِحْلَةُ رَقْمِ أَرْبَعَة اثْنَيْن تِسْعَة مِنْ تُورُنْتُو السَّاعَةَ الثَّامِنَةَ وَالنِّصْفَ مَسَاءً."
  },
  {
   "id": "s1512",
   "kind": "sentence",
   "text": "رَقْمُ الْبَوَّابَةِ عَشَرَة."
  },
  {
   "id": "s1513",
   "kind": "sentence",
   "text": "تَصِلُ رِحْلَةُ رَقْمِ وَاحِد تِسْعَة ثَمَانِيَة مِنْ طُوكْيُو السَّاعَةَ الثَّانِيَةَ عَشْرَةَ وَالثُّلْثَ مَسَاءً."
  },
  {
   "id": "s1514",
   "kind": "sentence",
   "text": "رَقْمُ الْبَوَّابَةِ أَرْبَعَة."
  },
  {
   "id": "s1515",
   "kind": "sentence",
   "text": "تَصِلُ رِحْلَةُ رَقْمِ سِتَّة سَبْعَة اثْنَيْن مِنْ لُوس أَنْجِلُوس السَّاعَةَ الْعَاشِرَةَ وَالثُّلْثَ صَبَاحًا."
  },
  {
   "id": "s1516",
   "kind": "sentence",
   "text": "رَقْمُ الْبَوَّابَةِ سِتَّة."
  },
  {
   "id": "s1517",
   "kind": "sentence",
   "text": "هَلِ الْجَوُّ مُعْتَدِلٌ الْآنَ؟"
  },
  {
   "id": "s1519",
   "kind": "sentence",
   "text": "هَلْ يَتَغَدَّى رَؤُوف الْآنَ؟"
  },
  {
   "id": "s1521",
   "kind": "sentence",
   "text": "هَلْ يَنَامُ عَلِيّ الْآنَ؟"
  },
  {
   "id": "s1523",
   "kind": "sentence",
   "text": "هَلْ يَكْتُبُ مُصْطَفَى الْآنَ؟"
  },
  {
   "id": "s1524",
   "kind": "sentence",
   "text": "نَعَمْ، مُصْطَفَى يَكْتُبُ."
  },
  {
   "id": "s1525",
   "kind": "sentence",
   "text": "هَلْ تَلْبَسُ فَاطِمَة فُسْتَانًا؟"
  },
  {
   "id": "s1527",
   "kind": "sentence",
   "text": "هَلْ تَقْرَأُ سُعَاد الْآنَ؟"
  },
  {
   "id": "s1530",
   "kind": "sentence",
   "text": "عَائِشَة تَذْهَبُ إِلَى الْعَمَلِ، هِيَ تَلْبَسُ تَايِيرًا جَمِيلًا."
  },
  {
   "id": "s1531",
   "kind": "sentence",
   "text": "سَمِير يَذْهَبُ مَعَ زَوْجَتِهِ إِلَى الْحَدِيقَةِ فِي الْإِجَازَةِ الْأُسْبُوعِيَّةِ."
  },
  {
   "id": "s1533",
   "kind": "sentence",
   "text": "الْجَوُّ بَارِدٌ وَثَلْجٌ، دَرَجَةُ الْحَرَارَةِ ثَمَانِي دَرَجَاتٍ."
  },
  {
   "id": "s1534",
   "kind": "sentence",
   "text": "الْجَوُّ مُمْطِر، دَرَجَةُ الْحَرَارَةِ ثَمَانٍ وَعِشْرُونَ دَرَجَةً."
  },
  {
   "id": "s1535",
   "kind": "sentence",
   "text": "الْجَوُّ مُشْمِس، دَرَجَةُ الْحَرَارَةِ عِشْرُونَ دَرَجَةً."
  },
  {
   "id": "s1536",
   "kind": "sentence",
   "text": "الْجَوُّ مُشْمِس، دَرَجَةُ الْحَرَارَةِ تِسْعَ عَشْرَةَ دَرَجَةً."
  },
  {
   "id": "s1537",
   "kind": "sentence",
   "text": "الْجَوُّ غَائِم، دَرَجَةُ الْحَرَارَةِ أَرْبَعٌ وَعِشْرُونَ دَرَجَةً."
  },
  {
   "id": "s1538",
   "kind": "sentence",
   "text": "الْجَوُّ مُشْمِس، دَرَجَةُ الْحَرَارَةِ سِتَّ عَشْرَةَ دَرَجَةً."
  },
  {
   "id": "s1539",
   "kind": "sentence",
   "text": "الْجَوُّ مُشْمِس، دَرَجَةُ الْحَرَارَةِ اثْنَتَانِ وَعِشْرُونَ دَرَجَةً."
  },
  {
   "id": "s1540",
   "kind": "sentence",
   "text": "مَنْ يَلْبَسُ بَنْطَلُونًا طَوِيلًا؟"
  },
  {
   "id": "s1541",
   "kind": "sentence",
   "text": "مَنْ يَلْبَسُ نَظَّارَةً؟"
  },
  {
   "id": "s1542",
   "kind": "sentence",
   "text": "مَنْ تَلْبَسُ جُونِلَّةً؟"
  },
  {
   "id": "s1543",
   "kind": "sentence",
   "text": "مَنْ تَلْبَسُ قُبَّعَةً؟"
  },
  {
   "id": "s1544",
   "kind": "sentence",
   "text": "هَلْ عَلَاء يَشْرَبُ؟"
  },
  {
   "id": "s1546",
   "kind": "sentence",
   "text": "هَلْ شَاكِر يَشْرَبُ؟"
  },
  {
   "id": "s1547",
   "kind": "sentence",
   "text": "نَعَمْ، شَاكِر يَشْرَبُ عَصِيرًا."
  },
  {
   "id": "s1548",
   "kind": "sentence",
   "text": "هَلْ سَلِيم يَقْرَأُ؟"
  },
  {
   "id": "s1550",
   "kind": "sentence",
   "text": "هَلْ تَامِر يَتَكَلَّمُ؟"
  },
  {
   "id": "s1552",
   "kind": "sentence",
   "text": "هَلْ صَفَاء تُشَاهِدُ التِّلِيفِزْيُونَ؟"
  },
  {
   "id": "s1554",
   "kind": "sentence",
   "text": "هَلْ سَلْمَى تَكْتُبُ خِطَابًا؟"
  },
  {
   "id": "s1555",
   "kind": "sentence",
   "text": "لَا، سَلْمَى لَيْسَتْ فِي الصُّورَةِ؛ صَفَاء تَكْتُبُ خِطَابًا."
  },
  {
   "id": "s1556",
   "kind": "sentence",
   "text": "هُوَيْدَا لَا تُشَاهِدُ التِّلِيفِزْيُونَ فِي الْإِجَازَةِ."
  },
  {
   "id": "s1557",
   "kind": "sentence",
   "text": "هُوَيْدَا لَا تَلْعَبُ رِيَاضَةً فِي الْإِجَازَةِ."
  },
  {
   "id": "s1558",
   "kind": "sentence",
   "text": "هُوَيْدَا تَطْبُخُ فِي الْإِجَازَةِ."
  }
 ]
}
