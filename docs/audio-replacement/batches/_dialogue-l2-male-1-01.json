{
 "batch": "_dialogue-l2-male-1-01",
 "voice": "male-1",
 "speakers": [
  "Adnan (adnan-khalid)",
  "Schadi (shadi-wajdi)",
  "Der Fragende (man-anta-a)",
  "Der Fragende (man-anta-b)",
  "Der Antwortende (man-huwa-a)",
  "Der Antwortende (man-hiya-b)",
  "Ahmad (ahmad-abdullah)",
  "Mustafa (mustafa-yamahu)",
  "Der Kunde (shop)",
  "Der Kunde (spelling)",
  "Khalid (khalid-shaimaa)",
  "Der Lehrer (hal-hadhihi-a)",
  "Der Lehrer (hal-hadhihi-b)"
 ],
 "items": [
  {
   "id": "d2-m1-001",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَسَاءُ الْخَيْرِ.",
   "lines": [
    "e-m-masa-al-khayr"
   ]
  },
  {
   "id": "d2-m1-002",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "كَيْفَ حَالُكَ؟",
   "lines": [
    "e-m-kayfa-haluka"
   ]
  },
  {
   "id": "d2-m1-003",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَا اسْمُكَ؟",
   "lines": [
    "e-m-ma-smuka"
   ]
  },
  {
   "id": "d2-m1-004",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "اسْمِي عَدْنَان.",
   "lines": [
    "e-m-ismi-adnan"
   ]
  },
  {
   "id": "d2-m1-005",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هَلْ أَنْتَ وَجْدِي؟",
   "lines": [
    "u2-1-shadi-1",
    "u2-1-shadi-2"
   ]
  },
  {
   "id": "d2-m1-006",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَنْ أَنْتَ؟",
   "lines": [
    "man-a-q1"
   ]
  },
  {
   "id": "d2-m1-007",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَنْ أَنْتِ؟",
   "lines": [
    "man-a-q2"
   ]
  },
  {
   "id": "d2-m1-008",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَنْ أَنْتُمَا؟",
   "lines": [
    "man-a-q3",
    "man-a-q4"
   ]
  },
  {
   "id": "d2-m1-009",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَنْ أَنْتُمْ؟",
   "lines": [
    "man-a-q5"
   ]
  },
  {
   "id": "d2-m1-010",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَنْ أَنْتُنَّ؟",
   "lines": [
    "man-a-q6"
   ]
  },
  {
   "id": "d2-m1-011",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَنْ أَنْتَ؟ مَا اسْمُكَ؟",
   "lines": [
    "man-b-q1"
   ]
  },
  {
   "id": "d2-m1-012",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَنْ أَنْتِ؟ مَا اسْمُكِ؟",
   "lines": [
    "man-b-q2"
   ]
  },
  {
   "id": "d2-m1-013",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَنْ أَنْتُمَا؟ مَا اسْمَاكُمَا؟",
   "lines": [
    "man-b-q3",
    "man-b-q4"
   ]
  },
  {
   "id": "d2-m1-014",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَنْ أَنْتُمْ؟ مَا أَسْمَاؤُكُمْ؟",
   "lines": [
    "man-b-q5"
   ]
  },
  {
   "id": "d2-m1-015",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَنْ أَنْتُنَّ؟ مَا أَسْمَاؤُكُنَّ؟",
   "lines": [
    "man-b-q6"
   ]
  },
  {
   "id": "d2-m1-016",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هُوَ أَحْمَد. اسْمُهُ أَحْمَد.",
   "lines": [
    "u3-a-a1"
   ]
  },
  {
   "id": "d2-m1-017",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هُمَا سَمِير وَمَجْدِي. اسْمَاهُمَا سَمِير وَمَجْدِي.",
   "lines": [
    "u3-a-a2"
   ]
  },
  {
   "id": "d2-m1-018",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هُمْ نَبِيل وَرِفْعَت وَمُصْطَفَى. أَسْمَاؤُهُمْ نَبِيل وَرِفْعَت وَمُصْطَفَى.",
   "lines": [
    "u3-a-a3"
   ]
  },
  {
   "id": "d2-m1-019",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هِيَ سَلْوَى. اسْمُهَا سَلْوَى.",
   "lines": [
    "u3-b-a1"
   ]
  },
  {
   "id": "d2-m1-020",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هُمَا نَرْمِين وَإِيمَان. اسْمَاهُمَا نَرْمِين وَإِيمَان.",
   "lines": [
    "u3-b-a2"
   ]
  },
  {
   "id": "d2-m1-021",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هُنَّ حَنَان وَنَجْوَى وَفَاطِمَة. أَسْمَاؤُهُنَّ حَنَان وَنَجْوَى وَفَاطِمَة.",
   "lines": [
    "u3-b-a3"
   ]
  },
  {
   "id": "d2-m1-022",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "صَبَاحُ الْخَيْر. أَنَا اسْمِي أَحْمَد. وَأَنْتَ مَا اسْمُكَ؟",
   "lines": [
    "u3-ah-1"
   ]
  },
  {
   "id": "d2-m1-023",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مِنْ أَيْنَ أَنْتَ يَا عَبْدَ اللهِ؟",
   "lines": [
    "u3-ah-3"
   ]
  },
  {
   "id": "d2-m1-024",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "وَأَنَا مِنْ مِصْر. أَهْلًا وَسَهْلًا بِكَ فِي مِصْر.",
   "lines": [
    "u3-ah-5"
   ]
  },
  {
   "id": "d2-m1-025",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "آه، عَفْوًا … أَنَا آسِفٌ جِدًّا.",
   "lines": [
    "u4-my-1"
   ]
  },
  {
   "id": "d2-m1-026",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "نَعَمْ، أَنَا مِنْ مِصْرَ. أَنَا مِصْرِيٌّ. وَأَنْتَ؟ مِنْ أَيْنَ أَنْتَ؟",
   "lines": [
    "u4-my-3"
   ]
  },
  {
   "id": "d2-m1-027",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "أَهْلًا، تَشَرَّفْنَا، وَأَهْلًا بِكَ فِي مِصْرَ.",
   "lines": [
    "u4-my-5"
   ]
  },
  {
   "id": "d2-m1-028",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَعَ السَّلَامَةِ.",
   "lines": [
    "u4-my-7"
   ]
  },
  {
   "id": "d2-m1-029",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مِنْ أَيْنَ هَذِهِ الدَّرَّاجَةُ؟",
   "lines": [
    "u4-sh-1"
   ]
  },
  {
   "id": "d2-m1-030",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "لَوْ سَمَحْتِ، مَا هَذِهِ؟ مَا الِاسْمُ بِالْعَرَبِيَّةِ؟",
   "lines": [
    "u4-sp-1"
   ]
  },
  {
   "id": "d2-m1-031",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَا الْهِجَاءُ؟",
   "lines": [
    "u4-sp-3"
   ]
  },
  {
   "id": "d2-m1-032",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "شُكْرًا.",
   "lines": [
    "u4-sp-5"
   ]
  },
  {
   "id": "d2-m1-033",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مِحْفَظَةُ مَنْ هَذِهِ؟ هَذِهِ مِحْفَظَةُ مَنْ؟",
   "lines": [
    "u5-ks-1"
   ]
  },
  {
   "id": "d2-m1-034",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "وَأَوْرَاقُ مَنْ هَذِهِ؟",
   "lines": [
    "u5-ks-3"
   ]
  },
  {
   "id": "d2-m1-035",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "وَنَظَّارَةُ مَنْ هَذِهِ؟",
   "lines": [
    "u5-ks-5"
   ]
  },
  {
   "id": "d2-m1-036",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "وَكَامِيرَا مَنْ هَذِهِ؟",
   "lines": [
    "u5-ks-7"
   ]
  },
  {
   "id": "d2-m1-037",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هَلْ هَذِهِ نَظَّارَةٌ؟",
   "lines": [
    "u5-a-1"
   ]
  },
  {
   "id": "d2-m1-038",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هَلْ هَذَا كِتَابٌ؟",
   "lines": [
    "u5-a-3"
   ]
  },
  {
   "id": "d2-m1-039",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هَلْ هَذِهِ حَقِيبَتُكَ؟",
   "lines": [
    "u5-b-1"
   ]
  },
  {
   "id": "d2-m1-040",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هَلْ هَذَا قَلَمُكِ؟",
   "lines": [
    "u5-b-3"
   ]
  }
 ]
}
