{
 "batch": "batch-l2s-11",
 "items": [
  {
   "id": "s0583",
   "kind": "sentence",
   "text": "الْجِيزَة – الْقَاهِرَة"
  },
  {
   "id": "s0584",
   "kind": "sentence",
   "text": "تِلِيفُون عِيَادَة"
  },
  {
   "id": "s0585",
   "kind": "sentence",
   "text": "أَحَدَ عَشَرَ"
  },
  {
   "id": "s0586",
   "kind": "sentence",
   "text": "اثْنَا عَشَرَ"
  },
  {
   "id": "s0587",
   "kind": "sentence",
   "text": "ثَلَاثَةَ عَشَرَ"
  },
  {
   "id": "s0588",
   "kind": "sentence",
   "text": "أَرْبَعَةَ عَشَرَ"
  },
  {
   "id": "s0589",
   "kind": "sentence",
   "text": "خَمْسَةَ عَشَرَ"
  },
  {
   "id": "s0590",
   "kind": "sentence",
   "text": "سِتَّةَ عَشَرَ"
  },
  {
   "id": "s0591",
   "kind": "sentence",
   "text": "سَبْعَةَ عَشَرَ"
  },
  {
   "id": "s0592",
   "kind": "sentence",
   "text": "ثَمَانِيَةَ عَشَرَ"
  },
  {
   "id": "s0593",
   "kind": "sentence",
   "text": "تِسْعَةَ عَشَرَ"
  },
  {
   "id": "s0594",
   "kind": "sentence",
   "text": "الْحَادِيَ عَشَرَ"
  },
  {
   "id": "s0595",
   "kind": "sentence",
   "text": "الثَّانِيَ عَشَرَ"
  },
  {
   "id": "s0596",
   "kind": "sentence",
   "text": "أَرْبَعَة زَائِد أَرْبَعَة يُسَاوِي ثَمَانِيَة"
  },
  {
   "id": "s0597",
   "kind": "sentence",
   "text": "عِشْرُون نَاقِص خَمْسَة يُسَاوِي خَمْسَةَ عَشَرَ"
  },
  {
   "id": "s0598",
   "kind": "sentence",
   "text": "عِشْرُون عَلَى اثْنَان يُسَاوِي عَشَرَة"
  },
  {
   "id": "s0599",
   "kind": "sentence",
   "text": "سِتَّة عَلَى اثْنَان يُسَاوِي ثَلَاثَة"
  },
  {
   "id": "s0600",
   "kind": "sentence",
   "text": "خَمْسَة زَائِد سِتَّة يُسَاوِي أَحَدَ عَشَرَ"
  },
  {
   "id": "s0601",
   "kind": "sentence",
   "text": "أَرْبَعَةَ عَشَرَ زَائِد أَرْبَعَة يُسَاوِي ثَمَانِيَةَ عَشَرَ"
  },
  {
   "id": "s0602",
   "kind": "sentence",
   "text": "ثَلَاثَة فِي أَرْبَعَة يُسَاوِي اثْنَا عَشَرَ"
  },
  {
   "id": "s0603",
   "kind": "sentence",
   "text": "خَمْسَةَ عَشَرَ نَاقِص اثْنَان يُسَاوِي ثَلَاثَةَ عَشَرَ"
  },
  {
   "id": "s0604",
   "kind": "sentence",
   "text": "خَمْسَة زَائِد اثْنَان يُسَاوِي سَبْعَة"
  },
  {
   "id": "s0605",
   "kind": "sentence",
   "text": "اثْنَا عَشَرَ نَاقِص وَاحِد يُسَاوِي أَحَدَ عَشَرَ"
  },
  {
   "id": "s0606",
   "kind": "sentence",
   "text": "تِسْعَة فِي اثْنَان يُسَاوِي ثَمَانِيَةَ عَشَرَ"
  },
  {
   "id": "s0607",
   "kind": "sentence",
   "text": "عَزِيزِي غَسَّان،"
  },
  {
   "id": "s0609",
   "kind": "sentence",
   "text": "رَقْمُ تِلِيفُونِ الْفُنْدُقِ: ثَلَاثَة خَمْسَة أَرْبَعَة وَاحِد ثَلَاثَة سَبْعَة اثْنَان ثَمَانِيَة أَوْ ثَلَاثَة خَمْسَة أَرْبَعَة وَاحِد ثَلَاثَة سَبْعَة اثْنَان تِسْعَة"
  },
  {
   "id": "s0610",
   "kind": "sentence",
   "text": "وَرَقْمُ تِلِيفُونِي الْمَحْمُولِ: صِفْر وَاحِد ثَمَانِيَة ثَمَانِيَة تِسْعَة خَمْسَة ثَلَاثَة أَرْبَعَة اثْنَان وَاحِد"
  },
  {
   "id": "s0611",
   "kind": "sentence",
   "text": "عُنْوَانُ الْفُنْدُقِ: خَمْسَة وَعِشْرُون شَارِعُ مَكَّةَ، وَحُجْرَتِي فِي الدَّوْرِ الثَّانِي."
  },
  {
   "id": "s0612",
   "kind": "sentence",
   "text": "صَدِيقُكَ هِشَام"
  },
  {
   "id": "s0613",
   "kind": "sentence",
   "text": "رَقْمُ الْمَحْمُولِ: ٠١٨٦٩٣٥٢١٤"
  },
  {
   "id": "s0614",
   "kind": "sentence",
   "text": "رَقْمُ الشَّارِعِ: ١٢"
  },
  {
   "id": "s0615",
   "kind": "sentence",
   "text": "الدَّوْرُ: الثَّالِث، رَقْمُ الشَّقَّةِ: ٣"
  },
  {
   "id": "s0616",
   "kind": "sentence",
   "text": "مَا رَقْمُ تِلِيفُونِكَ؟"
  },
  {
   "id": "s0617",
   "kind": "sentence",
   "text": "مَا رَقْمُ تِلِيفُونِكِ؟"
  },
  {
   "id": "s0618",
   "kind": "sentence",
   "text": "مَا رَقْمُ تِلِيفُونِهِ؟"
  },
  {
   "id": "s0619",
   "kind": "sentence",
   "text": "مَا رَقْمُ تِلِيفُونِهَا؟"
  },
  {
   "id": "s0621",
   "kind": "sentence",
   "text": "أَيُّ دَوْرٍ؟"
  },
  {
   "id": "s0622",
   "kind": "sentence",
   "text": "مَا رَقْمُ الشَّقَّةِ؟"
  },
  {
   "id": "s0650",
   "kind": "sentence",
   "text": "صُورَة: مُمَرِّضَة وَرَجُل عَلَى التِّلِيفُون"
  },
  {
   "id": "s0651",
   "kind": "sentence",
   "text": "صُورَة: مُمَرِّضَة وَسَيِّدَة عَلَى التِّلِيفُون"
  },
  {
   "id": "s0652",
   "kind": "sentence",
   "text": "عُنْوَانُهُ ١٥ شَارِعُ الْبَرَازِيلِ، الدَّوْرُ الرَّابِعُ، شَقَّةُ ١٩."
  },
  {
   "id": "s0653",
   "kind": "sentence",
   "text": "رَقْمُ الْفَاكْسِ ٣٢٥٦٤٤٠١"
  },
  {
   "id": "s0654",
   "kind": "sentence",
   "text": "وَعَلَيْكُمُ السَّلَامُ."
  },
  {
   "id": "s0655",
   "kind": "sentence",
   "text": "أَلُو، السَّلَامُ عَلَيْكُمْ."
  },
  {
   "id": "s0656",
   "kind": "sentence",
   "text": "لَوْ سَمَحْتِ، مَا رَقْمُ تِلِيفُونِ مُسْتَشْفَى الشِّفَاءِ؟"
  },
  {
   "id": "s0657",
   "kind": "sentence",
   "text": "رَقْمُ تِلِيفُونِهَا ٢٣٤٨٧٦٥٢."
  },
  {
   "id": "s0659",
   "kind": "sentence",
   "text": "عُنْوَانُهَا شَارِعُ مُرَاد."
  },
  {
   "id": "s0660",
   "kind": "sentence",
   "text": "اسْمُ الْفُنْدُقِ: الْوَرْدَةُ الْبَيْضَاءُ"
  },
  {
   "id": "s0661",
   "kind": "sentence",
   "text": "رَقْمُ الْحُجْرَةِ ١٢، الدَّوْرُ الثَّانِي"
  },
  {
   "id": "s0662",
   "kind": "sentence",
   "text": "رَقْمُ تِلِيفُونِ الْفُنْدُقِ: ٣٥٤١٣٧٢٨ أَوْ ٣٥٤١٣٧٢٩"
  }
 ]
}
