{
 "batch": "batch-l2s-17",
 "items": [
  {
   "id": "s0944",
   "kind": "sentence",
   "text": "دُولَابُ السُّفْرَةِ"
  },
  {
   "id": "s0945",
   "kind": "sentence",
   "text": "شَقَّتِي جَمِيلَةٌ وَوَاسِعَةٌ."
  },
  {
   "id": "s0946",
   "kind": "sentence",
   "text": "شَقَّتِي بِهَا ٣ حُجُرَاتٍ – حُجْرَةُ النَّوْمِ وَحُجْرَةُ السُّفْرَةِ وَحُجْرَةُ مَعِيشَةٍ وَاسِعَةٌ."
  },
  {
   "id": "s0947",
   "kind": "sentence",
   "text": "الْحَمَّامُ لَوْنُهُ أَخْضَرُ، وَلَكِنِ الْمَطْبَخُ لَوْنُهُ أَبْيَضُ."
  },
  {
   "id": "s0948",
   "kind": "sentence",
   "text": "حُجْرَةُ نَوْمِي لَوْنُهَا أَبْيَضُ أَيْضًا، وَلَكِنْ حُجْرَةُ السُّفْرَةِ لَوْنُهَا أَخْضَرُ."
  },
  {
   "id": "s0949",
   "kind": "sentence",
   "text": "وَحُجْرَةُ الْمَعِيشَةِ لَوْنُهَا أَحْمَرُ جَمِيلٌ."
  },
  {
   "id": "s0950",
   "kind": "sentence",
   "text": "مَا لَوْنُ هَذَا الْقَمِيصِ؟"
  },
  {
   "id": "s0952",
   "kind": "sentence",
   "text": "مَا لَوْنُ هَذِهِ الْحَقِيبَةِ؟"
  },
  {
   "id": "s0954",
   "kind": "sentence",
   "text": "هَلْ هَذَا قَمِيصٌ أَحْمَرُ؟"
  },
  {
   "id": "s0956",
   "kind": "sentence",
   "text": "هَلْ هَذِهِ حَقِيبَةٌ سَوْدَاءُ؟"
  },
  {
   "id": "s0958",
   "kind": "sentence",
   "text": "هَذَا قَمِيصٌ أَحْمَرُ."
  },
  {
   "id": "s0959",
   "kind": "sentence",
   "text": "هَذَا لَيْسَ قَمِيصًا أَحْمَرَ."
  },
  {
   "id": "s0960",
   "kind": "sentence",
   "text": "هَذِهِ حَقِيبَةٌ حَمْرَاءُ."
  },
  {
   "id": "s0961",
   "kind": "sentence",
   "text": "هَذِهِ لَيْسَتْ حَقِيبَةً حَمْرَاءَ."
  },
  {
   "id": "s0962",
   "kind": "sentence",
   "text": "نَعَمْ، هَذَا سَرِيرٌ أَخْضَرُ."
  },
  {
   "id": "s0963",
   "kind": "sentence",
   "text": "لَا، هَذَا لَيْسَ سَرِيرًا أَخْضَرَ."
  },
  {
   "id": "s0964",
   "kind": "sentence",
   "text": "هَذَا قَلَمٌ لَوْنُهُ أَسْوَدُ."
  },
  {
   "id": "s0965",
   "kind": "sentence",
   "text": "هَذَا مَطْبَخٌ أَحْمَرُ."
  },
  {
   "id": "s0966",
   "kind": "sentence",
   "text": "هَذَا حَمَّامٌ أَبْيَضُ."
  },
  {
   "id": "s0967",
   "kind": "sentence",
   "text": "هَذَا حَوْضٌ أَزْرَقُ."
  },
  {
   "id": "s0968",
   "kind": "sentence",
   "text": "هَذِهِ حُجْرَةُ نَوْمٍ صَفْرَاءُ."
  },
  {
   "id": "s0969",
   "kind": "sentence",
   "text": "هَذِهِ حُجْرَةُ سُفْرَةٍ حَمْرَاءُ."
  },
  {
   "id": "s0970",
   "kind": "sentence",
   "text": "هَذِهِ حُجْرَةُ مَعِيشَةٍ سَوْدَاءُ."
  },
  {
   "id": "s0971",
   "kind": "sentence",
   "text": "هَذَا مِصْبَاحٌ أَصْفَرُ."
  },
  {
   "id": "s0972",
   "kind": "sentence",
   "text": "هَلْ هَذِهِ أَرِيكَةٌ (كَنَبَةٌ) خَضْرَاءُ؟"
  },
  {
   "id": "s0973",
   "kind": "sentence",
   "text": "نَعَمْ، هَذِهِ أَرِيكَةٌ خَضْرَاءُ."
  },
  {
   "id": "s0974",
   "kind": "sentence",
   "text": "مَا لَوْنُ هَذَا الْحَمَّامِ؟"
  },
  {
   "id": "s0975",
   "kind": "sentence",
   "text": "هَذَا الْحَمَّامُ لَوْنُهُ أَبْيَضُ."
  },
  {
   "id": "s0976",
   "kind": "sentence",
   "text": "هَلْ هَذَا مَوْقِدٌ (بُوتَاجَازٌ) فِضِّيٌّ؟"
  },
  {
   "id": "s0977",
   "kind": "sentence",
   "text": "نَعَمْ، هَذَا مَوْقِدٌ فِضِّيٌّ."
  },
  {
   "id": "s0978",
   "kind": "sentence",
   "text": "مَا لَوْنُ هَذِهِ الثَّلَّاجَةِ؟"
  },
  {
   "id": "s0979",
   "kind": "sentence",
   "text": "هَذِهِ الثَّلَّاجَةُ لَوْنُهَا أَبْيَضُ."
  },
  {
   "id": "s0980",
   "kind": "sentence",
   "text": "هَلْ هَذِهِ سَجَّادَةٌ سَوْدَاءُ؟"
  },
  {
   "id": "s0981",
   "kind": "sentence",
   "text": "نَعَمْ، هَذِهِ سَجَّادَةٌ سَوْدَاءُ."
  },
  {
   "id": "s0982",
   "kind": "sentence",
   "text": "مَا لَوْنُ هَذِهِ السِّتَارَةِ؟"
  },
  {
   "id": "s0983",
   "kind": "sentence",
   "text": "هَذِهِ سَتَارَةٌ لَوْنُهَا ذَهَبِيٌّ."
  },
  {
   "id": "s0984",
   "kind": "sentence",
   "text": "هَلْ هَذِهِ حُجْرَةُ نَوْمٍ صَفْرَاءُ؟"
  },
  {
   "id": "s0986",
   "kind": "sentence",
   "text": "مَا لَوْنُ هَذَا الْمَكْتَبِ؟"
  },
  {
   "id": "s0987",
   "kind": "sentence",
   "text": "هَذَا مَكْتَبٌ لَوْنُهُ أَسْوَدُ."
  },
  {
   "id": "s0988",
   "kind": "sentence",
   "text": "هَذِهِ مِدْفَأَةٌ بَيْضَاءُ."
  },
  {
   "id": "s0989",
   "kind": "sentence",
   "text": "هَلْ هَذِهِ مَكْتَبَةٌ سَوْدَاءُ؟"
  },
  {
   "id": "s0991",
   "kind": "sentence",
   "text": "فِي شَقَّةِ حُسَام ٣ حُجُرَاتٍ."
  },
  {
   "id": "s0992",
   "kind": "sentence",
   "text": "حُجْرَةُ النَّوْمِ – حُجْرَةُ السُّفْرَةِ – حُجْرَةُ الْمَعِيشَةِ"
  },
  {
   "id": "s0993",
   "kind": "sentence",
   "text": "حَمَّامُ حُسَام لَوْنُهُ أَخْضَرُ."
  },
  {
   "id": "s0994",
   "kind": "sentence",
   "text": "لَا، حُجْرَةُ النَّوْمِ لَوْنُهَا أَبْيَضُ."
  },
  {
   "id": "s0995",
   "kind": "sentence",
   "text": "حُجْرَةُ الْمَعِيشَةِ لَوْنُهَا أَحْمَرُ جَمِيلٌ."
  },
  {
   "id": "s0996",
   "kind": "sentence",
   "text": "نَعَمْ، الشَّقَّةُ جَمِيلَةٌ وَوَاسِعَةٌ."
  },
