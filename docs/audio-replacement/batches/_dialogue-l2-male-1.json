 ],
 "items": [
  {
   "id": "d2-m1-001",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَسَاءُ الْخَيْرِ.",
   "lines": [
    "e-m-masa-al-khayr"
   ]
  },
  {
   "id": "d2-m1-002",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "كَيْفَ حَالُكَ؟",
   "lines": [
    "e-m-kayfa-haluka"
   ]
  },
  {
   "id": "d2-m1-003",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَا اسْمُكَ؟",
   "lines": [
    "e-m-ma-smuka"
   ]
  },
  {
   "id": "d2-m1-004",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "اسْمِي عَدْنَان.",
   "lines": [
    "e-m-ismi-adnan"
   ]
  },
  {
   "id": "d2-m1-005",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هَلْ أَنْتَ وَجْدِي؟",
   "lines": [
    "u2-1-shadi-1",
    "u2-1-shadi-2"
   ]
  },
  {
   "id": "d2-m1-006",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَنْ أَنْتَ؟",
   "lines": [
    "man-a-q1"
   ]
  },
  {
   "id": "d2-m1-007",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَنْ أَنْتِ؟",
   "lines": [
    "man-a-q2"
   ]
  },
  {
   "id": "d2-m1-008",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَنْ أَنْتُمَا؟",
   "lines": [
    "man-a-q3",
    "man-a-q4"
   ]
  },
  {
   "id": "d2-m1-009",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَنْ أَنْتُمْ؟",
   "lines": [
    "man-a-q5"
   ]
  },
  {
   "id": "d2-m1-010",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَنْ أَنْتُنَّ؟",
   "lines": [
    "man-a-q6"
   ]
  },
  {
   "id": "d2-m1-011",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَنْ أَنْتَ؟ مَا اسْمُكَ؟",
   "lines": [
    "man-b-q1"
   ]
  },
  {
   "id": "d2-m1-012",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَنْ أَنْتِ؟ مَا اسْمُكِ؟",
   "lines": [
    "man-b-q2"
   ]
  },
  {
   "id": "d2-m1-013",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَنْ أَنْتُمَا؟ مَا اسْمَاكُمَا؟",
   "lines": [
    "man-b-q3",
    "man-b-q4"
   ]
  },
  {
   "id": "d2-m1-014",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَنْ أَنْتُمْ؟ مَا أَسْمَاؤُكُمْ؟",
   "lines": [
    "man-b-q5"
   ]
  },
  {
   "id": "d2-m1-015",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَنْ أَنْتُنَّ؟ مَا أَسْمَاؤُكُنَّ؟",
   "lines": [
    "man-b-q6"
   ]
  },
  {
   "id": "d2-m1-016",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هُوَ أَحْمَد. اسْمُهُ أَحْمَد.",
   "lines": [
    "u3-a-a1"
   ]
  },
  {
   "id": "d2-m1-017",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هُمَا سَمِير وَمَجْدِي. اسْمَاهُمَا سَمِير وَمَجْدِي.",
   "lines": [
    "u3-a-a2"
   ]
  },
  {
   "id": "d2-m1-018",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هُمْ نَبِيل وَرِفْعَت وَمُصْطَفَى. أَسْمَاؤُهُمْ نَبِيل وَرِفْعَت وَمُصْطَفَى.",
   "lines": [
    "u3-a-a3"
   ]
  },
  {
   "id": "d2-m1-019",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هِيَ سَلْوَى. اسْمُهَا سَلْوَى.",
   "lines": [
    "u3-b-a1"
   ]
  },
  {
   "id": "d2-m1-020",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هُمَا نَرْمِين وَإِيمَان. اسْمَاهُمَا نَرْمِين وَإِيمَان.",
   "lines": [
    "u3-b-a2"
   ]
  },
  {
   "id": "d2-m1-021",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هُنَّ حَنَان وَنَجْوَى وَفَاطِمَة. أَسْمَاؤُهُنَّ حَنَان وَنَجْوَى وَفَاطِمَة.",
   "lines": [
    "u3-b-a3"
   ]
  },
  {
   "id": "d2-m1-022",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "صَبَاحُ الْخَيْر. أَنَا اسْمِي أَحْمَد. وَأَنْتَ مَا اسْمُكَ؟",
   "lines": [
    "u3-ah-1"
   ]
  },
  {
   "id": "d2-m1-023",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مِنْ أَيْنَ أَنْتَ يَا عَبْدَ اللهِ؟",
   "lines": [
    "u3-ah-3"
   ]
  },
  {
   "id": "d2-m1-024",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "وَأَنَا مِنْ مِصْر. أَهْلًا وَسَهْلًا بِكَ فِي مِصْر.",
   "lines": [
    "u3-ah-5"
   ]
  },
  {
   "id": "d2-m1-025",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "آه، عَفْوًا … أَنَا آسِفٌ جِدًّا.",
   "lines": [
    "u4-my-1"
   ]
  },
  {
   "id": "d2-m1-026",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "نَعَمْ، أَنَا مِنْ مِصْرَ. أَنَا مِصْرِيٌّ. وَأَنْتَ؟ مِنْ أَيْنَ أَنْتَ؟",
   "lines": [
    "u4-my-3"
   ]
  },
  {
   "id": "d2-m1-027",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "أَهْلًا، تَشَرَّفْنَا، وَأَهْلًا بِكَ فِي مِصْرَ.",
   "lines": [
    "u4-my-5"
   ]
  },
  {
   "id": "d2-m1-028",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَعَ السَّلَامَةِ.",
   "lines": [
    "u4-my-7"
   ]
  },
  {
   "id": "d2-m1-029",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مِنْ أَيْنَ هَذِهِ الدَّرَّاجَةُ؟",
   "lines": [
    "u4-sh-1"
   ]
  },
  {
   "id": "d2-m1-030",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "لَوْ سَمَحْتِ، مَا هَذِهِ؟ مَا الِاسْمُ بِالْعَرَبِيَّةِ؟",
   "lines": [
    "u4-sp-1"
   ]
  },
  {
   "id": "d2-m1-031",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَا الْهِجَاءُ؟",
   "lines": [
    "u4-sp-3"
   ]
  },
  {
   "id": "d2-m1-032",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "شُكْرًا.",
   "lines": [
    "u4-sp-5"
   ]
  },
  {
   "id": "d2-m1-033",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مِحْفَظَةُ مَنْ هَذِهِ؟ هَذِهِ مِحْفَظَةُ مَنْ؟",
   "lines": [
    "u5-ks-1"
   ]
  },
  {
   "id": "d2-m1-034",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "وَأَوْرَاقُ مَنْ هَذِهِ؟",
   "lines": [
    "u5-ks-3"
   ]
  },
  {
   "id": "d2-m1-035",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "وَنَظَّارَةُ مَنْ هَذِهِ؟",
   "lines": [
    "u5-ks-5"
   ]
  },
  {
   "id": "d2-m1-036",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "وَكَامِيرَا مَنْ هَذِهِ؟",
   "lines": [
    "u5-ks-7"
   ]
  },
  {
   "id": "d2-m1-037",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هَلْ هَذِهِ نَظَّارَةٌ؟",
   "lines": [
    "u5-a-1"
   ]
  },
  {
   "id": "d2-m1-038",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هَلْ هَذَا كِتَابٌ؟",
   "lines": [
    "u5-a-3"
   ]
  },
  {
   "id": "d2-m1-039",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هَلْ هَذِهِ حَقِيبَتُكَ؟",
   "lines": [
    "u5-b-1"
   ]
  },
  {
   "id": "d2-m1-040",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هَلْ هَذَا قَلَمُكِ؟",
   "lines": [
    "u5-b-3"
   ]
  },
  {
   "id": "d2-m1-041",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "أَلُو … عِيَادَةُ الدُّكْتُورِ سَيْف عَبْدِ اللهِ؟",
   "lines": [
    "u6-pn-1"
   ]
  },
  {
   "id": "d2-m1-042",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَا رَقْمُ تِلِيفُونِهِ الْمَحْمُولِ لَوْ سَمَحْتِ؟",
   "lines": [
    "u6-pn-3"
   ]
  },
  {
   "id": "d2-m1-043",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "السَّلَامُ عَلَيْكُمْ.",
   "lines": [
    "u6-c2-1"
   ]
  },
  {
   "id": "d2-m1-044",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "لَوْ سَمَحْتِ، مَا رَقْمُ تِلِيفُونِ مُسْتَشْفَى الْحَيَاةِ؟",
   "lines": [
    "u6-c2-3"
   ]
  },
  {
   "id": "d2-m1-045",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "وَمَا رَقْمُ الْفَاكْسِ؟",
   "lines": [
    "u6-c2-5"
   ]
  },
  {
   "id": "d2-m1-046",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "شُكْرًا جَزِيلًا.",
   "lines": [
    "u6-c2-7"
   ]
  },
  {
   "id": "d2-m1-047",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "يَا آنِسَة مُنَى، مَا مَوْعِدُ قِيَامِ الْقِطَارِ؟",
   "lines": [
    "u6-rm-1"
   ]
  },
  {
   "id": "d2-m1-048",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "سِعْرُ هَذِهِ الْبَدْلَةِ أَلْفٌ وَخَمْسُمِائَةِ جُنَيْهٍ.",
   "lines": [
    "u7-s-2"
   ]
  },
  {
   "id": "d2-m1-049",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "سِعْرُ هَذَا الْقَلَمِ جُنَيْهَانِ.",
   "lines": [
    "u7-s-4"
   ]
  },
  {
   "id": "d2-m1-050",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "سِعْرُ هَذِهِ اللُّعْبَةِ ثَلَاثَةُ جُنَيْهَاتٍ.",
   "lines": [
    "u7-s-6"
   ]
  },
  {
   "id": "d2-m1-051",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَا لَوْنُ حُجْرَةِ النَّوْمِ يَا شَرِيفُ؟",
   "lines": [
    "u7-ss-1"
   ]
  },
  {
   "id": "d2-m1-052",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "وَمَا لَوْنُ سَرِيرِكَ؟",
   "lines": [
    "u7-ss-3"
   ]
  },
  {
   "id": "d2-m1-053",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "وَهَلْ مَكْتَبُكَ لَوْنُهُ أَخْضَرُ؟",
   "lines": [
    "u7-ss-5"
   ]
  },
  {
   "id": "d2-m1-054",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "أَنَا فِي الْخِدْمَةِ.",
   "lines": [
    "u8-st-1"
   ]
  },
  {
   "id": "d2-m1-055",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "قِسْمُ الْكَامِيرَاتِ بِجَانِبِ الْخَزِينَةِ.",
   "lines": [
    "u8-st-3"
   ]
  },
  {
   "id": "d2-m1-056",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "لَا، قِسْمُ الثَّلَّاجَاتِ لَيْسَ أَمَامَ الْمِصْعَدِ، قِسْمُ الثَّلَّاجَاتِ أَمَامَ حَمَّامِ السَّيِّدَاتِ.",
   "lines": [
    "u8-st-5"
   ]
  },
  {
   "id": "d2-m1-057",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "قِسْمُ التِّلِفِزْيُونَاتِ خَلْفَ قِسْمِ الثَّلَّاجَاتِ.",
   "lines": [
    "u8-st-7"
   ]
  },
  {
   "id": "d2-m1-058",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "قِسْمُ الْغَسَّالَاتِ بَيْنَ حَمَّامِ السَّيِّدَاتِ وَحَمَّامِ الرِّجَالِ.",
   "lines": [
    "u8-st-9"
   ]
  },
  {
   "id": "d2-m1-059",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "الْكَافِتِيرْيَا خَلْفَ قِسْمِ الْكُمْبِيُوتَرَاتِ. أَيُّ خِدْمَةٍ أُخْرَى؟",
   "lines": [
    "u8-st-11"
   ]
  },
  {
   "id": "d2-m1-060",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "بَيْنَ سَلْوَى وَعَبْلَة مَاجِد.",
   "lines": [
    "u8-p-2"
   ]
  },
  {
   "id": "d2-m1-061",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مُهَاب أَمَامَ سَمِيح.",
   "lines": [
    "u8-p-4"
   ]
  },
  {
   "id": "d2-m1-062",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "دُعَاء فَوْقَ الْكُرْسِيِّ.",
   "lines": [
    "u8-p-6"
   ]
  },
  {
   "id": "d2-m1-063",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هَادِيَة خَلْفَ زِيَاد – وَهَذِهِ شَيْمَاء عَلَى الْأَرِيكَةِ.",
   "lines": [
    "u8-p-8"
   ]
  },
  {
   "id": "d2-m1-064",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "السُّوقُ الْحُرَّةُ فِي الدَّوْرِ الثَّالِثِ أَمَامَ مَكْتَبِ السِّيَاحَةِ.",
   "lines": [
    "u8-a-2"
   ]
  },
  {
   "id": "d2-m1-065",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "أَنْتِ الْآنَ فِي شَارِعِ مِصْرَ وَالسُّودَانِ، اُدْخُلِي يَمِينًا فِي شَارِعِ كِلْيُوبَاتْرَا.",
   "lines": [
    "u8-t-2"
   ]
  },
  {
   "id": "d2-m1-066",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "اسْتَمِرِّي فِي شَارِعِ كِلْيُوبَاتْرَا حَتَّى بَعْدَ التَّقَاطُعِ مَعَ شَارِعِ رَمْسِيس، الصَّيْدَلِيَّةُ عَلَى الْيَمِينِ وَعَلَى النَّاصِيَةِ.",
   "lines": [
    "u8-t-4"
   ]
  },
  {
   "id": "d2-m1-067",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "عَفْوًا.",
   "lines": [
    "u8-t-6"
   ]
  },
  {
   "id": "d2-m1-068",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "لَا، آسِفٌ يَا سَعِيدُ. أَنَا أَعْمَلُ فِي الْمَكْتَبِ الْآنَ.",
   "lines": [
    "u9-sb-2"
   ]
  },
  {
   "id": "d2-m1-069",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "السَّلَامُ عَلَيْكُمْ يَا عِمَاد. الْيَوْمَ السَّبْتُ. هَلْ تَذْهَبُ مَعِي إِلَى النَّادِي؟",
   "lines": [
    "u9-ef-1"
   ]
  },
  {
   "id": "d2-m1-070",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "لِمَاذَا؟",
   "lines": [
    "u9-ef-3"
   ]
  },
  {
   "id": "d2-m1-071",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "أَمْ … فِي الْحَقِيقَةِ، أَنَا لَا أَقْرَأُ … وَلَا أَسْمَعُ مُوسِيقَى … أَنَا أُحِبُّ النَّادِي. أَنَا أَذْهَبُ إِلَى النَّادِي، أَلْعَبُ رِيَاضَةً وَأَجْرِي وَأُقَابِلُ أَصْدِقَائِي.",
   "lines": [
    "u9-ef-5"
   ]
  },
  {
   "id": "d2-m1-072",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "لَا، هِيَ لَا تَعْمَلُ، هِيَ رَبَّةُ بَيْتٍ.",
   "lines": [
    "u10-e-2"
   ]
  },
  {
   "id": "d2-m1-073",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "لَا، هُوَ لَا يَعْمَلُ هُوَ عَلَى الْمَعَاشِ.",
   "lines": [
    "u10-e-4"
   ]
  },
  {
   "id": "d2-m1-074",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "أَنَا أُسَافِرُ إِلَى الْيَابَانِ.",
   "lines": [
    "u10-s-2"
   ]
  },
  {
   "id": "d2-m1-075",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "طُوكْيُو.",
   "lines": [
    "u10-s-4"
   ]
  },
  {
   "id": "d2-m1-076",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "أُسَافِرُ فِي شَهْرِ دِيسَمْبِر وَيَنَايِر. فِي الشِّتَاءِ.",
   "lines": [
    "u10-s-6"
   ]
  },
  {
   "id": "d2-m1-077",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "الطَّقْسُ بَارِدٌ جِدًّا. أَنَا أَلْبَسُ مِعْطَفًا وَقُفَّازًا وَقُبَّعَةً أَيْضًا.",
   "lines": [
    "u10-s-8"
   ]
  }
 ]
}
