{
 "batch": "batch-l2s-23",
 "items": [
  {
   "id": "s1268",
   "kind": "sentence",
   "text": "لَا، حُسَيْن لَا يُنَظِّفُ الْبَيْتَ يَوْمَ الْجُمْعَةِ."
  },
  {
   "id": "s1269",
   "kind": "sentence",
   "text": "هَلْ هَالَة تُشَاهِدُ فِيلْمًا فِي الْإِجَازَةِ؟"
  },
  {
   "id": "s1270",
   "kind": "sentence",
   "text": "لَا، هَالَة لَا تُشَاهِدُ فِيلْمًا، هَالَة تَزُورُ عَائِلَتَهَا."
  },
  {
   "id": "s1271",
   "kind": "sentence",
   "text": "هَلْ حُسَيْن يَدْرُسُ يَوْمَ الْجُمْعَةِ؟"
  },
  {
   "id": "s1272",
   "kind": "sentence",
   "text": "لَا، حُسَيْن لَا يَدْرُسُ، حُسَيْن يَذْهَبُ إِلَى السِّينِمَا."
  },
  {
   "id": "s1273",
   "kind": "sentence",
   "text": "مَاذَا تَفْعَلُ هَالَة يَوْمَ السَّبْتِ؟"
  },
  {
   "id": "s1274",
   "kind": "sentence",
   "text": "هَالَة تَزُورُ أَبَاهَا وَأُمَّهَا."
  },
  {
   "id": "s1275",
   "kind": "sentence",
   "text": "لَا أُنَظِّفُ"
  },
  {
   "id": "s1276",
   "kind": "sentence",
   "text": "لَا أَدْرُسُ"
  },
  {
   "id": "s1277",
   "kind": "sentence",
   "text": "لَا أَزُورُ"
  },
  {
   "id": "s1278",
   "kind": "sentence",
   "text": "لَا أَلْعَبُ"
  },
  {
   "id": "s1279",
   "kind": "sentence",
   "text": "لَا أَسْمَعُ"
  },
  {
   "id": "s1280",
   "kind": "sentence",
   "text": "هَلْ تَدْرُسُ يَوْمَ الْجُمْعَةِ؟"
  },
  {
   "id": "s1281",
   "kind": "sentence",
   "text": "لَا، لَا أَدْرُسُ يَوْمَ الْجُمْعَةِ، وَلَكِنْ أَلْعَبُ التِّنِسَ."
  },
  {
   "id": "s1282",
   "kind": "sentence",
   "text": "هَلْ تَشْرَبُ الْقَهْوَةَ؟"
  },
  {
   "id": "s1284",
   "kind": "sentence",
   "text": "هَلْ تَلْعَبُ التِّنِسَ؟"
  },
  {
   "id": "s1286",
   "kind": "sentence",
   "text": "هَلْ تَسْمَعُ الرَّادْيُو؟"
  },
  {
   "id": "s1288",
   "kind": "sentence",
   "text": "هَلْ أَنَا أَنَامُ الْآنَ؟"
  },
  {
   "id": "s1290",
   "kind": "sentence",
   "text": "هَلْ مِدْحَت يَرْكَبُ الْأُوتُوبِيسَ؟"
  },
  {
   "id": "s1292",
   "kind": "sentence",
   "text": "هَلْ نَبِيلَة تَدْرُسُ؟"
  },
  {
   "id": "s1294",
   "kind": "sentence",
   "text": "هَلْ أَنْتِ تَسْمَعِينَ الْمُوسِيقَى الْآنَ؟"
  },
  {
   "id": "s1296",
   "kind": "sentence",
   "text": "هَلْ مَاجِدَة تَزُورُ صَدِيقَتَهَا؟"
  },
  {
   "id": "s1298",
   "kind": "sentence",
   "text": "هَلْ أَنْتِ تَلْعَبِينَ التِّنِسَ الْآنَ؟"
  },
  {
   "id": "s1300",
   "kind": "sentence",
   "text": "عِمَاد يَذْهَبُ إِلَى النَّادِي كُلَّ يَوْمِ سَبْتٍ."
  },
  {
   "id": "s1301",
   "kind": "sentence",
   "text": "فَوَّاز يَذْهَبُ إِلَى النَّادِي كُلَّ يَوْمِ سَبْتٍ."
  },
  {
   "id": "s1302",
   "kind": "sentence",
   "text": "فَوَّاز يَسْمَعُ الْمُوسِيقَى وَيَقْرَأُ كُتُبًا يَوْمَ السَّبْتِ."
  },
  {
   "id": "s1303",
   "kind": "sentence",
   "text": "عِمَاد يَلْعَبُ رِيَاضَةً وَيَجْرِي فِي النَّادِي."
  },
  {
   "id": "s1304",
   "kind": "sentence",
   "text": "فَوَّاز يُقَابِلُ أَصْدِقَاءَهُ يَوْمَ السَّبْتِ."
  },
  {
   "id": "s1305",
   "kind": "sentence",
   "text": "عِمَاد يُقَابِلُ أَصْدِقَاءَهُ يَوْمَ السَّبْتِ."
  },
  {
   "id": "s1306",
   "kind": "sentence",
   "text": "فَوَّاز يُحِبُّ النَّادِي."
  },
  {
   "id": "s1307",
   "kind": "sentence",
   "text": "عِمَاد يُحِبُّ النَّادِي."
  },
  {
   "id": "s1308",
   "kind": "sentence",
   "text": "مَاذَا تَفْعَلُ السَّيِّدَةُ أَسْمَاءُ فِي إِجَازَتِهَا الْأُسْبُوعِيَّةِ؟"
  },
  {
   "id": "s1309",
   "kind": "sentence",
   "text": "أ – أَسْمَاءُ تُنَظِّفُ الْبَيْتَ وَتَطْبُخُ."
  },
  {
   "id": "s1310",
   "kind": "sentence",
   "text": "ب – هِيَ تَسْتَيْقِظُ مُبَكِّرًا فِي الْإِجَازَةِ."
  },
  {
   "id": "s1311",
   "kind": "sentence",
   "text": "ج – هِيَ تُقَابِلُ صَدِيقَاتِهَا."
  },
  {
   "id": "s1312",
   "kind": "sentence",
   "text": "مَاذَا تَفْعَلُ فَاطِمَةُ الْآنَ؟"
  },
  {
   "id": "s1314",
   "kind": "sentence",
   "text": "مَاذَا تَفْعَلُ كَرِيمَةُ الْآنَ؟"
  },
  {
   "id": "s1316",
   "kind": "sentence",
   "text": "مَاذَا يَفْعَلُ خَالِد؟"
  },
  {
   "id": "s1318",
   "kind": "sentence",
   "text": "مَاذَا يَفْعَلُ حَسَّان الْآنَ؟"
  },
  {
   "id": "s1324",
   "kind": "sentence",
   "text": "مَاذَا يَفْعَلُ عَلَاءٌ؟"
  },
  {
   "id": "s1325",
   "kind": "sentence",
   "text": "مَاذَا يَفْعَلُ أَحْمَد الْآنَ؟"
  },
  {
   "id": "s1326",
   "kind": "sentence",
   "text": "هُوَ يَكْتُبُ الْآنَ."
  },
  {
   "id": "s1327",
   "kind": "sentence",
   "text": "مَاذَا يَفْعَلُ كُلَّ يَوْمٍ؟"
  },
  {
   "id": "s1328",
   "kind": "sentence",
   "text": "هُوَ يَذْهَبُ لِلْعَمَلِ كُلَّ يَوْمٍ."
  },
  {
   "id": "s1329",
   "kind": "sentence",
   "text": "لَا أَفْعَلُ"
  },
  {
   "id": "s1330",
   "kind": "sentence",
   "text": "لَا تَفْعَلُ"
  },
  {
   "id": "s1331",
   "kind": "sentence",
   "text": "لَا تَفْعَلِينَ"
  },
  {
   "id": "s1332",
   "kind": "sentence",
   "text": "لَا يَفْعَلُ"
  },
  {
   "id": "s1334",
   "kind": "sentence",
   "text": "أَنَا اسْمِي عِصَام وَأَبِي اسْمُهُ مَحْمُود وَأُمِّي اسْمُهَا فَاطِمَة، خَدِيجَة هِيَ أُخْتِي، طَارِق أَخِي الْكَبِيرُ."
  },
  {
   "id": "s1337",
   "kind": "sentence",
   "text": "صَالِح لَيْسَ أَبِي هُوَ جَدِّي وَزَيْنَب لَيْسَتْ أُمِّي هِيَ جَدَّتِي."
  }
 ]
