 "items": [
  {
   "id": "s0876",
   "kind": "sentence",
   "text": "سِعْرُ الْحَقِيبَةِ ١٢٠,٠٠"
  },
  {
   "id": "s0877",
   "kind": "sentence",
   "text": "أُرِيدُ حَقِيبَةً مِنْ فَضْلِكَ."
  },
  {
   "id": "s0878",
   "kind": "sentence",
   "text": "أُرِيدُ خَمْسَ بِدَلٍ وَأَرْبَعَةَ قُمْصَانٍ وَسِتَّةَ جَوَارِبَ."
  },
  {
   "id": "s0879",
   "kind": "sentence",
   "text": "أُرِيدُ سِتَّ حَقَائِبَ وَأَحَدَ عَشَرَ جَوْرَبًا وَأَرْبَعَةَ قُمْصَانٍ."
  },
  {
   "id": "s0892",
   "kind": "sentence",
   "text": "لَوْ سَمَحْتَ أُرِيدُ ٤ بَنْطَلُونَات (أَرْبَعَة بَنْطَلُونَات) – رَقْمُ الْكُودِ ٢٩٣١"
  },
  {
   "id": "s0893",
   "kind": "sentence",
   "text": "السِّعْرُ: ٣٩٤,٤٠"
  },
  {
   "id": "s0894",
   "kind": "sentence",
   "text": "ثَلَاثُمِائَةٍ وَسِتَّةٌ وَأَرْبَعُونَ جُنَيْهًا فَقَطْ لَا غَيْرَ"
  },
  {
   "id": "s0895",
   "kind": "sentence",
   "text": "ثَلَاثُمِائَةٍ وَأَرْبَعَةٌ وَتِسْعُونَ جُنَيْهًا وَأَرْبَعُونَ قِرْشًا فَقَطْ لَا غَيْرَ"
  },
  {
   "id": "s0896",
   "kind": "sentence",
   "text": "سِعْرُ التِّلِفِزْيُون فِي السُّعُودِيَّة سَبْعُمِائَة وَسِتَّة وَتِسْعُون رِيَالًا."
  },
  {
   "id": "s0897",
   "kind": "sentence",
   "text": "سِعْرُ التِّلِفِزْيُون فِي الْيَابَان أَلْف يِنًّا."
  },
  {
   "id": "s0898",
   "kind": "sentence",
   "text": "سِعْرُ التِّلِفِزْيُون فِي الصِّين ثَلَاثُمِائَة وَأَرْبَعُون يُوَانًا."
  },
  {
   "id": "s0899",
   "kind": "sentence",
   "text": "سِعْرُ الْكُمْبِيُوتَر فِي السُّعُودِيَّة سِتُّمِائَة وَعِشْرُون رِيَالًا."
  },
  {
   "id": "s0900",
   "kind": "sentence",
   "text": "سِعْرُ الْكُمْبِيُوتَر فِي دُبَي أَلْف وَمِائَتَان دِرْهَمًا."
  },
  {
   "id": "s0901",
   "kind": "sentence",
   "text": "سِعْرُ الْكُمْبِيُوتَر فِي مِصْر أَرْبَعَة آلَاف وَخَمْسُمِائَة جُنَيْهًا."
  },
  {
   "id": "s0902",
   "kind": "sentence",
   "text": "سِعْرُ الْكُمْبِيُوتَر فِي أَلْمَانْيَا أَلْف وَمِائَتَان يُورُو."
  },
  {
   "id": "s0903",
   "kind": "sentence",
   "text": "سِعْرُ الْكُمْبِيُوتَر فِي فَرَنْسَا أَلْفَان وَعِشْرُون يُورُو."
  },
  {
   "id": "s0904",
   "kind": "sentence",
   "text": "سِعْرُ الثَّلَّاجَة فِي الْيَابَان أَلْف وَخَمْسُمِائَة وَعِشْرُون يِنًّا."
  },
  {
   "id": "s0905",
   "kind": "sentence",
   "text": "سِعْرُ الثَّلَّاجَة فِي أَمْرِيكَا سِتُّمِائَة دُولَارًا."
  },
  {
   "id": "s0906",
   "kind": "sentence",
   "text": "سِعْرُ الثَّلَّاجَة فِي الصِّين أَلْف وَأَرْبَعُمِائَة وَخَمْسُون يُوَانًا."
  },
  {
   "id": "s0907",
   "kind": "sentence",
   "text": "سِعْرُ الْمَحْمُول فِي السُّعُودِيَّة ثَلَاثُمِائَة وَأَرْبَعُون رِيَالًا."
  },
  {
   "id": "s0908",
   "kind": "sentence",
   "text": "سِعْرُ الْمَحْمُول فِي مِصْر أَلْفَان وَخَمْسُمِائَة جُنَيْهًا."
  },
  {
   "id": "s0909",
   "kind": "sentence",
   "text": "سِعْرُ الْمَحْمُول فِي أَلْمَانْيَا ثَلَاثُمِائَة وَعِشْرُون يُورُو."
  },
  {
   "id": "s0910",
   "kind": "sentence",
   "text": "سِعْرُ الْمَحْمُول فِي أَمْرِيكَا خَمْسُمِائَة وَعِشْرُون دُولَارًا."
  },
  {
   "id": "s0913",
   "kind": "sentence",
   "text": "هَذَا الْقَلَمُ لَوْنُهُ أَسْوَدُ."
