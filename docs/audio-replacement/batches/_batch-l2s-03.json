 "items": [
  {
   "id": "s0105",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ أَنْتِ يَا فَرِيدَة؟"
  },
  {
   "id": "s0107",
   "kind": "sentence",
   "text": "صَبَاحُ الْخَيْر، أَنَا خَالِد، وَأَنْتَ مَا اسْمُكَ؟"
  },
  {
   "id": "s0108",
   "kind": "sentence",
   "text": "أَنَا خَالِد وَمِنْ أَيْنَ أَنْتَ؟"
  },
  {
   "id": "s0109",
   "kind": "sentence",
   "text": "أَنَا مِنْ مِصْر."
  },
  {
   "id": "s0110",
   "kind": "sentence",
   "text": "مَنْ هِيَ؟"
  },
  {
   "id": "s0111",
   "kind": "sentence",
   "text": "مَنْ هُمَا؟"
  },
  {
   "id": "s0112",
   "kind": "sentence",
   "text": "مَنْ هُمْ؟"
  },
  {
   "id": "s0113",
