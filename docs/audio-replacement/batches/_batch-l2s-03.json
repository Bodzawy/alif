   "text": "مِنْ أَيْنَ أَنْتِ؟"
  },
  {
   "id": "s0118",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ أَنْتُمَا؟"
  },
  {
   "id": "s0119",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ أَنْتُمْ؟"
  },
  {
   "id": "s0120",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ أَنْتُنَّ؟"
  },
  {
   "id": "s0121",
   "kind": "sentence",
   "text": "أَحْمَد – إِحْسَان – أُمَيْمَة"
  },
  {
   "id": "s0122",
   "kind": "sentence",
   "text": "سَأَلَ – أَسْئِلَة – سُؤَال"
  },
  {
   "id": "s0123",
   "kind": "sentence",
   "text": "بَدَأَ – بَطِيء – تَبَاطُؤ – بَدْء – ضَوْء – هَنَاء"
  },
  {
   "id": "s0124",
   "kind": "sentence",
   "text": "اسْم – ابْن – الصُّومَال"
  },
  {
   "id": "s0126",
   "kind": "sentence",
   "text": "هَلْ أَنْتُمْ مِنْ أُسْتُرَالْيَا؟"
  },
  {
   "id": "s0128",
   "kind": "sentence",
   "text": "هُوَ اسْمُهُ إِسْلَام، هُوَ مِنْ زَائِير."
  },
  {
   "id": "s0129",
   "kind": "sentence",
   "text": "هَلْ أَنْتُنَّ مِنْ أَمْسْتَرْدَام؟"
  },
  {
   "id": "s0130",
   "kind": "sentence",
   "text": "نَحْنُ أَسْمَاؤُنَا مُؤْنِس وَرَؤُوف وَأَيْمَن."
  },
  {
   "id": "s0132",
   "kind": "sentence",
   "text": "مَسَاءُ الْخَيْرِ يَا رَائِف."
  },
  {
   "id": "s0133",
   "kind": "sentence",
   "text": "أَهْلًا وَسَهْلًا بِكِ يَا أُمَيْمَة."
  },
  {
   "id": "s0134",
   "kind": "sentence",
   "text": "هَلْ أَنْتَ الْأُسْتَاذ وَائِل؟"
  },
  {
   "id": "s0135",
   "kind": "sentence",
   "text": "هَلْ أَنْتُمَا مِنْ زَائِير؟"
  },
  {
   "id": "s0136",
   "kind": "sentence",
   "text": "أَبِي مِنْ أَسْيُوط."
  },
  {
   "id": "s0139",
   "kind": "sentence",
   "text": "وَأُمِّي مِنْ أَسْوَان."
  },
  {
   "id": "s0140",
   "kind": "sentence",
   "text": "أَهْلًا بِكَ يَا مُؤْمِنَة."
  },
  {
   "id": "s0141",
   "kind": "sentence",
   "text": "مَسَاءُ النُّورِ يَا رَؤُوف."
  },
  {
   "id": "s0150",
   "kind": "sentence",
   "text": "مَعَ السَّلَامَةِ"
  },
  {
   "id": "s0151",
   "kind": "sentence",
   "text": "أَهْلًا وَسَهْلًا"
  },
  {
   "id": "s0152",
   "kind": "sentence",
   "text": "لَا مُشْكِلَةَ"
  },
  {
   "id": "s0153",
   "kind": "sentence",
   "text": "أَهْلًا وَسَهْلًا."
  },
  {
   "id": "s0154",
   "kind": "sentence",
   "text": "آسِف جِدًّا."
  },
  {
   "id": "s0155",
   "kind": "sentence",
   "text": "لَا مُشْكِلَةَ."
  },
  {
   "id": "s0156",
   "kind": "sentence",
   "text": "نَحْنُ مِنَ الصِّين."
  },
  {
   "id": "s0157",
