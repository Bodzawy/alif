   "text": "مَنْ هُنَّ؟"
  },
  {
   "id": "s0114",
   "kind": "sentence",
   "text": "مَا اسْمُ سِيَادَتِكَ؟"
  },
  {
   "id": "s0115",
   "kind": "sentence",
   "text": "مَا اسْمُ سِيَادَتِكِ؟"
  },
  {
   "id": "s0116",
   "kind": "sentence",
   "text": "مِنْ أَيْنَ أَنْتَ؟"
  },
  {
   "id": "s0117",
