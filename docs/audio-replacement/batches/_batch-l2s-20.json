{
 "batch": "batch-l2s-20",
 "items": [
  {
   "id": "s1104",
   "kind": "sentence",
   "text": "لَا، الصَّيْدَلِيَّةُ لَيْسَتْ عَلَى الْيَمِينِ، الصَّيْدَلِيَّةُ عَلَى الْيَسَارِ."
  },
  {
   "id": "s1105",
   "kind": "sentence",
   "text": "نَعَمْ، عَلَى الْيَمِينِ."
  },
  {
   "id": "s1106",
   "kind": "sentence",
   "text": "هَذَا مَسْجِد"
  },
  {
   "id": "s1107",
   "kind": "sentence",
   "text": "قِسْمُ الْبُولِيس"
  },
  {
   "id": "s1108",
   "kind": "sentence",
   "text": "مَحَطَّةُ أُوتُوبِيس"
  },
  {
   "id": "s1109",
   "kind": "sentence",
   "text": "عُنْوَانُ شَادِي: ٦٥ شَارِعُ الثَّوْرَةِ، الدَّوْرُ الثَّالِثُ، شَقَّةُ رَقْم ٤٦"
  },
  {
   "id": "s1110",
   "kind": "sentence",
   "text": "طَرِيقَةُ الْوُصُولِ: اُدْخُلْ شَارِعَ أَحْمَد حُسَيْن – اسْتَمِرَّ فِي الشَّارِعِ حَتَّى التَّقَاطُعِ – الْعِمَارَةُ عَلَى النَّاصِيَةِ."
  },
  {
   "id": "s1111",
   "kind": "sentence",
   "text": "مَوْعِدُ الْحَفْلَةِ: يَوْمَ الْخَمِيسِ السَّاعَةَ السَّادِسَةَ مَسَاءً."
  },
  {
   "id": "s1112",
   "kind": "sentence",
   "text": "وَصْفُ الطَّرِيقِ: الْبَيْتُ فِي آخِرِ شَارِعِ مُصْطَفَى مَحْمُود بِجِوَارِ مُسْتَشْفَى الْحُرِّيَّةِ، أَمَامَ صَيْدَلِيَّةِ النُّورِ بَعْدَ التَّقَاطُعِ مَعَ شَارِعِ أَحْمَد رَجَب."
  },
  {
   "id": "s1113",
   "kind": "sentence",
   "text": "الْعُنْوَانُ: شَارِعُ مُصْطَفَى مَحْمُود – الدَّوْرُ الثَّانِي، شَقَّةُ ١٢ – مَحْمُول: ٠١٢٢٤٥٦٧٤٩"
  },
  {
   "id": "s1114",
   "kind": "sentence",
   "text": "صِفْ طَرِيقَ بَيْتِكَ."
  },
  {
   "id": "s1115",
   "kind": "sentence",
   "text": "أَيْنَ شَارِعُ التَّحْرِيرِ؟"
  },
  {
   "id": "s1116",
   "kind": "sentence",
   "text": "أَيْنَ الْمَدْرَسَةُ الْأَلْمَانِيَّةُ؟"
  },
  {
   "id": "s1117",
   "kind": "sentence",
   "text": "أَيْنَ شَارِعُ جَامِعَةِ الدُّوَلِ الْعَرَبِيَّةِ؟"
  },
  {
   "id": "s1118",
   "kind": "sentence",
   "text": "أَيْنَ مُسْتَشْفَى السَّلَامِ؟"
  },
  {
   "id": "s1119",
   "kind": "sentence",
   "text": "أَيْنَ الْمُتْحَفُ الزِّرَاعِيُّ؟"
  },
  {
   "id": "s1120",
   "kind": "sentence",
   "text": "أَيْنَ نَادِي الصَّيْدِ؟"
  },
  {
   "id": "s1121",
   "kind": "sentence",
   "text": "أَيْنَ الْقَلَمُ؟"
  },
  {
   "id": "s1122",
   "kind": "sentence",
   "text": "الْقَلَمُ تَحْتَ الطَّاوِلَةِ."
  },
  {
   "id": "s1123",
   "kind": "sentence",
   "text": "هَلِ الْقَلَمُ فَوْقَ الطَّاوِلَةِ؟"
  },
  {
   "id": "s1125",
   "kind": "sentence",
   "text": "هَلِ الْحَقِيبَةُ فَوْقَ الطَّاوِلَةِ؟"
  },
  {
   "id": "s1127",
   "kind": "sentence",
   "text": "لَيْسَتْ + فَوْقَ الطَّاوِلَةِ"
  },
  {
   "id": "s1128",
   "kind": "sentence",
   "text": "لِفَّ حَوْلَ الْمَيْدَانِ – قَبْلَ / بَعْدَ التَّقَاطُعِ"
  },
  {
   "id": "s1129",
   "kind": "sentence",
   "text": "الْمَكْتَبُ عَلَى الْيَمِينِ – عَلَى الْيَسَارِ"
  },
  {
   "id": "s1130",
   "kind": "sentence",
   "text": "يَسْتَيْقِظُ مِنَ النَّوْمِ السَّاعَةَ السَّادِسَةَ صَبَاحًا."
  },
  {
   "id": "s1131",
   "kind": "sentence",
   "text": "يَشْرَبُ الْقَهْوَةَ وَيَقْرَأُ الْجَرِيدَةَ السَّاعَةَ السَّادِسَةَ وَالرُّبْعَ."
  },
  {
   "id": "s1132",
   "kind": "sentence",
   "text": "يُفْطِرُ السَّاعَةَ السَّادِسَةَ وَالنِّصْفَ."
  },
  {
   "id": "s1133",
   "kind": "sentence",
   "text": "يَغْسِلُ وَجْهَهُ السَّاعَةَ السَّابِعَةَ."
  },
  {
   "id": "s1134",
   "kind": "sentence",
   "text": "يَلْبَسُ مَلَابِسَهُ السَّاعَةَ السَّابِعَةَ وَالرُّبْعَ."
  },
  {
   "id": "s1135",
   "kind": "sentence",
   "text": "يَرْكَبُ سَيَّارَتَهُ السَّاعَةَ السَّابِعَةَ وَالنِّصْفَ."
  },
  {
   "id": "s1136",
   "kind": "sentence",
   "text": "يَذْهَبُ إِلَى الْعَمَلِ السَّاعَةَ الثَّامِنَةَ إِلَّا الرُّبْعَ."
  },
  {
   "id": "s1137",
   "kind": "sentence",
   "text": "يَتَغَدَّى السَّاعَةَ الْوَاحِدَةَ."
  },
  {
   "id": "s1138",
   "kind": "sentence",
   "text": "يَعْمَلُ إِلَى السَّاعَةَ الرَّابِعَةِ."
  },
  {
   "id": "s1139",
   "kind": "sentence",
   "text": "يَرْجِعُ إِلَى الْبَيْتِ السَّاعَةَ الرَّابِعَةِ وَالنِّصْفِ."
  },
  {
   "id": "s1140",
   "kind": "sentence",
   "text": "يُشَاهِدُ التِّلِيفِزْيُونَ السَّاعَةَ الثَّامِنَةَ."
  },
  {
   "id": "s1141",
   "kind": "sentence",
   "text": "يَتَعَشَّى السَّاعَةَ الثَّامِنَةَ وَالنِّصْفَ."
  },
  {
   "id": "s1142",
   "kind": "sentence",
   "text": "يَنَامُ السَّاعَةَ الْحَادِيَةَ عَشْرَةَ."
  },
  {
   "id": "s1143",
   "kind": "sentence",
   "text": "أَنَا أَسْتَيْقِظُ"
  },
  {
   "id": "s1144",
   "kind": "sentence",
   "text": "أَنْتَ تَسْتَيْقِظُ"
  },
  {
   "id": "s1145",
   "kind": "sentence",
   "text": "أَنْتِ تَسْتَيْقِظِينَ"
  },
  {
   "id": "s1146",
   "kind": "sentence",
   "text": "هِيَ تَسْتَيْقِظُ"
  },
  {
   "id": "s1147",
   "kind": "sentence",
   "text": "أَنَا أَشْرَبُ"
  },
  {
   "id": "s1148",
   "kind": "sentence",
   "text": "أَنْتَ تَشْرَبُ"
  },
  {
   "id": "s1149",
   "kind": "sentence",
   "text": "أَنْتِ تَشْرَبِينَ"
  },
  {
   "id": "s1150",
   "kind": "sentence",
   "text": "هِيَ تَشْرَبُ"
  },
  {
   "id": "s1151",
   "kind": "sentence",
   "text": "أَنَا أَقْرَأُ"
  },
  {
   "id": "s1152",
   "kind": "sentence",
   "text": "أَنْتَ تَقْرَأُ"
  },
  {
   "id": "s1153",
   "kind": "sentence",
   "text": "أَنْتِ تَقْرَئِينَ"
  },
  {
   "id": "s1154",
