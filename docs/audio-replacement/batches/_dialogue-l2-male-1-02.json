{
 "batch": "_dialogue-l2-male-1-02",
 "voice": "male-1",
 "speakers": [
  "Der Patient (patient-nurse)",
  "Der Anrufer (call-hospital)",
  "Raif (raif-muna)",
  "Der Verkäufer (shop-prices)",
  "Samir (samir-sharif)",
  "Der Verkäufer (store)",
  "Salim (party)",
  "Der Angestellte (airport-info)",
  "Der Mann (tourist)",
  "Basim (said-basim)",
  "Fawwaz (emad-fawwaz)",
  "Essam (essam-family)",
  "Emad (salwa-imad)"
 ],
 "items": [
  {
   "id": "d2-m1-041",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "أَلُو … عِيَادَةُ الدُّكْتُورِ سَيْف عَبْدِ اللهِ؟",
   "lines": [
    "u6-pn-1"
   ]
  },
  {
   "id": "d2-m1-042",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَا رَقْمُ تِلِيفُونِهِ الْمَحْمُولِ لَوْ سَمَحْتِ؟",
   "lines": [
    "u6-pn-3"
   ]
  },
  {
   "id": "d2-m1-043",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "السَّلَامُ عَلَيْكُمْ.",
   "lines": [
    "u6-c2-1"
   ]
  },
  {
   "id": "d2-m1-044",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "لَوْ سَمَحْتِ، مَا رَقْمُ تِلِيفُونِ مُسْتَشْفَى الْحَيَاةِ؟",
   "lines": [
    "u6-c2-3"
   ]
  },
  {
   "id": "d2-m1-045",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "وَمَا رَقْمُ الْفَاكْسِ؟",
   "lines": [
    "u6-c2-5"
   ]
  },
  {
   "id": "d2-m1-046",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "شُكْرًا جَزِيلًا.",
   "lines": [
    "u6-c2-7"
   ]
  },
  {
   "id": "d2-m1-047",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "يَا آنِسَة مُنَى، مَا مَوْعِدُ قِيَامِ الْقِطَارِ؟",
   "lines": [
    "u6-rm-1"
   ]
  },
  {
   "id": "d2-m1-048",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "سِعْرُ هَذِهِ الْبَدْلَةِ أَلْفٌ وَخَمْسُمِائَةِ جُنَيْهٍ.",
   "lines": [
    "u7-s-2"
   ]
  },
  {
   "id": "d2-m1-049",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "سِعْرُ هَذَا الْقَلَمِ جُنَيْهَانِ.",
   "lines": [
    "u7-s-4"
   ]
  },
  {
   "id": "d2-m1-050",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "سِعْرُ هَذِهِ اللُّعْبَةِ ثَلَاثَةُ جُنَيْهَاتٍ.",
   "lines": [
    "u7-s-6"
   ]
  },
  {
   "id": "d2-m1-051",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مَا لَوْنُ حُجْرَةِ النَّوْمِ يَا شَرِيفُ؟",
   "lines": [
    "u7-ss-1"
   ]
  },
  {
   "id": "d2-m1-052",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "وَمَا لَوْنُ سَرِيرِكَ؟",
   "lines": [
    "u7-ss-3"
   ]
  },
  {
   "id": "d2-m1-053",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "وَهَلْ مَكْتَبُكَ لَوْنُهُ أَخْضَرُ؟",
   "lines": [
    "u7-ss-5"
   ]
  },
  {
   "id": "d2-m1-054",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "أَنَا فِي الْخِدْمَةِ.",
   "lines": [
    "u8-st-1"
   ]
  },
  {
   "id": "d2-m1-055",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "قِسْمُ الْكَامِيرَاتِ بِجَانِبِ الْخَزِينَةِ.",
   "lines": [
    "u8-st-3"
   ]
  },
  {
   "id": "d2-m1-056",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "لَا، قِسْمُ الثَّلَّاجَاتِ لَيْسَ أَمَامَ الْمِصْعَدِ، قِسْمُ الثَّلَّاجَاتِ أَمَامَ حَمَّامِ السَّيِّدَاتِ.",
   "lines": [
    "u8-st-5"
   ]
  },
  {
   "id": "d2-m1-057",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "قِسْمُ التِّلِفِزْيُونَاتِ خَلْفَ قِسْمِ الثَّلَّاجَاتِ.",
   "lines": [
    "u8-st-7"
   ]
  },
  {
   "id": "d2-m1-058",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "قِسْمُ الْغَسَّالَاتِ بَيْنَ حَمَّامِ السَّيِّدَاتِ وَحَمَّامِ الرِّجَالِ.",
   "lines": [
    "u8-st-9"
   ]
  },
  {
   "id": "d2-m1-059",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "الْكَافِتِيرْيَا خَلْفَ قِسْمِ الْكُمْبِيُوتَرَاتِ. أَيُّ خِدْمَةٍ أُخْرَى؟",
   "lines": [
    "u8-st-11"
   ]
  },
  {
   "id": "d2-m1-060",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "بَيْنَ سَلْوَى وَعَبْلَة مَاجِد.",
   "lines": [
    "u8-p-2"
   ]
  },
  {
   "id": "d2-m1-061",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "مُهَاب أَمَامَ سَمِيح.",
   "lines": [
    "u8-p-4"
   ]
  },
  {
   "id": "d2-m1-062",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "دُعَاء فَوْقَ الْكُرْسِيِّ.",
   "lines": [
    "u8-p-6"
   ]
  },
  {
   "id": "d2-m1-063",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "هَادِيَة خَلْفَ زِيَاد – وَهَذِهِ شَيْمَاء عَلَى الْأَرِيكَةِ.",
   "lines": [
    "u8-p-8"
   ]
  },
  {
   "id": "d2-m1-064",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "السُّوقُ الْحُرَّةُ فِي الدَّوْرِ الثَّالِثِ أَمَامَ مَكْتَبِ السِّيَاحَةِ.",
   "lines": [
    "u8-a-2"
   ]
  },
  {
   "id": "d2-m1-065",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "أَنْتِ الْآنَ فِي شَارِعِ مِصْرَ وَالسُّودَانِ، اُدْخُلِي يَمِينًا فِي شَارِعِ كِلْيُوبَاتْرَا.",
   "lines": [
    "u8-t-2"
   ]
  },
  {
   "id": "d2-m1-066",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "اسْتَمِرِّي فِي شَارِعِ كِلْيُوبَاتْرَا حَتَّى بَعْدَ التَّقَاطُعِ مَعَ شَارِعِ رَمْسِيس، الصَّيْدَلِيَّةُ عَلَى الْيَمِينِ وَعَلَى النَّاصِيَةِ.",
   "lines": [
    "u8-t-4"
   ]
  },
  {
   "id": "d2-m1-067",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "عَفْوًا.",
   "lines": [
    "u8-t-6"
   ]
  },
  {
   "id": "d2-m1-068",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "لَا، آسِفٌ يَا سَعِيدُ. أَنَا أَعْمَلُ فِي الْمَكْتَبِ الْآنَ.",
   "lines": [
    "u9-sb-2"
   ]
  },
  {
   "id": "d2-m1-069",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "السَّلَامُ عَلَيْكُمْ يَا عِمَاد. الْيَوْمَ السَّبْتُ. هَلْ تَذْهَبُ مَعِي إِلَى النَّادِي؟",
   "lines": [
    "u9-ef-1"
   ]
  },
  {
   "id": "d2-m1-070",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "لِمَاذَا؟",
   "lines": [
    "u9-ef-3"
   ]
  },
  {
   "id": "d2-m1-071",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "أَمْ … فِي الْحَقِيقَةِ، أَنَا لَا أَقْرَأُ … وَلَا أَسْمَعُ مُوسِيقَى … أَنَا أُحِبُّ النَّادِي. أَنَا أَذْهَبُ إِلَى النَّادِي، أَلْعَبُ رِيَاضَةً وَأَجْرِي وَأُقَابِلُ أَصْدِقَائِي.",
   "lines": [
    "u9-ef-5"
   ]
  },
  {
   "id": "d2-m1-072",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "لَا، هِيَ لَا تَعْمَلُ، هِيَ رَبَّةُ بَيْتٍ.",
   "lines": [
    "u10-e-2"
   ]
  },
  {
   "id": "d2-m1-073",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "لَا، هُوَ لَا يَعْمَلُ هُوَ عَلَى الْمَعَاشِ.",
   "lines": [
    "u10-e-4"
   ]
  },
  {
   "id": "d2-m1-074",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "أَنَا أُسَافِرُ إِلَى الْيَابَانِ.",
   "lines": [
    "u10-s-2"
   ]
  },
  {
   "id": "d2-m1-075",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "طُوكْيُو.",
   "lines": [
    "u10-s-4"
   ]
  },
  {
   "id": "d2-m1-076",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "أُسَافِرُ فِي شَهْرِ دِيسَمْبِر وَيَنَايِر. فِي الشِّتَاءِ.",
   "lines": [
    "u10-s-6"
   ]
  },
  {
   "id": "d2-m1-077",
   "kind": "dialogue",
   "voice": "male-1",
   "text": "الطَّقْسُ بَارِدٌ جِدًّا. أَنَا أَلْبَسُ مِعْطَفًا وَقُفَّازًا وَقُبَّعَةً أَيْضًا.",
   "lines": [
    "u10-s-8"
   ]
  }
 ]
}
