{
 "batch": "batch-l2s-10",
 "items": [
  {
   "id": "s0521",
   "kind": "sentence",
   "text": "اسْمُهُ رَؤُوف."
  },
  {
   "id": "s0522",
   "kind": "sentence",
   "text": "هَلْ هَذِهِ حَقِيبَةُ مُنَى؟"
  },
  {
   "id": "s0523",
   "kind": "sentence",
   "text": "لَا، هَذِهِ لَيْسَتْ حَقِيبَةَ مُنَى."
  },
  {
   "id": "s0524",
   "kind": "sentence",
   "text": "هَلْ أَنْتَ سُودَانِيٌّ؟"
  },
  {
   "id": "s0528",
   "kind": "sentence",
   "text": "أَنَا آسِفَة جِدًّا."
  },
  {
   "id": "s0529",
   "kind": "sentence",
   "text": "مِنْ فَضْلِكَ يَا سَيِّد مُخْتَار، هَلْ هَذِهِ مِحْفَظَتُكَ؟"
  },
  {
   "id": "s0531",
   "kind": "sentence",
   "text": "اسْمِي نَوَال."
  },
  {
   "id": "s0532",
   "kind": "sentence",
   "text": "هَلْ أَنْتِ سُورِيَّةٌ يَا نَوَال؟"
  },
  {
   "id": "s0534",
   "kind": "sentence",
   "text": "فِي الْفَصْلِ"
  },
  {
   "id": "s0535",
   "kind": "sentence",
   "text": "فِي الْغُرْفَةِ"
  },
  {
   "id": "s0536",
   "kind": "sentence",
   "text": "تَصْرِيفُ حَقِيبَة"
  },
  {
   "id": "s0538",
   "kind": "sentence",
   "text": "هَلْ هُوَ مِنَ الصِّينِ؟"
  },
  {
   "id": "s0540",
   "kind": "sentence",
   "text": "هَلِ اسْمُهُ مُصْطَفَى؟"
  },
  {
   "id": "s0541",
   "kind": "sentence",
   "text": "لَا، اسْمُهُ سَامِي."
  },
  {
   "id": "s0542",
   "kind": "sentence",
   "text": "هَلْ هُوَ يَابَانِيٌّ؟"
  },
  {
   "id": "s0544",
   "kind": "sentence",
   "text": "هَلْ هَذَا قَلَمٌ؟"
  },
  {
   "id": "s0546",
   "kind": "sentence",
   "text": "هَلْ هَذِهِ نَافِذَةٌ؟"
  },
  {
   "id": "s0548",
   "kind": "sentence",
   "text": "سَمِير وَخَالِد وَعَادِل"
  },
  {
   "id": "s0549",
   "kind": "sentence",
   "text": "هَلْ هَذِهِ حَقِيبَة مَحْمُود؟"
  },
  {
   "id": "s0550",
   "kind": "sentence",
   "text": "هَلْ هَذِهِ نَظَّارَة سُعَاد؟"
  },
  {
   "id": "s0551",
   "kind": "sentence",
   "text": "هَلْ هَذِهِ مَفَاتِيح سُعَاد؟"
  },
  {
   "id": "s0552",
   "kind": "sentence",
   "text": "هَلْ هَذِهِ أَقْلَام مَحْمُود؟"
  },
  {
   "id": "s0553",
   "kind": "sentence",
   "text": "هَلْ هَذِهِ شَمْسِيَّة سُعَاد؟"
  },
  {
   "id": "s0554",
   "kind": "sentence",
   "text": "هَلْ هَذِهِ كُرَّاسَة مَحْمُود؟"
  },
  {
   "id": "s0555",
   "kind": "sentence",
   "text": "هَلْ هَذَا تِلِيفُون مَحْمُود؟"
  },
  {
   "id": "s0556",
   "kind": "sentence",
   "text": "هَلْ هَذَا كِتَاب سُعَاد؟"
  },
  {
   "id": "s0557",
   "kind": "sentence",
   "text": "٠١٢ – خَمْسَة – سَبْعَة – ثَمَانِيَة – تِسْعَة – وَاحِد – ثَلَاثَة – صِفْر"
  },
  {
   "id": "s0558",
   "kind": "sentence",
   "text": "٠١٢ – وَاحِد – اثْنَان – خَمْسَة – صِفْر – أَرْبَعَة – ثَلَاثَة – سَبْعَة"
  },
  {
   "id": "s0559",
   "kind": "sentence",
   "text": "٠١٢ – سِتَّة – سَبْعَة – ثَلَاثَة – أَرْبَعَة – وَاحِد – صِفْر – تِسْعَة"
  },
  {
   "id": "s0560",
   "kind": "sentence",
   "text": "٠١٦ – تِسْعَة – ثَلَاثَة – خَمْسَة – سِتَّة – صِفْر – سَبْعَة – اثْنَان"
  },
  {
   "id": "s0561",
   "kind": "sentence",
   "text": "٠١٢ – وَاحِد – أَرْبَعَة – ثَلَاثَة – صِفْر – صِفْر – تِسْعَة – سِتَّة"
  },
  {
   "id": "s0562",
   "kind": "sentence",
   "text": "٠١٨ – وَاحِد – أَرْبَعَة – ثَلَاثَة – ثَمَانِيَة – صِفْر – وَاحِد – تِسْعَة"
  },
  {
   "id": "s0563",
   "kind": "sentence",
   "text": "٠١٨ – تِسْعَة – خَمْسَة – اثْنَان – ثَلَاثَة – أَرْبَعَة – ثَلَاثَة – ثَمَانِيَة"
  },
  {
   "id": "s0564",
   "kind": "sentence",
   "text": "هَلْ أَنْتِ مِنْ كُورِيَا؟"
  },
  {
   "id": "s0567",
   "kind": "sentence",
   "text": "وَهَلْ هَذِهِ نُقُودُكَ؟"
  },
  {
   "id": "s0568",
   "kind": "sentence",
   "text": "لَا، هَذِهِ لَيْسَتْ نُقُودِي."
  },
  {
   "id": "s0569",
   "kind": "sentence",
   "text": "أَيْنَ الْكُوكَاكُولَا مِنْ فَضْلِكَ؟"
  },
  {
   "id": "s0570",
   "kind": "sentence",
   "text": "الْكُوكَاكُولَا فِي الثَّلَّاجَةِ."
  },
  {
   "id": "s0571",
   "kind": "sentence",
   "text": "شُكْرًا جَزِيلًا."
  },
  {
   "id": "s0572",
   "kind": "sentence",
   "text": "هُمَا أَحْمَد وَمُنَى."
  },
  {
   "id": "s0573",
   "kind": "sentence",
   "text": "وَمَنْ هِيَ؟"
  },
  {
   "id": "s0574",
   "kind": "sentence",
   "text": "هِيَ مَاجِدَة."
  },
  {
   "id": "s0575",
   "kind": "sentence",
   "text": "هَلْ هَذِهِ نَظَّارَتُكَ؟"
  },
  {
   "id": "s0576",
   "kind": "sentence",
   "text": "أَيْنَ الْحَقَائِبُ مِنْ فَضْلِكَ؟"
  },
  {
   "id": "s0577",
   "kind": "sentence",
   "text": "هَلْ هَذَا كِتَابٌ عَرَبِيٌّ؟"
  },
  {
   "id": "s0578",
   "kind": "sentence",
   "text": "هَلْ أَنْتِ السَّيِّدَةُ مُنَى؟"
  },
  {
   "id": "s0579",
   "kind": "sentence",
   "text": "هَلْ هَذِهِ مَفَاتِيحُ عَلِيّ؟"
  },
  {
   "id": "s0580",
   "kind": "sentence",
   "text": "هَلْ هَذَا كِتَابٌ إِنْجِلِيزِيٌّ؟"
  },
  {
   "id": "s0581",
   "kind": "sentence",
   "text": "طَبِيب – جَرَّاح"
  },
  {
   "id": "s0582",
